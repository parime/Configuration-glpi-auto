{
    "name": "parime/configuration-glpi-auto",
    "description": "GLPI plugin for automatic configuration of GLPI instances according to best practices",
    "type": "glpi-plugin",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "glpi",
        "plugin",
        "configuration",
        "automation",
        "wizard",
        "itil",
        "iso27001"
    ],
    "homepage": "https://github.com/parime/Configuration-glpi-auto",
    "authors": [
        {
            "name": "Parime",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.13",
        "glpi-project/tools": "^0.8"
    },
    "autoload": {
        "psr-4": {
            "GlpiPlugin\\Configurationglpiauto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlpiPlugin\\Configurationglpiauto\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.99"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "fix": "php-cs-fixer fix --allow-risky=yes",
        "lint": [
            "@analyse",
            "phpcs"
        ]
    },
    "extra": {
        "glpi-plugin": {
            "key": "configurationglpiauto",
            "name": "Configuration GLPI Auto",
            "version": "0.33.0",
            "license": "GPL-3.0-or-later"
        }
    }
}
