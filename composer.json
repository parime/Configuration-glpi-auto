{
    "name": "parime/configuration-glpi-auto",
    "description": "GLPI plugin for automatic configuration of GLPI instances according to best practices",
    "type": "glpi-plugin",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "glpi",
        "plugin",
        "configuration",
        "automation",
        "wizard",
        "itil",
        "iso27001"
    ],
    "homepage": "https://github.com/parime/Configuration-glpi-auto",
    "authors": [
        {
            "name": "Parime",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "glpi-project/glpi": ">=11.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.13",
        "rectorphp/rector": "^0.18",
        "phpmd/phpmd": "^2.10",
        "vimeo/psalm": "^5.0",
        "glpi-project/tools": "^0.8",
        "nunomaduro/larastan": "^2.0",
        "php-compatibility/php-compatibility": "^9.3"
    },
    "autoload": {
        "psr-4": {
            "GlpiPlugin\\Configurationglpiauto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlpiPlugin\\Configurationglpiauto\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "analyse": [
            "phpstan analyse src --level=8",
            "psalm",
            "phpcs"
        ],
        "fix": [
            "php-cs-fixer fix --allow-risky=yes",
            "rector"
        ],
        "lint": [
            "phpstan analyse src --level=8",
            "psalm",
            "phpcs"
        ]
    },
    "conflict": {
        "glpi-project/glpi": "<11.0.0"
    },
    "extra": {
        "glpi-plugin": {
            "key": "configurationglpiauto",
            "name": "Configuration GLPI Auto",
            "version": "1.0.0",
            "license": "GPL-3.0-or-later"
        }
    }
}
