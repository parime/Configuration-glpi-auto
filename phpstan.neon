parameters:
    level: 6
    tmpDir: .phpstan.cache
    # Scope limited to pure-PHP logic with no runtime dependency on the GLPI core classes
    # (CommonDBTM, Migration, ProfileRight, DBmysql, global $DB/$PLUGIN_HOOKS...). Those are only
    # available inside a running GLPI instance and are not stubbed for static analysis here — same
    # constraint documented in the sibling glpi-vulnerability-manager repo. Extend `paths` as
    # GLPI-independent code is added under src/.
    paths: []
    excludePaths:
        - tests/*
        - vendor/*
