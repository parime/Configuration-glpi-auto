{# Issue #468 : écarts avec le dernier Blueprint appliqué, en lecture seule. #}
<div class="card mt-3" id="blueprint-drift">
  <div class="card-header">
    <h3 class="card-title"><i class="ti ti-git-compare me-2"></i>{{ __('Écarts avec le dernier Blueprint appliqué', 'configurationglpiauto') }}</h3>
  </div>
  <div class="card-body">
    <p class="text-muted">
      {{ __('Compare les SLA, le calendrier, les catégories de tickets, les statuts et les règles d\'affectation des SLA créés par le plugin à ce qu\'ils sont aujourd\'hui dans GLPI. Cette vérification ne modifie rien.', 'configurationglpiauto') }}
    </p>
    {% if drift.settings_url %}
      <p>
        <a class="btn btn-sm btn-outline-secondary" href="{{ drift.settings_url }}"><i class="ti ti-settings me-1"></i>{{ __('Choisir les éléments surveillés', 'configurationglpiauto') }}</a>
      </p>
    {% endif %}
    {% if not drift.applied %}
      <div class="alert alert-info mb-0">
        <i class="ti ti-info-circle me-1"></i>
        {{ __('Aucun Blueprint n\'a encore été appliqué avec l\'assistant : il n\'y a rien à comparer.', 'configurationglpiauto') }}
        <a href="{{ drift.wizard_url }}">{{ __('Ouvrir l\'assistant', 'configurationglpiauto') }}</a>
      </div>
    {% elseif drift.items is empty %}
      <div class="alert alert-success mb-0">
        <i class="ti ti-circle-check me-1"></i>
        {{ __('Aucun écart : la configuration de GLPI correspond au dernier Blueprint appliqué.', 'configurationglpiauto') }}
      </div>
    {% else %}
      {% set changeBadges = {
        'added': ['info', __('Ajouté', 'configurationglpiauto')],
        'modified': ['warning', __('Modifié', 'configurationglpiauto')],
        'removed': ['danger', __('Supprimé', 'configurationglpiauto')]
      } %}
      <div class="table-responsive">
        <table class="table table-sm table-striped">
          <thead>
            <tr>
              <th>{{ __('Écart', 'configurationglpiauto') }}</th>
              <th>{{ __('Objet', 'configurationglpiauto') }}</th>
              <th>{{ __('Élément', 'configurationglpiauto') }}</th>
              <th>{{ __('Dans GLPI', 'configurationglpiauto') }}</th>
              <th>{{ __('Dans le Blueprint', 'configurationglpiauto') }}</th>
              <th>{{ __('Actions', 'configurationglpiauto') }}</th>
            </tr>
          </thead>
          <tbody>
            {% for item in drift.items %}
              {% set badge = changeBadges[item.change]|default(['neutral', item.change]) %}
              <tr>
                <td>{% include '@configurationglpiauto/_badge.html.twig' with {kind: badge[0], label: badge[1]} %}</td>
                <td>{{ item.object }}</td>
                <td>{{ item.item }}</td>
                <td>{{ item.current is empty ? '-' : item.current }}</td>
                <td>{{ item.expected is empty ? '-' : item.expected }}</td>
                <td class="text-nowrap">
                  {% if item.reapply and drift.deploy_url %}
                    <a class="btn btn-sm btn-outline-primary" href="{{ drift.deploy_url }}" title="{{ __('Remettre la valeur du Blueprint, après aperçu et confirmation', 'configurationglpiauto') }}">
                      <i class="ti ti-player-play me-1"></i>{{ __('Réappliquer', 'configurationglpiauto') }}
                    </a>
                  {% endif %}
                  {% if item.adopt and drift.can_adopt %}
                    <form method="post" action="{{ drift.audit_url }}" class="d-inline">
                      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                      <button type="submit" name="adopt_drift" value="{{ item.adopt }}" class="btn btn-sm btn-outline-success" title="{{ __('Garder la valeur de GLPI comme nouvelle référence du Blueprint', 'configurationglpiauto') }}">
                        <i class="ti ti-check me-1"></i>{{ __('Adopter', 'configurationglpiauto') }}
                      </button>
                    </form>
                  {% endif %}
                  {% if item.link %}
                    <a class="btn btn-sm btn-link" href="{{ item.link }}"><i class="ti ti-external-link me-1"></i>{{ __('Ouvrir dans GLPI', 'configurationglpiauto') }}</a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="small mb-2">
        <i class="ti ti-bulb me-1"></i>
        {{ __('Modification voulue : « Adopter » garde la valeur de GLPI comme référence (délais des SLA et OLA), sinon reportez-la dans l\'assistant. Modification accidentelle : réappliquez le Blueprint. Un élément ajouté à la main n\'est jamais supprimé ; une règle désactivée se réactive depuis sa fiche.', 'configurationglpiauto') }}
      </p>
      <div class="d-flex flex-wrap gap-2">
        {% if drift.deploy_url %}
          <a class="btn btn-sm btn-primary" href="{{ drift.deploy_url }}">
            <i class="ti ti-player-play me-1"></i>{{ __('Réappliquer le Blueprint (avec aperçu)', 'configurationglpiauto') }}
          </a>
        {% endif %}
        <a class="btn btn-sm btn-outline-secondary" href="{{ drift.wizard_url }}">
          <i class="ti ti-adjustments me-1"></i>{{ __('Adopter les nouvelles valeurs dans l\'assistant', 'configurationglpiauto') }}
        </a>
      </div>
    {% endif %}
  </div>
</div>
