<div class="card">
  <div class="card-body">
    <form method="post" action="{{ config('root_doc') }}/plugins/configurationglpiauto/front/config.php" id="cga-config-form">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

      <h3 class="mb-3">{{ __('Structure des entités', 'configurationglpiauto') }}</h3>
      <p class="text-muted">
        {{ __('Choisissez la structure d\'entités que l\'assistant de configuration doit mettre en place.', 'configurationglpiauto') }}
        {{ __('Retrouvez ce réglage à tout moment ici, ou repartez de zéro via l\'assistant complet :', 'configurationglpiauto') }}
        <a href="{{ config('root_doc') }}/plugins/configurationglpiauto/front/wizard.php">{{ __('lancer l\'assistant', 'configurationglpiauto') }}</a>.
      </p>

      {% include '@configurationglpiauto/_entity_structure_fields.html.twig' %}

      <button type="submit" name="update" class="btn btn-outline-primary mt-3">{{ __('Enregistrer') }}</button>
      <button
        type="submit"
        name="apply"
        class="btn btn-primary mt-3"
        id="cga-apply-btn"
        onclick="return confirm('{{ __('Ceci va créer de vraies entités dans GLPI selon la structure choisie. Continuer ?', 'configurationglpiauto')|e('js') }}');"
      >
        {{ __('Enregistrer et créer les entités', 'configurationglpiauto') }}
      </button>
      <div class="form-text mt-2">{{ __('Crée une branche modèle (une entité par niveau, dupliquez/renommez-la ensuite depuis Administration > Entités). Sans effet en mode mono-entité.', 'configurationglpiauto') }}</div>
    </form>
  </div>
</div>
