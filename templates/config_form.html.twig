<div class="row flex-nowrap align-items-start" style="gap: 1rem;">
  <div class="col" style="min-width: 320px; max-width: 480px;">
    <div class="card">
      <div class="card-body">
        <form method="post" action="{{ config('root_doc') }}/plugins/configurationglpiauto/front/config.php" id="cga-config-form">
          <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

          <h3 class="mb-3">{{ __('Structure des entités', 'configurationglpiauto') }}</h3>
          <p class="text-muted">
            {{ __('Choisissez la structure d\'entités que l\'assistant de configuration devra mettre en place. Cet écran ne crée rien — il définit la forme que l\'assistant construira à l\'étape "Entités".', 'configurationglpiauto') }}
          </p>

          {% for mode_key, mode_label in modes %}
            <div class="form-check mb-2">
              <input
                type="radio"
                name="entity_mode"
                value="{{ mode_key }}"
                class="form-check-input cga-mode-radio"
                id="cga-mode-{{ mode_key }}"
                {{ config.entity_mode|default('mono') == mode_key ? 'checked' : '' }}
              >
              <label class="form-check-label" for="cga-mode-{{ mode_key }}">{{ mode_label }}</label>
            </div>
          {% endfor %}

          <div id="cga-levels-section" class="mt-4 ps-1 border-start border-2">
            <div class="mb-3 ps-2">
              <label class="form-label">{{ __('Combien de niveaux de sous-entités ?', 'configurationglpiauto') }}</label>
              <input
                type="number"
                name="entity_levels"
                id="cga-levels-input"
                class="form-control"
                min="1"
                max="{{ max_levels }}"
                value="{{ config.entity_levels|default(1) }}"
                style="max-width: 100px;"
              >
              <div class="form-text">{{ __('Par exemple : Site, puis Service, puis Équipe — jusqu\'à', 'configurationglpiauto') }} {{ max_levels }} {{ __('niveaux.', 'configurationglpiauto') }}</div>
            </div>

            <div class="mb-3 ps-2">
              <label class="form-label">{{ __('Nom de chaque niveau', 'configurationglpiauto') }}</label>
              <div id="cga-level-labels"></div>
            </div>
          </div>

          <button type="submit" name="update" class="btn btn-outline-primary mt-2">{{ __('Enregistrer') }}</button>
          <button
            type="submit"
            name="apply"
            class="btn btn-primary mt-2"
            id="cga-apply-btn"
            onclick="return confirm('{{ __('Ceci va créer de vraies entités dans GLPI selon la structure choisie. Continuer ?', 'configurationglpiauto')|e('js') }}');"
          >
            {{ __('Enregistrer et créer les entités', 'configurationglpiauto') }}
          </button>
          <div class="form-text mt-2">{{ __('Crée une branche modèle (une entité par niveau, dupliquez/renommez-la ensuite depuis Administration > Entités). Sans effet en mode mono-entité.', 'configurationglpiauto') }}</div>
        </form>
      </div>
    </div>
  </div>

  <div class="col">
    <div class="card">
      <div class="card-body">
        <h3 class="mb-1">{{ __('Aperçu', 'configurationglpiauto') }}</h3>
        <p class="text-muted small mb-3">{{ __('Se met à jour en direct pendant que vous réglez les options à gauche — rien n\'est enregistré tant que vous ne cliquez pas sur "Enregistrer".', 'configurationglpiauto') }}</p>
        <div id="cga-tree-preview"></div>
        <p class="text-muted small mt-3 mb-0" id="cga-tree-caption"></p>
      </div>
    </div>
  </div>
</div>

<style>
  .cga-tree, .cga-tree ul { list-style: none; margin: 0; padding-left: 1.25rem; }
  .cga-tree { padding-left: 0; }
  .cga-tree li { position: relative; padding: .15rem 0; }
  .cga-tree > li { padding-left: 0; }
  .cga-tree ul li::before {
    content: ''; position: absolute; left: -.9rem; top: .8rem; width: .7rem; height: 1px;
    background: var(--tblr-border-color, #ccc);
  }
  .cga-tree .ti { margin-right: .35rem; color: var(--tblr-primary, #206bc4); }
</style>

<script>
(function () {
  var form = document.getElementById('cga-config-form');
  var levelsSection = document.getElementById('cga-levels-section');
  var levelsInput = document.getElementById('cga-levels-input');
  var labelsContainer = document.getElementById('cga-level-labels');
  var previewEl = document.getElementById('cga-tree-preview');
  var captionEl = document.getElementById('cga-tree-caption');
  var initialLabels = {{ level_labels|json_encode|raw }};
  var maxLevels = {{ max_levels }};

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function currentMode() {
    var checked = form.querySelector('input[name="entity_mode"]:checked');
    return checked ? checked.value : 'mono';
  }

  function levelLabelInputs() {
    return Array.prototype.slice.call(labelsContainer.querySelectorAll('.cga-level-label-input'));
  }

  function rebuildLevelInputs() {
    var count = Math.max(1, Math.min(maxLevels, parseInt(levelsInput.value, 10) || 1));
    var existing = levelLabelInputs().map(function (input) { return input.value; });
    labelsContainer.innerHTML = '';
    for (var i = 0; i < count; i++) {
      var wrapper = document.createElement('div');
      wrapper.className = 'mb-2';
      var input = document.createElement('input');
      input.type = 'text';
      input.name = 'level_label[]';
      input.className = 'form-control cga-level-label-input';
      input.placeholder = 'Niveau ' + (i + 1);
      input.value = existing[i] || initialLabels[i] || '';
      input.addEventListener('input', renderPreview);
      wrapper.appendChild(input);
      labelsContainer.appendChild(wrapper);
    }
    renderPreview();
  }

  function levelLabels() {
    return levelLabelInputs().map(function (input, i) {
      return input.value.trim() || ('Niveau ' + (i + 1));
    });
  }

  // Only ever expands the "A" branch one level deeper — the "B" branch stays a leaf. Showing
  // the full 2^n tree for 5 levels would be unreadable; this still conveys "each node can have
  // several children of the next level" without it, backed up by the caption text below.
  function buildBranchHtml(labels, depth) {
    if (depth >= labels.length) {
      return '';
    }
    var label = escapeHtml(labels[depth]);
    var childHtml = buildBranchHtml(labels, depth + 1);
    return '<ul class="cga-tree">'
      + '<li><i class="ti ti-corner-down-right"></i>' + label + ' A' + childHtml + '</li>'
      + '<li><i class="ti ti-corner-down-right"></i>' + label + ' B</li>'
      + '</ul>';
  }

  function renderPreview() {
    var mode = currentMode();
    levelsSection.style.display = mode === 'mono' ? 'none' : '';

    if (mode === 'mono') {
      previewEl.innerHTML = '<ul class="cga-tree"><li><i class="ti ti-building"></i>Entité racine — votre organisation</li></ul>';
      captionEl.textContent = '';
      return;
    }

    var labels = levelLabels();
    var isMsp = mode === 'multi_msp';
    var rootLabel = isMsp ? 'Votre société (MSP)' : 'Entité racine';
    var branchLabels = isMsp ? ['Client'].concat(labels) : labels;
    var html = '<ul class="cga-tree"><li><i class="ti ti-building"></i>' + escapeHtml(rootLabel)
      + buildBranchHtml(branchLabels, 0) + '</li></ul>';
    previewEl.innerHTML = html;
    captionEl.textContent = "{{ __('Chaque nœud peut avoir plusieurs enfants du niveau suivant — seule une branche est développée ici pour rester lisible.', 'configurationglpiauto')|e('js') }}";
  }

  form.querySelectorAll('.cga-mode-radio').forEach(function (radio) {
    radio.addEventListener('change', renderPreview);
  });
  levelsInput.addEventListener('input', rebuildLevelInputs);

  rebuildLevelInputs();
})();
</script>
