{# Used by templates/wizard.html.twig (setup wizard, step "Entités") — kept as its own partial
   (rather than inlined in wizard.html.twig) in case a future screen needs the same entity
   structure fields again. Caller provides an enclosing <form>; this partial only renders fields.

   The tree is a genuinely arbitrary structure: any node can have any number of children, at any
   depth, independent of its siblings (e.g. "Client A" has 6 children and one of those has 3
   children of its own, while "Client B" has none) — not a uniform "N levels applied to every
   branch" shape. The whole tree is serialized to one hidden field (entity_tree_json) on every
   change rather than kept in sync via indexed input names, since add/remove at an arbitrary
   depth would otherwise require renumbering siblings on every edit. #}
<div class="row flex-nowrap align-items-start" style="gap: 1rem;">
  <div class="col" style="min-width: 360px; max-width: 520px;">
    {% for mode_key, mode_label in modes %}
      <div class="form-check mb-2">
        <input
          type="radio"
          name="entity_mode"
          value="{{ mode_key }}"
          class="form-check-input cga-mode-radio"
          id="cga-mode-{{ mode_key }}"
          {{ config.entity_mode|default('mono') == mode_key ? 'checked' : '' }}
        >
        <label class="form-check-label" for="cga-mode-{{ mode_key }}">{{ mode_label }}</label>
      </div>
    {% endfor %}

    <div id="cga-tree-section" class="mt-4 ps-1 border-start border-2">
      <div class="ps-2">
        <label class="form-label" id="cga-tree-editor-label">{{ __('Arborescence', 'configurationglpiauto') }}</label>
        <div class="form-text mb-2" id="cga-tree-editor-hint"></div>
        <div id="cga-tree-editor"></div>
        <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="cga-tree-add-root">
          <i class="ti ti-plus"></i> <span id="cga-tree-add-root-label"></span>
        </button>
      </div>
    </div>

    <input type="hidden" name="entity_tree_json" id="cga-entity-tree-json" value="[]">
  </div>

  <div class="col">
    <div class="card">
      <div class="card-body">
        <h3 class="mb-1">{{ __('Aperçu', 'configurationglpiauto') }}</h3>
        <p class="text-muted small mb-3">{{ __('Se met à jour en direct pendant que vous réglez les options à gauche — rien n\'est enregistré tant que vous ne validez pas.', 'configurationglpiauto') }}</p>
        <div id="cga-tree-preview"></div>
        <p class="text-muted small mt-3 mb-0" id="cga-tree-caption"></p>
      </div>
    </div>
  </div>
</div>

<style>
  .cga-tree, .cga-tree ul { list-style: none; margin: 0; padding-left: 1.25rem; }
  .cga-tree { padding-left: 0; }
  .cga-tree li { position: relative; padding: .15rem 0; }
  .cga-tree > li { padding-left: 0; }
  .cga-tree ul li::before {
    content: ''; position: absolute; left: -.9rem; top: .8rem; width: .7rem; height: 1px;
    background: var(--tblr-border-color, #ccc);
  }
  .cga-tree .ti { margin-right: .35rem; color: var(--tblr-primary, #206bc4); }
  .cga-node-children {
    margin-left: 1.25rem;
    padding-left: .75rem;
    border-left: 2px solid var(--tblr-border-color, #ddd);
  }
  .cga-node-row { display: flex; gap: .4rem; align-items: center; margin-bottom: .4rem; }
</style>

<script>
(function () {
  var treeSection = document.getElementById('cga-tree-section');
  var editorEl = document.getElementById('cga-tree-editor');
  var editorLabel = document.getElementById('cga-tree-editor-label');
  var editorHint = document.getElementById('cga-tree-editor-hint');
  var addRootBtn = document.getElementById('cga-tree-add-root');
  var addRootLabel = document.getElementById('cga-tree-add-root-label');
  var treeJsonInput = document.getElementById('cga-entity-tree-json');
  var previewEl = document.getElementById('cga-tree-preview');
  var captionEl = document.getElementById('cga-tree-caption');
  var maxLevels = {{ max_levels }};

  var treeState = {{ entity_tree|default([])|json_encode|raw }};
  // Exposed so steps 3/4 (calendar/SLA) can render a panel per top-level node (MSP client) when
  // per-client settings are turned on there — same array reference, not a copy, so edits either
  // side makes (add/remove a client, or set node.settings from the per-client panels) stay in
  // sync without a second data channel to keep in step with the tree by index.
  window.cgaTree = treeState;

  var texts = {
    msp: {
      editorHint: "{{ __('Un nœud par client. Chaque client peut avoir un nombre différent de sous-entités, à sa propre profondeur.', 'configurationglpiauto')|e('js') }}",
      addRoot: "{{ __('Ajouter un client', 'configurationglpiauto')|e('js') }}",
      rootPlaceholder: "{{ __('Ex : Entreprise Dupont', 'configurationglpiauto')|e('js') }}",
      rootLabel: "{{ __('Votre société (MSP)', 'configurationglpiauto')|e('js') }}"
    },
    same: {
      editorHint: "{{ __('Un nœud par site/service de premier niveau. Chacun peut avoir un nombre différent de sous-entités, à sa propre profondeur.', 'configurationglpiauto')|e('js') }}",
      addRoot: "{{ __('Ajouter une entité', 'configurationglpiauto')|e('js') }}",
      rootPlaceholder: "{{ __('Ex : Paris, Lyon...', 'configurationglpiauto')|e('js') }}",
      rootLabel: "{{ __('Entité racine', 'configurationglpiauto')|e('js') }}"
    }
  };

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function currentMode() {
    var checked = document.querySelector('input[name="entity_mode"]:checked');
    return checked ? checked.value : 'mono';
  }

  function isMsp() {
    return currentMode() === 'multi_msp';
  }

  function renderNode(node, parentArray, container, depth) {
    var wrapper = document.createElement('div');
    if (depth > 0) {
      wrapper.className = 'cga-node-children';
    }

    var row = document.createElement('div');
    row.className = 'cga-node-row';

    var input = document.createElement('input');
    input.type = 'text';
    input.className = 'form-control form-control-sm';
    input.value = node.name;
    input.placeholder = depth === 0
      ? (isMsp() ? texts.msp.rootPlaceholder : texts.same.rootPlaceholder)
      : "{{ __('Nom de la sous-entité', 'configurationglpiauto')|e('js') }}";
    input.addEventListener('input', function () {
      node.name = input.value;
      syncAndRenderPreview();
    });
    row.appendChild(input);

    if (depth + 1 < maxLevels) {
      var addBtn = document.createElement('button');
      addBtn.type = 'button';
      addBtn.className = 'btn btn-outline-secondary btn-sm';
      addBtn.title = "{{ __('Ajouter une sous-entité', 'configurationglpiauto')|e('js') }}";
      addBtn.innerHTML = '<i class="ti ti-plus"></i>';
      addBtn.addEventListener('click', function () {
        node.children.push({ name: '', children: [] });
        renderEditor();
      });
      row.appendChild(addBtn);
    }

    var removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'btn btn-outline-danger btn-sm';
    removeBtn.title = "{{ __('Retirer', 'configurationglpiauto')|e('js') }}";
    removeBtn.innerHTML = '<i class="ti ti-x"></i>';
    removeBtn.addEventListener('click', function () {
      var idx = parentArray.indexOf(node);
      if (idx !== -1) {
        parentArray.splice(idx, 1);
      }
      renderEditor();
    });
    row.appendChild(removeBtn);

    wrapper.appendChild(row);

    node.children.forEach(function (child) {
      renderNode(child, node.children, wrapper, depth + 1);
    });

    container.appendChild(wrapper);
  }

  function renderEditor() {
    editorEl.innerHTML = '';
    treeState.forEach(function (node) {
      renderNode(node, treeState, editorEl, 0);
    });
    syncAndRenderPreview();
  }

  // Real tree, so the preview shows the exact structure — no "illustrative A/B" guess needed,
  // unlike the earlier uniform-levels version of this screen.
  function buildTreeLi(node) {
    var childrenHtml = node.children.length
      ? '<ul class="cga-tree">' + node.children.map(buildTreeLi).join('') + '</ul>'
      : '';
    return '<li><i class="ti ti-corner-down-right"></i>' + escapeHtml(node.name || '…') + childrenHtml + '</li>';
  }

  function syncAndRenderPreview() {
    treeJsonInput.value = JSON.stringify(treeState);
    document.dispatchEvent(new CustomEvent('cga:tree-changed'));

    var mode = currentMode();
    treeSection.style.display = mode === 'mono' ? 'none' : '';

    if (mode === 'mono') {
      previewEl.innerHTML = '<ul class="cga-tree"><li><i class="ti ti-building"></i>Entité racine — votre organisation</li></ul>';
      captionEl.textContent = '';
      return;
    }

    var t = isMsp() ? texts.msp : texts.same;
    editorHint.textContent = t.editorHint;
    addRootLabel.textContent = t.addRoot;

    var childrenHtml = treeState.length
      ? '<ul class="cga-tree">' + treeState.map(buildTreeLi).join('') + '</ul>'
      : '';
    previewEl.innerHTML = '<ul class="cga-tree"><li><i class="ti ti-building"></i>' + escapeHtml(t.rootLabel) + childrenHtml + '</li></ul>';
    captionEl.textContent = treeState.length
      ? ''
      : "{{ __('Aucune entité ajoutée pour l\'instant.', 'configurationglpiauto')|e('js') }}";
  }

  addRootBtn.addEventListener('click', function () {
    treeState.push({ name: '', children: [] });
    renderEditor();
  });

  document.querySelectorAll('.cga-mode-radio').forEach(function (radio) {
    radio.addEventListener('change', syncAndRenderPreview);
  });

  renderEditor();
})();
</script>
