{# Issue #495 : page de configuration du plugin (Configuration > Plugins > Configuration GLPI Auto),
   réglages seulement, un onglet par famille (ConfigSettings::tabs()). Chaque onglet est un lien
   (?tab=...) : après un enregistrement, la page revient sur l'onglet du formulaire. #}
{% set disabled = can_edit ? '' : 'disabled' %}

{% include '@configurationglpiauto/_page_help.html.twig' with {
   page: 'config',
   purpose: __('Les réglages du plugin, et seulement eux : délais des contrôles de l\'audit, rapport périodique, fin de support des systèmes et du matériel.', 'configurationglpiauto'),
   expected: __('Réglez chaque onglet puis enregistrez-le. L\'assistant, l\'audit, les profils, l\'historique et les imports s\'ouvrent depuis le menu Configuration > Configuration GLPI Auto.', 'configurationglpiauto'),
} %}

<nav aria-label="{{ __('Réglages de Configuration GLPI Auto', 'configurationglpiauto') }}">
   <ul class="nav nav-tabs mb-3" role="tablist">
      {% for item in tabs %}
         <li class="nav-item" role="presentation">
            <a class="nav-link{{ item.active ? ' active' : '' }}" role="tab" aria-selected="{{ item.active ? 'true' : 'false' }}" href="{{ item.url }}">
               <i class="{{ item.icon }} me-1" aria-hidden="true"></i>{{ item.label }}
            </a>
         </li>
      {% endfor %}
   </ul>
</nav>

{% if not can_edit %}
   <div class="alert alert-info"><i class="ti ti-lock me-1"></i>{{ __('Lecture seule : modifier ces réglages demande le droit de modification de la configuration de GLPI et de ce plugin.', 'configurationglpiauto') }}</div>
{% endif %}

{% if tab == 'general' %}
   {% include '@configurationglpiauto/_plugin_version.html.twig' with {plugin_version: version} %}
   <div class="card">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-adjustments me-2"></i>{{ __('Réglages gérés par GLPI', 'configurationglpiauto') }}</h3>
      </div>
      <div class="card-body">
         <ul class="list-unstyled mb-0">
            <li class="mb-2"><i class="ti ti-user-shield me-1"></i><a href="{{ links.rights }}" class="text-decoration-underline">{{ __('Droits du plugin', 'configurationglpiauto') }}</a>
               <span class="text-muted small">{{ __('Administration > Profils, onglet « Configuration GLPI Auto » de chaque profil.', 'configurationglpiauto') }}</span></li>
            <li class="mb-2"><i class="ti ti-bell me-1"></i><a href="{{ links.notifications }}" class="text-decoration-underline">{{ __('Notifications', 'configurationglpiauto') }}</a>
               <span class="text-muted small">{{ __('Modèle et destinataires du rapport d\'audit périodique.', 'configurationglpiauto') }}</span></li>
            <li><i class="ti ti-clock-cog me-1"></i><a href="{{ links.crontasks }}" class="text-decoration-underline">{{ __('Actions automatiques', 'configurationglpiauto') }}</a>
               <span class="text-muted small">{{ __('Analyse continue de l\'audit, rapport périodique et vérification des nouvelles versions (checkupdate).', 'configurationglpiauto') }}</span></li>
         </ul>
      </div>
   </div>
{% elseif tab == 'controls' %}
   {# Issue #306 : délais des contrôles du parc #}
   <div class="card">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-devices-search me-2"></i>{{ __('Contrôles du parc', 'configurationglpiauto') }}</h3>
      </div>
      <div class="card-body">
         <p class="text-muted">{{ __('Ces contrôles ne modifient jamais le matériel : « Créer les tickets » ouvre des tickets liés au matériel concerné, que l\'équipe traite. Mettre 0 désactive un contrôle.', 'configurationglpiauto') }}</p>
         <form method="post" action="{{ action }}" class="row g-3 align-items-end">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <div class="col-md-5">
               <label class="form-label" for="cga-ghost-days"><i class="ti ti-ghost me-1"></i>{{ __('Matériel qui ne remonte plus à l\'inventaire depuis (jours)', 'configurationglpiauto') }}</label>
               <input type="number" min="0" max="3650" class="form-control" name="audit_ghost_days" id="cga-ghost-days" value="{{ park.ghost_days }}" {{ disabled }}>
            </div>
            <div class="col-md-5">
               <label class="form-label" for="cga-warranty-days"><i class="ti ti-shield-check me-1"></i>{{ __('Garanties qui expirent dans (jours)', 'configurationglpiauto') }}</label>
               <input type="number" min="0" max="3650" class="form-control" name="audit_warranty_days" id="cga-warranty-days" value="{{ park.warranty_days }}" {{ disabled }}>
            </div>
            {% if can_edit %}
               <div class="col-md-2">
                  <button type="submit" name="save_park" value="1" class="btn btn-primary w-100"><i class="ti ti-device-floppy me-1"></i>{{ __('Enregistrer', 'configurationglpiauto') }}</button>
               </div>
            {% endif %}
         </form>
      </div>
   </div>

   {# Issue #285 : rapport d'audit périodique par e-mail. Fréquence = tâche planifiée GLPI
      « auditreport » ; modèle et destinataires = notification GLPI native. #}
   <div class="card mt-3">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-mail-forward me-2"></i>{{ __('Rapport périodique par e-mail', 'configurationglpiauto') }}</h3>
      </div>
      <div class="card-body">
         <p class="text-muted">{{ __('Reçoit automatiquement la synthèse de cet audit : nombre de contrôles OK, en alerte et en échec, points à traiter avec leur recommandation et évolution depuis le rapport précédent. Aucun mot de passe ni secret n\'est envoyé, seulement les constats.', 'configurationglpiauto') }}</p>
         {% if not report.notifications_on %}
            <div class="alert alert-warning"><i class="ti ti-alert-triangle me-1"></i>{{ __('Les notifications par e-mail de GLPI sont désactivées : activez-les dans Configuration > Notifications.', 'configurationglpiauto') }}</div>
         {% endif %}
         <form method="post" action="{{ action }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <div class="row g-3">
               <div class="col-md-4">
                  <label class="form-label" for="cga-report-frequency">{{ __('Fréquence', 'configurationglpiauto') }}</label>
                  <select class="form-select" name="audit_report_frequency" id="cga-report-frequency" {{ disabled }}>
                     <option value="off" {{ report.frequency == 'off' ? 'selected' : '' }}>{{ __('Désactivé', 'configurationglpiauto') }}</option>
                     <option value="week" {{ report.frequency == 'week' ? 'selected' : '' }}>{{ __('Hebdomadaire', 'configurationglpiauto') }}</option>
                     <option value="month" {{ report.frequency == 'month' ? 'selected' : '' }}>{{ __('Mensuel', 'configurationglpiauto') }}</option>
                  </select>
                  <div class="form-check form-switch mt-3">
                     <input type="checkbox" class="form-check-input" name="audit_report_only_on_change" value="1" id="cga-report-only-on-change" {{ report.only_on_change ? 'checked' : '' }} {{ disabled }}>
                     <label class="form-check-label" for="cga-report-only-on-change">{{ __('N\'envoyer que s\'il y a un changement ou une anomalie', 'configurationglpiauto') }}</label>
                  </div>
               </div>
               <div class="col-md-8">
                  <label class="form-label" for="cga-report-emails">{{ __('Adresses supplémentaires (facultatif)', 'configurationglpiauto') }}</label>
                  <textarea class="form-control" name="audit_report_emails" id="cga-report-emails" rows="3" placeholder="rssi@exemple.fr" {{ disabled }}>{{ report.emails }}</textarea>
                  <small class="form-hint">{{ __('Une adresse par ligne, pour des destinataires sans compte GLPI. Par défaut, le rapport part à l\'administrateur GLPI ; profils et groupes se choisissent dans les destinataires de la notification.', 'configurationglpiauto') }}</small>
               </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
               {% if can_edit %}
                  <button type="submit" name="save_report" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Enregistrer', 'configurationglpiauto') }}</button>
               {% endif %}
               {% if report.notification_url %}
                  <a href="{{ report.notification_url }}" class="btn btn-link"><i class="ti ti-bell-cog me-1"></i>{{ __('Modifier le modèle et les destinataires', 'configurationglpiauto') }}</a>
               {% endif %}
            </div>
         </form>
      </div>
   </div>
{% elseif tab == 'eol' %}
   {# Issue #467 : fin de support des systèmes et du matériel (endoflife.date), facultative #}
   <div class="card" id="cga-eol">
      <div class="card-header">
         <h3 class="card-title"><i class="ti ti-calendar-off me-2"></i>{{ __('Fin de support des systèmes et du matériel', 'configurationglpiauto') }}</h3>
         <div class="card-actions">
            {% if eol.enabled %}
               <span class="badge bg-green-subtle text-green-emphasis"><i class="ti ti-check me-1"></i>{{ __('Activé', 'configurationglpiauto') }}</span>
               {% if eol.offline %}<span class="badge bg-secondary-subtle text-secondary-emphasis ms-1"><i class="ti ti-wifi-off me-1"></i>{{ __('Hors ligne', 'configurationglpiauto') }}</span>{% endif %}
            {% else %}
               <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-player-pause me-1"></i>{{ __('Désactivé', 'configurationglpiauto') }}</span>
            {% endif %}
         </div>
      </div>
      <div class="card-body">
         <div class="alert alert-info">
            <strong><i class="ti ti-help-circle me-1"></i>{{ __('À quoi sert ce contrôle ?', 'configurationglpiauto') }}</strong>
            <p class="mb-0">{{ __('Il signale les systèmes d\'exploitation et les modèles de matériel en service dont le support du fabricant est terminé ou se termine bientôt, d\'après les dates publiques du site endoflife.date. Rien n\'est téléchargé tant qu\'il n\'est pas activé, seul endoflife.date est contacté, et seulement quand vous cliquez sur « Télécharger les dates » dans la page d\'audit. Le contrôle lit ensuite ces dates gardées en base : il ne modifie jamais le matériel.', 'configurationglpiauto') }}</p>
         </div>
         <form method="post" action="{{ action }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <div class="row g-3">
               <div class="col-md-6">
                  <div class="form-check form-switch">
                     <input type="checkbox" class="form-check-input" name="audit_eol_enabled" value="1" id="cga-eol-enabled" {{ eol.enabled ? 'checked' : '' }} {{ disabled }}>
                     <label class="form-check-label" for="cga-eol-enabled">{{ __('Activer le contrôle de fin de support', 'configurationglpiauto') }}</label>
                  </div>
                  <div class="form-check form-switch">
                     <input type="checkbox" class="form-check-input" name="audit_eol_offline" value="1" id="cga-eol-offline" {{ eol.offline ? 'checked' : '' }} {{ disabled }}>
                     <label class="form-check-label" for="cga-eol-offline">{{ __('Mode hors ligne : ne jamais contacter endoflife.date, importer les fichiers à la main', 'configurationglpiauto') }}</label>
                  </div>
               </div>
               <div class="col-md-6">
                  <label class="form-label" for="cga-eol-days"><i class="ti ti-hourglass me-1"></i>{{ __('Signaler une fin de support dans les (jours)', 'configurationglpiauto') }}</label>
                  <input type="number" min="0" max="3650" class="form-control" name="audit_eol_days" id="cga-eol-days" value="{{ eol.days }}" {{ disabled }}>
               </div>
               <div class="col-12">
                  <label class="form-label" for="cga-eol-mapping"><i class="ti ti-arrows-exchange me-1"></i>{{ __('Correspondances : une ligne par nom de système ou de modèle, tel qu\'il apparaît dans GLPI', 'configurationglpiauto') }}</label>
                  <textarea class="form-control font-monospace" rows="6" name="audit_eol_mapping" id="cga-eol-mapping" placeholder="Microsoft Windows 11 Professionnel = windows&#10;Debian GNU/Linux = debian&#10;iPhone 12 = iphone 12" {{ disabled }}>{{ eol.mapping }}</textarea>
                  <div class="form-text">{{ __('Forme : « Nom dans GLPI = produit », ou « Nom dans GLPI = produit cycle » pour imposer le cycle. Le produit est l\'identifiant de la page endoflife.date (par exemple windows pour endoflife.date/windows). Les noms sans correspondance ne sont pas contrôlés.', 'configurationglpiauto') }}</div>
               </div>
            </div>
            {% if can_edit %}
               <div class="mt-3 d-flex flex-wrap gap-2">
                  <button type="submit" name="save_eol" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Enregistrer', 'configurationglpiauto') }}</button>
                  <button type="submit" name="suggest_eol" value="1" class="btn btn-outline-secondary" formnovalidate><i class="ti ti-bulb me-1"></i>{{ __('Proposer les correspondances', 'configurationglpiauto') }}</button>
               </div>
            {% endif %}
         </form>

         {% if can_edit and eol.enabled %}
            <form method="post" enctype="multipart/form-data" action="{{ action }}" class="row g-2 align-items-end mt-4">
               <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
               <div class="col-12 small text-muted"><i class="ti ti-wifi-off me-1"></i>{{ __('Sans accès à Internet : sur un autre poste, enregistrez https://endoflife.date/api/v1/products/windows/ dans un fichier (windows étant le produit voulu), puis importez-le ici.', 'configurationglpiauto') }}</div>
               <div class="col-md-3">
                  <label class="form-label" for="cga-eol-product">{{ __('Produit', 'configurationglpiauto') }}</label>
                  <input type="text" class="form-control" name="eol_product" id="cga-eol-product" maxlength="64" placeholder="windows" required>
               </div>
               <div class="col-md-6">
                  <label class="form-label" for="cga-eol-file">{{ __('Fichier JSON endoflife.date', 'configurationglpiauto') }}</label>
                  <input type="file" class="form-control" name="eol_file" id="cga-eol-file" accept=".json,application/json" required>
               </div>
               <div class="col-md-3">
                  <button type="submit" name="import_eol" value="1" class="btn btn-outline-secondary w-100"><i class="ti ti-file-import me-1"></i>{{ __('Importer', 'configurationglpiauto') }}</button>
               </div>
            </form>
         {% endif %}
      </div>
   </div>
{% endif %}
