{# Issue #345 : import par lots, la page enchaîne seule ; elle reprend où elle s'est arrêtée. Commun
   aux imports Jira et CSV (issue #430). #}
{% if job.resumed and job.done > 0 %}
   <div class="alert alert-warning"><i class="ti ti-player-pause me-1"></i>{{ __('Un import a été interrompu : %1$d ticket(s) sur %2$d déjà traités. Reprenez-le, ou arrêtez-le (les tickets déjà importés restent).', 'configurationglpiauto')|format(job.done, job.total) }}</div>
{% else %}
   <p>{{ __('Import en cours, par lots de %d tickets. Vous pouvez quitter la page : l\'import reprendra où il s\'est arrêté à votre retour sur cette page.', 'configurationglpiauto')|format(batch_size) }}</p>
{% endif %}
<div class="d-flex justify-content-between small mb-1">
   <span>{{ __('%1$d ticket(s) traités sur %2$d', 'configurationglpiauto')|format(job.done, job.total) }}</span>
   <span>{{ job.percent }} %</span>
</div>
<div class="progress mb-3" style="height: 1.25rem;" role="progressbar" aria-valuenow="{{ job.percent }}" aria-valuemin="0" aria-valuemax="100" aria-label="{{ __('Avancement de l\'import', 'configurationglpiauto') }}">
   <div class="progress-bar bg-primary" style="width: {{ job.percent }}%"></div>
</div>
<p>
   <span class="badge bg-green-lt me-1"><i class="ti ti-plus me-1"></i>{{ __('%d créé(s)', 'configurationglpiauto')|format(job.result.created) }}</span>
   <span class="badge bg-blue-lt me-1"><i class="ti ti-refresh me-1"></i>{{ __('%d mis à jour', 'configurationglpiauto')|format(job.result.updated) }}</span>
   {% if job.result.security %}<span class="badge bg-red-lt me-1"><i class="ti ti-shield-exclamation me-1"></i>{{ __('%d incident(s) de sécurité', 'configurationglpiauto')|format(job.result.security) }}</span>{% endif %}
   {% if job.result.errors is not empty %}<span class="badge bg-orange-lt me-1"><i class="ti ti-alert-triangle me-1"></i>{{ __('%d erreur(s)', 'configurationglpiauto')|format(job.result.errors|length) }}</span>{% endif %}
</p>
<form method="post" action="{{ url }}" id="cga-import-continue" data-auto="{{ job.resumed ? '0' : '1' }}" class="d-flex gap-2">
   <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
   <button type="submit" name="continue_import" value="1" class="btn btn-primary"><i class="ti ti-player-play me-1"></i>{{ job.resumed and job.done > 0 ? __('Reprendre l\'import', 'configurationglpiauto') : __('Continuer', 'configurationglpiauto') }}</button>
   <button type="submit" name="cancel" value="1" class="btn btn-outline-danger"><i class="ti ti-player-stop me-1"></i>{{ __('Arrêter l\'import', 'configurationglpiauto') }}</button>
   <a class="btn btn-outline-secondary" href="{{ log_url }}"><i class="ti ti-download me-1"></i>{{ __('Journal (CSV)', 'configurationglpiauto') }}</a>
</form>
<script>
(function () {
  var form = document.getElementById('cga-import-continue');
  if (form && form.dataset.auto === '1') {
    var button = form.querySelector('button[name="continue_import"]');
    window.setTimeout(function () { button.click(); }, 300);
  }
})();
</script>

