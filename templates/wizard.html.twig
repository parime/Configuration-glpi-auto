  var calendarPerClientPanels = document.getElementById('cga-calendar-per-client-panels');

  function renderCalendarPerClientPanels() {
    calendarPerClientPanels.innerHTML = '';
    (window.cgaTree || []).forEach(function (node, i) {
      var settings = (node.settings && node.settings.calendar) || { enabled: false, days: [1, 2, 3, 4, 5], begin: '08:00', end: '18:00', dayHours: {}, lunchBreakEnabled: false, lunchBegin: '12:00', lunchEnd: '13:00' };
      settings.dayHours = settings.dayHours || {};

      var card = document.createElement('div');
      card.className = 'card mb-2';
      var body = document.createElement('div');
      body.className = 'card-body';

      var title = document.createElement('h4');
      title.className = 'mb-2';
      title.textContent = node.name || "{{ __('(sans nom)', 'configurationglpiauto')|e('js') }}";
      body.appendChild(title);

      var switchWrap = document.createElement('div');
      switchWrap.className = 'form-check form-switch mb-2';
      var enabledInput = document.createElement('input');
      enabledInput.type = 'checkbox';
      enabledInput.className = 'form-check-input';
      enabledInput.id = 'cga-cal-pc-' + i + '-enabled';
      enabledInput.checked = !!settings.enabled;
      var enabledLabel = document.createElement('label');
      enabledLabel.className = 'form-check-label';
      enabledLabel.setAttribute('for', enabledInput.id);
      enabledLabel.textContent = "{{ __('Créer un calendrier pour cette entité', 'configurationglpiauto')|e('js') }}";
      switchWrap.appendChild(enabledInput);
      switchWrap.appendChild(enabledLabel);
      body.appendChild(switchWrap);

      var fieldsWrap = document.createElement('div');
      fieldsWrap.style.display = settings.enabled ? '' : 'none';

      function writeBack() {
        node.settings = node.settings || {};
        settings.enabled = enabledInput.checked;
        node.settings.calendar = settings;
        syncTreeJson();
      }

      var daysLabel = document.createElement('label');
      daysLabel.className = 'form-label d-block';
      daysLabel.textContent = "{{ __('Jours ouvrés et horaires', 'configurationglpiauto')|e('js') }}";
      fieldsWrap.appendChild(daysLabel);
      var daysContainer = document.createElement('div');
      daysContainer.className = 'mb-2';
      fieldsWrap.appendChild(daysContainer);

      function renderDayRows() {
        daysContainer.innerHTML = '';
        DAYS.forEach(function (day) {
          var dayHours = settings.dayHours[day.value] || settings.dayHours[String(day.value)];
          var begin = (dayHours && dayHours.begin) || settings.begin || '08:00';
          var end = (dayHours && dayHours.end) || settings.end || '18:00';
          var checked = settings.days.indexOf(day.value) !== -1;

          var dayRow = document.createElement('div');
          dayRow.className = 'd-flex align-items-center gap-2 mb-1 flex-wrap';

          var wrapper = document.createElement('div');
          wrapper.className = 'form-check';
          wrapper.style.minWidth = '110px';
          var input = document.createElement('input');
          input.type = 'checkbox';
          input.className = 'form-check-input';
          input.id = 'cga-cal-pc-' + i + '-day-' + day.value;
          input.checked = checked;
          var label = document.createElement('label');
          label.className = 'form-check-label';
          label.setAttribute('for', input.id);
          label.textContent = day.label;
          wrapper.appendChild(input);
          wrapper.appendChild(label);
          dayRow.appendChild(wrapper);

          var hoursWrap = document.createElement('div');
          hoursWrap.className = 'd-flex align-items-center gap-1';
          hoursWrap.style.display = checked ? '' : 'none';
          var beginInput = document.createElement('input');
          beginInput.type = 'time';
          beginInput.className = 'form-control form-control-sm';
          beginInput.style.width = '110px';
          beginInput.value = begin;
          var sep = document.createElement('span');
          sep.className = 'text-muted small';
          sep.textContent = '—';
          var endInput = document.createElement('input');
          endInput.type = 'time';
          endInput.className = 'form-control form-control-sm';
          endInput.style.width = '110px';
          endInput.value = end;
          hoursWrap.appendChild(beginInput);
          hoursWrap.appendChild(sep);
          hoursWrap.appendChild(endInput);
          dayRow.appendChild(hoursWrap);

          function writeDayHours() {
            settings.dayHours[day.value] = { begin: beginInput.value, end: endInput.value };
            writeBack();
          }
          beginInput.addEventListener('input', writeDayHours);
          endInput.addEventListener('input', writeDayHours);

          input.addEventListener('change', function () {
            hoursWrap.style.display = input.checked ? '' : 'none';
            settings.days = DAYS.filter(function (d) {
              return document.getElementById('cga-cal-pc-' + i + '-day-' + d.value).checked;
            }).map(function (d) { return d.value; });
            if (input.checked) {
              writeDayHours();
            } else {
              writeBack();
            }
          });

          daysContainer.appendChild(dayRow);
        });
      }
      renderDayRows();

      var lunchSwitchWrap = document.createElement('div');
      lunchSwitchWrap.className = 'form-check form-switch mb-2';
      var lunchInput = document.createElement('input');
      lunchInput.type = 'checkbox';
      lunchInput.className = 'form-check-input';
      lunchInput.id = 'cga-cal-pc-' + i + '-lunch';
      lunchInput.checked = !!settings.lunchBreakEnabled;
      var lunchLabel = document.createElement('label');
      lunchLabel.className = 'form-check-label';
      lunchLabel.setAttribute('for', lunchInput.id);
      lunchLabel.textContent = "{{ __('Coupure déjeuner', 'configurationglpiauto')|e('js') }}";
      lunchSwitchWrap.appendChild(lunchInput);
      lunchSwitchWrap.appendChild(lunchLabel);
      fieldsWrap.appendChild(lunchSwitchWrap);

      var lunchRow = document.createElement('div');
      lunchRow.className = 'row mb-2';
      lunchRow.style.maxWidth = '320px';
      lunchRow.style.display = settings.lunchBreakEnabled ? '' : 'none';
      [
        ["{{ __('Début pause', 'configurationglpiauto')|e('js') }}", 'lunchBegin'],
        ["{{ __('Fin pause', 'configurationglpiauto')|e('js') }}", 'lunchEnd'],
      ].forEach(function (pair) {
        var col = document.createElement('div');
        col.className = 'col mb-2';
        var lbl = document.createElement('label');
        lbl.className = 'form-label';
        lbl.textContent = pair[0];
        var inp = document.createElement('input');
        inp.type = 'time';
        inp.className = 'form-control';
        inp.value = settings[pair[1]];
        inp.addEventListener('input', function (e) {
          settings[pair[1]] = e.target.value;
          writeBack();
        });
        col.appendChild(lbl);
        col.appendChild(inp);
        lunchRow.appendChild(col);
      });
      fieldsWrap.appendChild(lunchRow);

      lunchInput.addEventListener('change', function () {
        settings.lunchBreakEnabled = lunchInput.checked;
        lunchRow.style.display = lunchInput.checked ? '' : 'none';
        writeBack();
      });

      body.appendChild(fieldsWrap);

      enabledInput.addEventListener('change', function () {
        fieldsWrap.style.display = enabledInput.checked ? '' : 'none';
        writeBack();
      });

      card.appendChild(body);
      calendarPerClientPanels.appendChild(card);
    });
  }

  function updateCalendarMode() {
    var multiEntity = currentEntityMode() !== 'mono';
    calendarPerClientToggleWrap.style.display = multiEntity ? '' : 'none';
    if (!multiEntity && calendarPerClientToggle.checked) {
      calendarPerClientToggle.checked = false;
    }

    var perClient = multiEntity && calendarPerClientToggle.checked;
    calendarSharedSection.style.display = perClient ? 'none' : '';
    calendarPerClientPanels.style.display = perClient ? '' : 'none';

    if (perClient) {
      ensureClientSettings('calendar', { enabled: false, days: [1, 2, 3, 4, 5], begin: '08:00', end: '18:00' });
      renderCalendarPerClientPanels();
    } else {
      stripClientSettings('calendar');
    }
    syncTreeJson();
  }
  calendarPerClientToggle.addEventListener('change', updateCalendarMode);

