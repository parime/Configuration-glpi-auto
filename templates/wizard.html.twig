            {% endfor %}
          </div>
        </div>
      </div>

      {# ---------------------------------------------------------------- Étape 16 : Projets #}
      <div class="cga-wizard-step" data-step="16" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 16 : Projets', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Optionnel : des intitulés pour le module Projets, aucun n\'existe par défaut dans GLPI (hors les 3 statuts natifs, déjà suffisants — non modifiés dans l\'export de production audité).', 'configurationglpiauto') }}</p>

        <div class="form-check form-switch mb-2">
          <input type="hidden" name="project_taxonomy_enabled" value="0">
          <input type="checkbox" name="project_taxonomy_enabled" value="1" class="form-check-input" id="cga-project-taxonomy-enabled" {{ config.project_taxonomy_enabled|default(0) ? 'checked' : '' }}>
          <label class="form-check-label" for="cga-project-taxonomy-enabled">{{ __('Créer les types de projet et de tâche de projet', 'configurationglpiauto') }}</label>
        </div>
        <div id="cga-project-taxonomy-fields" style="display: none;" class="mb-3">
          <div class="form-check form-switch mb-2">
            <input type="hidden" name="project_taxonomy_icons_enabled" value="0">
            <input type="checkbox" name="project_taxonomy_icons_enabled" value="1" class="form-check-input" id="cga-project-taxonomy-icons-enabled" {{ config.project_taxonomy_icons_enabled|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="cga-project-taxonomy-icons-enabled">{{ __('Ajouter des icônes', 'configurationglpiauto') }}</label>
          </div>
          <div class="row">
            <div class="col-md-6">
              <strong>{{ __('Types de projet', 'configurationglpiauto') }}</strong>
              <ul class="mb-0">
                {% for type in project_taxonomy_preview.project_types %}
                  <li><span class="cga-project-taxonomy-icon" style="display: none;">{{ type.icon }}</span> {{ type.name }}</li>
                {% endfor %}
              </ul>
            </div>
            <div class="col-md-6">
              <strong>{{ __('Types de tâche de projet', 'configurationglpiauto') }}</strong>
              <ul class="mb-0">
                {% for type in project_taxonomy_preview.task_types %}
                  <li><span class="cga-project-taxonomy-icon" style="display: none;">{{ type.icon }}</span> {{ type.name }}</li>
                {% endfor %}
