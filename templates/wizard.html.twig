            <strong>{{ __('Général & Outils', 'configurationglpiauto') }} :</strong> <span id="cga-summary-general-tools"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Projets', 'configurationglpiauto') }} :</strong> <span id="cga-summary-projects"></span>
          </li>
        </ul>
      </div>

      <div class="mt-4 d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" id="cga-wizard-prev">{{ __('Précédent', 'configurationglpiauto') }}</button>
        <button type="button" class="btn btn-primary" id="cga-wizard-next">{{ __('Suivant', 'configurationglpiauto') }}</button>
        <button
          type="submit"
          name="finish"
          class="btn btn-primary"
          id="cga-wizard-finish"
          style="display: none;"
          onclick="return confirm('{{ __('Ceci va créer/modifier de vraies entités dans GLPI (et, si activés, un calendrier et une personnalisation graphique) selon les choix faits. Continuer ?', 'configurationglpiauto')|e('js') }}');"
        >
          <span id="cga-wizard-finish-label">{{ __('Terminer', 'configurationglpiauto') }}</span>
        </button>
      </div>
    </form>

  </div>
</div>

<script>
(function () {
  var STEP_COUNT = 18;
  var currentStep = 1;
  var steps = document.querySelectorAll('.cga-wizard-step');
  var progressBar = document.getElementById('cga-wizard-progress');
  var stepIndicator = document.getElementById('cga-wizard-stepindicator');
  var prevBtn = document.getElementById('cga-wizard-prev');
  var nextBtn = document.getElementById('cga-wizard-next');
  var finishBtn = document.getElementById('cga-wizard-finish');
  var finishLabel = document.getElementById('cga-wizard-finish-label');
  var wizardForm = document.getElementById('cga-wizard-form');

  // Le traitement serveur (~25 builders séquentiels) prend plusieurs secondes : sans garde, un
  // admin qui ne voit rien se passer peut cliquer une seconde fois. Le jeton CSRF est à usage
  // unique côté GLPI (Session::validateCSRF() le consomme dès sa première validation) — un second
  // clic renverrait donc le même jeton déjà consommé et se ferait rejeter par le pare-feu GLPI
  // (AccessDeniedHttpException brute, avant même que ce plugin ne s'exécute). Désactiver le bouton
  // dès le premier submit réel (après confirm()) empêche mécaniquement cette resoumission.
  //
  // setTimeout(..., 0) est indispensable ici, pas cosmétique : désactiver le bouton `finishBtn`
  // de façon synchrone DANS le handler `submit` empêche le navigateur d'inclure son couple
  // name=value ("finish") dans les données du formulaire envoyées — un bouton désactivé n'est
  // jamais soumis, même s'il l'était encore au moment du clic qui a déclenché l'événement `submit`.
  // Résultat observé sans ce délai : `isset($_POST['finish'])` est faux côté serveur, tout le bloc
  // de traitement du wizard est silencieusement ignoré, la page se re-rend comme si de rien
  // n'était — bug réel trouvé en testant l'escalade N1-N3 (aucune régression visible sans
  // désactiver les champs pour vérifier, puisque la page semble se recharger normalement).
  // `prevBtn`/`nextBtn` sont de simples `type="button"`, jamais soumis de toute façon : les
  // désactiver immédiatement ne pose pas ce problème.
  var expressFinishBtn = document.getElementById('cga-wizard-express-finish');
  var expressFinishLabel = document.getElementById('cga-wizard-express-finish-label');
  wizardForm.addEventListener('submit', function () {
    prevBtn.disabled = true;
    nextBtn.disabled = true;
    finishLabel.textContent = "{{ __('Création en cours...', 'configurationglpiauto')|e('js') }}";
    expressFinishLabel.textContent = "{{ __('Création en cours...', 'configurationglpiauto')|e('js') }}";
    // Same "defer only the submitter's own disabling by one tick" pattern as finishBtn below —
    // disabling either submit button synchronously inside this handler would exclude its
    // name=finish pair from the submitted data even though it was enabled at click time (a
    // disabled control is simply never included in form submission).
    setTimeout(function () {
      finishBtn.disabled = true;
      expressFinishBtn.disabled = true;
    }, 0);
  });

  var stepLabels = [
    "{{ __('Profil', 'configurationglpiauto')|e('js') }}",
    "{{ __('Entités', 'configurationglpiauto')|e('js') }}",
    "{{ __('Lieux', 'configurationglpiauto')|e('js') }}",
    "{{ __('Calendrier', 'configurationglpiauto')|e('js') }}",
    "{{ __('SLA', 'configurationglpiauto')|e('js') }}",
    "{{ __('Catégories', 'configurationglpiauto')|e('js') }}",
    "{{ __('Catalogue de services', 'configurationglpiauto')|e('js') }}",
    "{{ __('Statuts', 'configurationglpiauto')|e('js') }}",
    "{{ __('Raisons d\'attente', 'configurationglpiauto')|e('js') }}",
    "{{ __('Modèles de tickets', 'configurationglpiauto')|e('js') }}",
    "{{ __('Tâches & solutions', 'configurationglpiauto')|e('js') }}",
    "{{ __('Suivis & validations', 'configurationglpiauto')|e('js') }}",
    "{{ __('Droits LDAP', 'configurationglpiauto')|e('js') }}",
    "{{ __('Réglages généraux', 'configurationglpiauto')|e('js') }}",
    "{{ __('Général & Outils', 'configurationglpiauto')|e('js') }}",
    "{{ __('Projets', 'configurationglpiauto')|e('js') }}",
    "{{ __('Personnalisation', 'configurationglpiauto')|e('js') }}",
    "{{ __('Récapitulatif', 'configurationglpiauto')|e('js') }}"
  ];

  var DAYS = [
    { value: 1, label: "{{ __('Lundi')|e('js') }}" },
    { value: 2, label: "{{ __('Mardi')|e('js') }}" },
    { value: 3, label: "{{ __('Mercredi')|e('js') }}" },
    { value: 4, label: "{{ __('Jeudi')|e('js') }}" },
    { value: 5, label: "{{ __('Vendredi')|e('js') }}" },
    { value: 6, label: "{{ __('Samedi')|e('js') }}" },
    { value: 0, label: "{{ __('Dimanche')|e('js') }}" }
  ];
  var initialCalendarDays = {{ config.calendar_days|default('[1,2,3,4,5]')|raw }};
  var initialCalendarDayHours = {{ config.calendar_day_hours|default('{}')|raw }};
  var defaultCalendarBegin = "{{ config.calendar_begin|default('08:00')|e('js') }}";
  var defaultCalendarEnd = "{{ config.calendar_end|default('18:00')|e('js') }}";

  var PRIORITY_LEVELS = {{ priority_levels|json_encode|raw }};
  var PRIORITY_LABELS = {{ priority_labels|json_encode|raw }};

  var calendarEnabledInput = document.getElementById('cga-calendar-enabled');
  var calendarFields = document.getElementById('cga-calendar-fields');
  var calendarDaysContainer = document.getElementById('cga-calendar-days');

  // One row per day: checkbox + label, plus a begin/end time pair that only matters (and is
  // only visible) once that day is checked — lets a single day (e.g. Friday) carry different
  // hours than the rest without a separate "override" flag to manage.
  DAYS.forEach(function (day) {
    var dayHours = initialCalendarDayHours[String(day.value)] || initialCalendarDayHours[day.value];
    var begin = (dayHours && dayHours.begin) || defaultCalendarBegin;
    var end = (dayHours && dayHours.end) || defaultCalendarEnd;
    var checked = initialCalendarDays.indexOf(day.value) !== -1;

    var row = document.createElement('div');
    row.className = 'd-flex align-items-center gap-2 mb-1 flex-wrap';

    var wrapper = document.createElement('div');
    wrapper.className = 'form-check';
    wrapper.style.minWidth = '110px';
    var input = document.createElement('input');
    input.type = 'checkbox';
    input.name = 'calendar_day[]';
    input.value = day.value;
    input.className = 'form-check-input';
    input.id = 'cga-calendar-day-' + day.value;
    input.checked = checked;
    var label = document.createElement('label');
    label.className = 'form-check-label';
    label.setAttribute('for', input.id);
    label.textContent = day.label;
    wrapper.appendChild(input);
    wrapper.appendChild(label);
    row.appendChild(wrapper);

    var hoursWrap = document.createElement('div');
    hoursWrap.className = 'd-flex align-items-center gap-1';
    hoursWrap.style.display = checked ? '' : 'none';
    var beginInput = document.createElement('input');
    beginInput.type = 'time';
    beginInput.className = 'form-control form-control-sm';
    beginInput.style.width = '110px';
    beginInput.name = 'calendar_day_hours[' + day.value + '][begin]';
    beginInput.value = begin;
    var sep = document.createElement('span');
    sep.className = 'text-muted small';
    sep.textContent = '—';
    var endInput = document.createElement('input');
    endInput.type = 'time';
    endInput.className = 'form-control form-control-sm';
    endInput.style.width = '110px';
    endInput.name = 'calendar_day_hours[' + day.value + '][end]';
    endInput.value = end;
    hoursWrap.appendChild(beginInput);
    hoursWrap.appendChild(sep);
    hoursWrap.appendChild(endInput);
    row.appendChild(hoursWrap);

    input.addEventListener('change', function () {
      hoursWrap.style.display = input.checked ? '' : 'none';
    });

    calendarDaysContainer.appendChild(row);
  });

  var calendarLunchBreakInput = wireSimpleToggle('cga-calendar-lunch-break-enabled', 'cga-calendar-lunch-fields');

  function toggleCalendarFields() {
    calendarFields.style.display = calendarEnabledInput.checked ? '' : 'none';
  }
  calendarEnabledInput.addEventListener('change', toggleCalendarFields);
  toggleCalendarFields();

  var slaEnabledInput = document.getElementById('cga-sla-enabled');
  var slaFields = document.getElementById('cga-sla-fields');
  var slaAstreinteInput = document.getElementById('cga-sla-astreinte');
  function toggleSlaFields() {
    slaFields.style.display = slaEnabledInput.checked ? '' : 'none';
  }
  slaEnabledInput.addEventListener('change', toggleSlaFields);
  toggleSlaFields();

  var olaEnabledInput = document.getElementById('cga-ola-enabled');
  var olaFields = document.getElementById('cga-ola-fields');
  function toggleOlaFields() {
    olaFields.style.display = olaEnabledInput.checked ? '' : 'none';
  }
  olaEnabledInput.addEventListener('change', toggleOlaFields);
  toggleOlaFields();

  var slaEscalationEnabledInput = document.getElementById('cga-sla-escalation-enabled');
  var slaEscalationFields = document.getElementById('cga-sla-escalation-fields');
  function toggleSlaEscalationFields() {
    slaEscalationFields.style.display = slaEscalationEnabledInput.checked ? '' : 'none';
  }
  slaEscalationEnabledInput.addEventListener('change', toggleSlaEscalationFields);
  toggleSlaEscalationFields();

  var escalationEnabledInput = wireSimpleToggle('cga-escalation-enabled', 'cga-escalation-fields');
  wireIconsToggle('cga-support-tier-icons-enabled', '.cga-support-tier-icon');

  var categoryEnabledInput = document.getElementById('cga-category-enabled');
  var categoryFields = document.getElementById('cga-category-fields');
  var categoryIconsEnabledInput = document.getElementById('cga-category-icons-enabled');
  var categoryPreviewIcons = document.querySelectorAll('.cga-category-tree-icon');
  var categoryBranchToggles = document.querySelectorAll('.cga-category-branch-toggle');
  function toggleCategoryFields() {
    categoryFields.style.display = categoryEnabledInput.checked ? '' : 'none';
  }
  function toggleCategoryIcons() {
    categoryPreviewIcons.forEach(function (icon) {
      icon.style.display = categoryIconsEnabledInput.checked ? '' : 'none';
    });
  }
  function toggleCategoryBranchPreview(toggle) {
    var preview = document.querySelector('.cga-category-branch-preview[data-branch="' + toggle.dataset.branch + '"]');
    if (preview) {
      preview.style.display = toggle.checked ? '' : 'none';
    }
    var servicePreview = document.querySelector('.cga-service-branch-preview[data-branch="' + toggle.dataset.branch + '"]');
    if (servicePreview) {
      servicePreview.style.display = toggle.checked ? '' : 'none';
    }
    var kbPreview = document.querySelector('.cga-kb-branch-preview[data-branch="' + toggle.dataset.branch + '"]');
    if (kbPreview) {
      kbPreview.style.display = toggle.checked ? '' : 'none';
    }
  }
  categoryEnabledInput.addEventListener('change', toggleCategoryFields);
  categoryIconsEnabledInput.addEventListener('change', toggleCategoryIcons);
  categoryBranchToggles.forEach(function (toggle) {
    toggle.addEventListener('change', function () { toggleCategoryBranchPreview(toggle); });
    toggleCategoryBranchPreview(toggle);
  });
  toggleCategoryFields();
  toggleCategoryIcons();

  // "Profils métier" quick-picker (Sprint 35) — pure client-side convenience over two fields that
  // already exist (category_branches, sla_tiers), no new config field: picks the right branches
  // and, unlike the IT-sourced baseline (Config::DEFAULT_SLA_TIERS), a plausible-but-invented SLA
  // pace for verticals with no equivalent sourced ITIL practice — physical/administrative work
  // simply can't be dispatched and resolved as fast as a software fix, so Bâtiment/RH scale the IT
  // baseline by a flat ×2/×4 rather than pretending to independently-researched numbers. Always
  // just a starting point, same as every other preset in this wizard — every field it touches
  // stays editable on the very same screen right after clicking.
  var BUSINESS_PROFILES = {
    it: {
      branches: ['it'],
      sla_tiers: { 6: { tto_hours: 1, ttr_hours: 4 }, 5: { tto_hours: 2, ttr_hours: 8 }, 4: { tto_hours: 4, ttr_hours: 24 }, 3: { tto_hours: 8, ttr_hours: 48 }, 2: { tto_hours: 24, ttr_hours: 72 }, 1: { tto_hours: 48, ttr_hours: 120 } },
    },
    rh: {
      branches: ['rh', 'administratif'],
      sla_tiers: { 6: { tto_hours: 4, ttr_hours: 16 }, 5: { tto_hours: 8, ttr_hours: 32 }, 4: { tto_hours: 16, ttr_hours: 96 }, 3: { tto_hours: 32, ttr_hours: 192 }, 2: { tto_hours: 96, ttr_hours: 288 }, 1: { tto_hours: 192, ttr_hours: 480 } },
    },
    batiment: {
      branches: ['batiment', 'services_generaux', 'maintenance'],
      sla_tiers: { 6: { tto_hours: 2, ttr_hours: 8 }, 5: { tto_hours: 4, ttr_hours: 16 }, 4: { tto_hours: 8, ttr_hours: 48 }, 3: { tto_hours: 16, ttr_hours: 96 }, 2: { tto_hours: 48, ttr_hours: 144 }, 1: { tto_hours: 96, ttr_hours: 240 } },
    },
    generaliste: {
      // All branches — read from the DOM rather than a second hardcoded key list, so this never
      // drifts out of sync with CategoryBuilder::CATEGORIES (the twig loop above is already the
      // single source of truth for what branches exist).
      branches: Array.from(categoryBranchToggles).map(function (toggle) { return toggle.dataset.branch; }),
      sla_tiers: null,
    },
  };
  document.querySelectorAll('.cga-business-profile-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var profile = BUSINESS_PROFILES[btn.dataset.businessProfile];
      if (!profile) {
        return;
      }
      categoryBranchToggles.forEach(function (toggle) {
        toggle.checked = profile.branches.indexOf(toggle.dataset.branch) !== -1;
        toggle.dispatchEvent(new Event('change', { bubbles: true }));
      });
      if (!categoryEnabledInput.checked) {
        categoryEnabledInput.checked = true;
        categoryEnabledInput.dispatchEvent(new Event('change', { bubbles: true }));
      }
      if (profile.sla_tiers) {
        if (!slaEnabledInput.checked) {
          slaEnabledInput.checked = true;
          slaEnabledInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
        applyTierDefaults('sla_tiers', profile.sla_tiers);
      }
    });
  });

  var serviceCatalogEnabledInput = document.getElementById('cga-service-catalog-enabled');
  var serviceCatalogFields = document.getElementById('cga-service-catalog-fields');
  function toggleServiceCatalogFields() {
    serviceCatalogFields.style.display = serviceCatalogEnabledInput.checked ? '' : 'none';
  }
  serviceCatalogEnabledInput.addEventListener('change', toggleServiceCatalogFields);
  toggleServiceCatalogFields();

  var stateEnabledInput = document.getElementById('cga-state-enabled');
  var stateFields = document.getElementById('cga-state-fields');
  var stateIconsEnabledInput = document.getElementById('cga-state-icons-enabled');
  var statePreviewIcons = document.querySelectorAll('.cga-state-preview-icon');
  function toggleStateFields() {
    stateFields.style.display = stateEnabledInput.checked ? '' : 'none';
  }
  function toggleStateIcons() {
    statePreviewIcons.forEach(function (icon) {
      icon.style.display = stateIconsEnabledInput.checked ? '' : 'none';
    });
  }
  stateEnabledInput.addEventListener('change', toggleStateFields);
  stateIconsEnabledInput.addEventListener('change', toggleStateIcons);
  toggleStateFields();
  toggleStateIcons();

  var waitReasonsEnabledInput = document.getElementById('cga-wait-reasons-enabled');
  var waitReasonsFields = document.getElementById('cga-wait-reasons-fields');
  function toggleWaitReasonsFields() {
    waitReasonsFields.style.display = waitReasonsEnabledInput.checked ? '' : 'none';
  }
  waitReasonsEnabledInput.addEventListener('change', toggleWaitReasonsFields);
  wireIconsToggle('cga-wait-reason-icons-enabled', '.cga-wait-reason-icon');
  toggleWaitReasonsFields();

  var brandingEnabledInput = document.getElementById('cga-branding-enabled');
  var brandingFields = document.getElementById('cga-branding-fields');
  var brandingColorInput = document.getElementById('cga-branding-color');
  var brandingPreviewHeader = document.getElementById('cga-branding-preview-header');
  var brandingPreviewBtn = document.getElementById('cga-branding-preview-btn');
  var brandingPreviewLogo = document.getElementById('cga-branding-preview-logo');
  var brandingPreviewCaption = document.getElementById('cga-branding-preview-caption');

  var customPaletteWrap = document.getElementById('cga-custom-palette-wrap');
  function toggleBrandingFields() {
    brandingFields.style.display = brandingEnabledInput.checked ? 'flex' : 'none';
    customPaletteWrap.style.display = brandingEnabledInput.checked ? '' : 'none';
  }
  // Mini simulation de l'en-tête GLPI (.glpi-logo, --tblr-primary) — met à jour la couleur en
  // direct depuis le sélecteur, sans attendre la soumission du formulaire.
  function updatePreview() {
    brandingPreviewHeader.style.backgroundColor = brandingColorInput.value;
    brandingPreviewBtn.style.backgroundColor = '#fff';
    brandingPreviewBtn.style.color = brandingColorInput.value;
    brandingPreviewBtn.style.border = 'none';
  }
  brandingEnabledInput.addEventListener('change', toggleBrandingFields);
  brandingColorInput.addEventListener('input', updatePreview);

  // Custom palette (color-derived) and native palette (pick one of GLPI's 18 built-in themes) are
  // two different answers to the same "what's the default palette" question — mutually exclusive
  // in the UI so it's clear only one wins (PaletteBuilder itself also has custom win if both were
  // somehow submitted, but the UI shouldn't let that ambiguity arise in the first place).
  var customPaletteEnabledInput = document.getElementById('cga-custom-palette-enabled');
  var nativePaletteSelect = document.getElementById('cga-native-palette');
  customPaletteEnabledInput.addEventListener('change', function () {
    if (customPaletteEnabledInput.checked) {
      nativePaletteSelect.value = '';
    }
  });
  nativePaletteSelect.addEventListener('change', function () {
    if (nativePaletteSelect.value !== '') {
      customPaletteEnabledInput.checked = false;
    }
  });
  toggleBrandingFields();
  updatePreview();

  var entityLogosEnabledInput = document.getElementById('cga-entity-logos-enabled');
  var entityLogosFields = document.getElementById('cga-entity-logos-fields');
  var entityLogosPanels = document.getElementById('cga-entity-logos-panels');
  function toggleEntityLogosFields() {
    entityLogosFields.style.display = entityLogosEnabledInput.checked ? '' : 'none';
  }
  entityLogosEnabledInput.addEventListener('change', toggleEntityLogosFields);
  toggleEntityLogosFields();

  // One file input per top-level entity (or a single one for mono-entité/empty tree, matching
  // entities_id=0 fallback) — named by index, matching how front/wizard.php pairs
  // EntityBuilder::topEntityIds() (same order as this array) with $_FILES['entity_logo_N'].
  // Re-rendered whenever the branding step is shown so it always reflects the current tree; a
  // previously-chosen file is lost on re-render (native <input type="file"> can't be repopulated
  // programmatically anyway, same limitation any tree edit would cause).
  var brandingPerClientEnabledInput = document.getElementById('cga-branding-per-client-enabled');
  var brandingPerClientFields = document.getElementById('cga-branding-per-client-fields');
  var brandingPerClientPanels = document.getElementById('cga-branding-per-client-panels');
  function toggleBrandingPerClientFields() {
    brandingPerClientFields.style.display = brandingPerClientEnabledInput.checked ? '' : 'none';
  }
  brandingPerClientEnabledInput.addEventListener('change', toggleBrandingPerClientFields);
  toggleBrandingPerClientFields();

  // Unlike renderEntityLogoPanels() (native <input type="file"> can't survive a re-render), a
  // color input's value survives fine — only render once so re-entering step 9 doesn't wipe edits
  // already made, and only rebuild if the tree's node count actually changed (client added/removed
  // in step 2 since the panels were last built).
  function renderBrandingPerClientPanels() {
    var tree = (window.cgaTree || []);
    var nodes = tree.length ? tree : [{ name: "{{ __('Entité racine', 'configurationglpiauto')|e('js') }}" }];
    if (brandingPerClientPanels.children.length === nodes.length) {
      return;
    }
    brandingPerClientPanels.innerHTML = '';
    nodes.forEach(function (node, i) {
      var wrapper = document.createElement('div');
      var label = document.createElement('label');
      label.className = 'form-label mb-1 d-block';
      label.textContent = node.name || "{{ __('(sans nom)', 'configurationglpiauto')|e('js') }}";
      var input = document.createElement('input');
      input.type = 'color';
      input.name = 'entity_color_' + i;
      input.className = 'form-control form-control-color';
      input.value = brandingColorInput.value;
      wrapper.appendChild(label);
      wrapper.appendChild(input);
      brandingPerClientPanels.appendChild(wrapper);
    });
  }

  function renderEntityLogoPanels() {
    var tree = (window.cgaTree || []);
    var nodes = tree.length ? tree : [{ name: "{{ __('Entité racine', 'configurationglpiauto')|e('js') }}" }];
    entityLogosPanels.innerHTML = '';
    nodes.forEach(function (node, i) {
      var wrapper = document.createElement('div');
      wrapper.className = 'mb-2';
      var label = document.createElement('label');
      label.className = 'form-label mb-1';
      label.textContent = node.name || "{{ __('(sans nom)', 'configurationglpiauto')|e('js') }}";
      var input = document.createElement('input');
      input.type = 'file';
      input.name = 'entity_logo_' + i;
      input.accept = 'image/png,image/jpeg,image/webp,image/gif';
      input.className = 'form-control form-control-sm';
      // Aperçu instantané côté client (FileReader), indépendant de la conversion en data URI
      // faite côté serveur à la soumission (front/wizard.php) — juste pour visualiser le choix
      // avant d'envoyer le formulaire.
      input.addEventListener('change', function () {
        var file = input.files && input.files[0];
        if (!file) {
          return;
        }
        var reader = new FileReader();
        reader.onload = function () {
          brandingPreviewLogo.style.backgroundImage = 'url(' + reader.result + ')';
          brandingPreviewCaption.textContent = "{{ __('Aperçu :', 'configurationglpiauto')|e('js') }} " + (node.name || "{{ __('(sans nom)', 'configurationglpiauto')|e('js') }}");
        };
        reader.readAsDataURL(file);
      });
      wrapper.appendChild(label);
      wrapper.appendChild(input);
      entityLogosPanels.appendChild(wrapper);
    });
  }

  // Server-side proxy (ajax/geocode.php) — never called with a client-chosen host, see that
  // file's own docblock. Debounced client-side here as the other half of the same rate-limit
  // discipline (the free public Nominatim instance used by default tolerates ~1 req/s).
  var CGA_GEOCODE_URL = "{{ config('root_doc') }}/plugins/configurationglpiauto/ajax/geocode.php";
  var locationsTreeRoot = document.getElementById('cga-locations-tree');

  function cgaDebounce(fn, delayMs) {
    var timer = null;
    return function () {
      var args = arguments;
      clearTimeout(timer);
      timer = setTimeout(function () { fn.apply(null, args); }, delayMs);
    };
  }

  function cgaMakeInput(name, placeholder, extraClass) {
    var input = document.createElement('input');
    input.type = 'text';
    input.name = name;
    input.className = 'form-control form-control-sm' + (extraClass ? ' ' + extraClass : '');
    input.placeholder = placeholder;
    return input;
  }

  // Every user-fillable native glpi_locations column, not just address/postcode/town/country —
  // same "tout sans exception" standard already applied to translations this session. Nominatim
  // can suggest address/postcode/town/state/country/latitude/longitude; code/alias/comment/
  // building/room/altitude are always manual (no geocoding service returns elevation), same as on
  // GLPI's own native Location form.
  //
  // Builds the full field set for one tree node, named by its own path (`location_address_1-0`
  // etc.) — matches LocationBuilder::buildNode()'s own path computation exactly, so
  // front/wizard.php's collectLocationDataFromPost() always lines each field up with the right
  // node regardless of tree depth.
  function buildLocationFieldsPanel(path) {
    var panel = document.createElement('div');
    panel.className = 'card card-body p-2 mb-2';
    panel.style.maxWidth = '640px';

    var addressGroup = document.createElement('div');
    addressGroup.className = 'position-relative mb-1';
    var addressInput = cgaMakeInput('location_address_' + path, "{{ __('Rue, numéro...', 'configurationglpiauto')|e('js') }}");
    addressInput.autocomplete = 'off';
    // `dropdown-menu` (Bootstrap/Tabler component) rather than `list-group`: comes with its own
    // opaque, theme-aware background/border/shadow built in — a plain `list-group` here rendered
    // see-through over the fields/toggles underneath it (confirmed from a real screenshot), since
    // nothing gave the floating list itself a solid background.
    var suggestions = document.createElement('ul');
    suggestions.className = 'dropdown-menu position-absolute w-100';
    suggestions.style.zIndex = '20';
    suggestions.style.display = 'none';
    suggestions.style.maxHeight = '220px';
    suggestions.style.overflowY = 'auto';
    addressGroup.appendChild(addressInput);
    addressGroup.appendChild(suggestions);
    panel.appendChild(addressGroup);

    var row1 = document.createElement('div');
    row1.className = 'd-flex gap-1 mb-1';
    var postcodeInput = cgaMakeInput('location_postcode_' + path, "{{ __('Code postal', 'configurationglpiauto')|e('js') }}");
    postcodeInput.style.maxWidth = '120px';
    var townInput = cgaMakeInput('location_town_' + path, "{{ __('Ville', 'configurationglpiauto')|e('js') }}");
    var stateInput = cgaMakeInput('location_state_' + path, "{{ __('Région / État', 'configurationglpiauto')|e('js') }}");
    var countryInput = cgaMakeInput('location_country_' + path, "{{ __('Pays', 'configurationglpiauto')|e('js') }}");
    row1.appendChild(postcodeInput);
    row1.appendChild(townInput);
    row1.appendChild(stateInput);
    row1.appendChild(countryInput);
    panel.appendChild(row1);

    var row2 = document.createElement('div');
    row2.className = 'd-flex gap-1 mb-1';
    var buildingInput = cgaMakeInput('location_building_' + path, "{{ __('Bâtiment', 'configurationglpiauto')|e('js') }}");
    var roomInput = cgaMakeInput('location_room_' + path, "{{ __('Pièce', 'configurationglpiauto')|e('js') }}");
    var codeInput = cgaMakeInput('location_code_' + path, "{{ __('Code', 'configurationglpiauto')|e('js') }}");
    var aliasInput = cgaMakeInput('location_alias_' + path, "{{ __('Alias', 'configurationglpiauto')|e('js') }}");
    row2.appendChild(buildingInput);
    row2.appendChild(roomInput);
    row2.appendChild(codeInput);
    row2.appendChild(aliasInput);
    panel.appendChild(row2);

    var commentInput = document.createElement('textarea');
    commentInput.name = 'location_comment_' + path;
    commentInput.className = 'form-control form-control-sm mb-1';
    commentInput.rows = 2;
    commentInput.placeholder = "{{ __('Commentaire', 'configurationglpiauto')|e('js') }}";
    panel.appendChild(commentInput);

    // Coordonnées GPS (glpi_locations.latitude/longitude/altitude, jamais renseignées ailleurs
    // dans le plugin) : latitude/longitude remplies automatiquement depuis Nominatim, altitude
    // toujours manuelle (aucun service de géocodage ne la fournit) — les trois éditables à la main
    // dans tous les cas (un admin peut coller des coordonnées récupérées ailleurs).
    var gpsRow = document.createElement('div');
    gpsRow.className = 'd-flex gap-1';
    var latInput = cgaMakeInput('location_latitude_' + path, "{{ __('Latitude', 'configurationglpiauto')|e('js') }}");
    var lonInput = cgaMakeInput('location_longitude_' + path, "{{ __('Longitude', 'configurationglpiauto')|e('js') }}");
    var altInput = cgaMakeInput('location_altitude_' + path, "{{ __('Altitude', 'configurationglpiauto')|e('js') }}");
    gpsRow.appendChild(latInput);
    gpsRow.appendChild(lonInput);
    gpsRow.appendChild(altInput);
    panel.appendChild(gpsRow);

    // Champs propres à la fiche entité (glpi_entities), sans équivalent sur Location — visibles
    // seulement si "Compléter aussi la fiche adresse native de chaque entité" est coché ; l'adresse
    // elle-même (rue/ville/état/pays/GPS ci-dessus) est réutilisée telle quelle côté serveur,
    // jamais retapée ici.
    var entityCommsRow = document.createElement('div');
    entityCommsRow.className = 'd-flex gap-1 flex-wrap mt-1 cga-entity-comms-fields';
    entityCommsRow.style.display = entityNativeAddressEnabledInput.checked ? '' : 'none';
    var phoneInput = cgaMakeInput('entity_comms_phonenumber_' + path, "{{ __('Téléphone', 'configurationglpiauto')|e('js') }}");
    var faxInput = cgaMakeInput('entity_comms_fax_' + path, "{{ __('Fax', 'configurationglpiauto')|e('js') }}");
    var websiteInput = cgaMakeInput('entity_comms_website_' + path, "{{ __('Site web', 'configurationglpiauto')|e('js') }}");
    var emailInput = cgaMakeInput('entity_comms_email_' + path, "{{ __('E-mail', 'configurationglpiauto')|e('js') }}");
    entityCommsRow.appendChild(phoneInput);
    entityCommsRow.appendChild(faxInput);
    entityCommsRow.appendChild(websiteInput);
    entityCommsRow.appendChild(emailInput);
    panel.appendChild(entityCommsRow);

    function clearSuggestions() {
      suggestions.innerHTML = '';
      suggestions.style.display = 'none';
    }

    function fillFromSuggestion(item) {
      addressInput.value = item.address || addressInput.value;
      if (item.postcode) { postcodeInput.value = item.postcode; }
      if (item.town) { townInput.value = item.town; }
      if (item.state) { stateInput.value = item.state; }
      if (item.country) { countryInput.value = item.country; }
      // Toujours écrasées (contrairement à ville/état/pays plus bas) : choisir une suggestion est
      // un geste explicite et précis, contrairement au remplissage code postal → ville plus large.
      if (item.latitude) { latInput.value = item.latitude; }
      if (item.longitude) { lonInput.value = item.longitude; }
      clearSuggestions();
    }

    var fetchAddressSuggestions = cgaDebounce(function (query) {
      // Sans ça, une recherche comme "avenue" seule remonte des résultats partout en France — en
      // repassant la ville/pays déjà saisis (s'ils le sont), ajax/geocode.php restreint la
      // recherche Nominatim à cette zone au lieu de chercher "avenue" sur tout le pays.
      var townHint = townInput.value.trim();
      var countryHint = countryInput.value.trim();
      var addressUrl = CGA_GEOCODE_URL + '?q=' + encodeURIComponent(query)
        + (townHint !== '' ? '&town=' + encodeURIComponent(townHint) : '')
        + (countryHint !== '' ? '&country=' + encodeURIComponent(countryHint) : '');
      fetch(addressUrl)
        .then(function (res) { return res.ok ? res.json() : []; })
        .then(function (results) {
          clearSuggestions();
          if (!Array.isArray(results) || results.length === 0) {
            return;
          }
          results.forEach(function (item) {
            var li = document.createElement('li');
            var button = document.createElement('button');
            button.type = 'button';
            button.className = 'dropdown-item small text-wrap';
            button.textContent = item.label;
            button.addEventListener('click', function () { fillFromSuggestion(item); });
            li.appendChild(button);
            suggestions.appendChild(li);
          });
          // `.dropdown-menu` (Bootstrap/Tabler) is `display: none` by its own CSS rule, only ever
          // shown via a `.show` class Bootstrap's own JS toggles — since that JS component isn't
          // wired up here, an empty inline style falls back to that CSS rule and stays hidden.
          // `'block'` overrides it directly instead.
          suggestions.style.display = 'block';
        })
        .catch(function () { clearSuggestions(); });
    }, 400);

    addressInput.addEventListener('input', function () {
      if (!locationGeocodingEnabledInput.checked) {
        return;
      }
      var query = addressInput.value.trim();
      if (query.length < 3) {
        clearSuggestions();
        return;
      }
      fetchAddressSuggestions(query);
    });
    document.addEventListener('click', function (evt) {
      if (evt.target !== addressInput) {
        clearSuggestions();
      }
    });

    // Code postal → ville : déclenché à la sortie du champ (pas à chaque frappe, un code postal
    // n'a de sens qu'une fois complet), ne remplit la ville/état que s'ils sont encore vides pour
    // ne jamais écraser une correction déjà faite à la main.
    postcodeInput.addEventListener('blur', function () {
      if (!locationGeocodingEnabledInput.checked) {
        return;
      }
      var postcode = postcodeInput.value.trim();
      if (postcode.length < 3 || townInput.value.trim() !== '') {
        return;
      }
      // Passe le pays déjà saisi (sinon ajax/geocode.php retombe sur son défaut) — un code postal
      // seul est ambigu à l'échelle mondiale (69001 existe aussi bien à Lyon qu'en Ukraine), et ce
      // résultat écrase la ville sans relecture possible par l'admin.
      var countryHint = countryInput.value.trim();
      var postcodeUrl = CGA_GEOCODE_URL + '?postcode=' + encodeURIComponent(postcode)
        + (countryHint !== '' ? '&country=' + encodeURIComponent(countryHint) : '');
      fetch(postcodeUrl)
        .then(function (res) { return res.ok ? res.json() : []; })
        .then(function (results) {
          if (Array.isArray(results) && results.length > 0 && results[0].town) {
            townInput.value = results[0].town;
            if (results[0].state && stateInput.value.trim() === '') { stateInput.value = results[0].state; }
            if (results[0].country && countryInput.value.trim() === '') { countryInput.value = results[0].country; }
            // Centroïde du code postal, moins précis qu'une suggestion de rue choisie
            // explicitement — ne remplit que si rien n'a déjà été saisi.
            if (results[0].latitude && latInput.value.trim() === '') { latInput.value = results[0].latitude; }
            if (results[0].longitude && lonInput.value.trim() === '') { lonInput.value = results[0].longitude; }
          }
        })
        .catch(function () {});
    });

    // Lieux enfants (bâtiment, étage, salle...) : glpi_locations a son propre arbre indépendant
    // (locations_id auto-référencé), sans rapport avec l'arborescence d'entités — un même site
    // peut avoir plusieurs niveaux imbriqués qui n'ont pas leur propre entité. Éditeur récursif
    // identique à celui de l'étape 2 (_entity_structure_fields.html.twig : add/remove par nœud,
    // arbre sérialisé en JSON plutôt que des champs plats dont la forme serait connue à l'avance)
    // — réutilise directement ses classes CSS (.cga-tree/.cga-node-children/.cga-node-row),
    // globales sur la page puisque ce partial est déjà inclus pour l'étape Entités.
    var childrenState = [];
    var childrenJsonInput = document.createElement('input');
    childrenJsonInput.type = 'hidden';
    childrenJsonInput.name = 'location_children_' + path;
    childrenJsonInput.value = '[]';
    panel.appendChild(childrenJsonInput);

    var childrenSection = document.createElement('div');
    childrenSection.className = 'mt-2 ps-2 border-start border-2';
    var childrenLabel = document.createElement('div');
    childrenLabel.className = 'form-label small fw-bold mb-1';
    childrenLabel.textContent = "{{ __('Lieux enfants (bâtiment, étage, salle...)', 'configurationglpiauto')|e('js') }}";
    var childrenEditor = document.createElement('div');
    childrenEditor.className = 'cga-tree';
    var addChildBtn = document.createElement('button');
    addChildBtn.type = 'button';
    addChildBtn.className = 'btn btn-outline-secondary btn-sm mt-1';
    addChildBtn.innerHTML = '<i class="ti ti-plus"></i> ' + "{{ __('Ajouter un lieu enfant', 'configurationglpiauto')|e('js') }}";
    childrenSection.appendChild(childrenLabel);
    childrenSection.appendChild(childrenEditor);
    childrenSection.appendChild(addChildBtn);
    panel.appendChild(childrenSection);

    function syncChildrenJson() {
      childrenJsonInput.value = JSON.stringify(childrenState);
    }

    function renderChildNode(node, parentArray, container) {
      var wrapper = document.createElement('div');
      wrapper.className = 'cga-node-children';

      var row = document.createElement('div');
      row.className = 'cga-node-row';
      var nameInput = document.createElement('input');
      nameInput.type = 'text';
      nameInput.className = 'form-control form-control-sm';
      nameInput.value = node.name;
      nameInput.placeholder = "{{ __('Nom du lieu enfant (ex. Bâtiment A)', 'configurationglpiauto')|e('js') }}";
      nameInput.addEventListener('input', function () {
        node.name = nameInput.value;
        syncChildrenJson();
      });
      row.appendChild(nameInput);

      var addSubBtn = document.createElement('button');
      addSubBtn.type = 'button';
      addSubBtn.className = 'btn btn-outline-secondary btn-sm';
      addSubBtn.title = "{{ __('Ajouter un lieu enfant', 'configurationglpiauto')|e('js') }}";
      addSubBtn.innerHTML = '<i class="ti ti-plus"></i>';
      addSubBtn.addEventListener('click', function () {
        node.children.push({ name: '', fields: {}, children: [] });
        renderChildrenEditor();
      });
      row.appendChild(addSubBtn);

      var removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'btn btn-outline-danger btn-sm';
      removeBtn.title = "{{ __('Retirer', 'configurationglpiauto')|e('js') }}";
      removeBtn.innerHTML = '<i class="ti ti-x"></i>';
      removeBtn.addEventListener('click', function () {
        var idx = parentArray.indexOf(node);
        if (idx !== -1) {
          parentArray.splice(idx, 1);
        }
        renderChildrenEditor();
      });
      row.appendChild(removeBtn);
      wrapper.appendChild(row);

      // Champs complets (adresse, code, alias...) sur ce lieu enfant lui-même — mêmes champs que
      // le lieu de l'entité, mais liés à l'objet `node.fields` de cet arbre plutôt qu'à des
      // inputs nommés statiquement, puisque ce nœud n'existait pas avant que l'admin l'ajoute.
      var subFieldsRow = document.createElement('div');
      subFieldsRow.className = 'd-flex gap-1 flex-wrap mb-1';
      ['address', 'postcode', 'town', 'state', 'country'].forEach(function (field) {
        var input = document.createElement('input');
        input.type = 'text';
        input.className = 'form-control form-control-sm';
        input.style.maxWidth = '160px';
        input.placeholder = fieldPlaceholders[field];
        input.value = node.fields[field] || '';
        input.addEventListener('input', function () {
          if (input.value.trim() === '') {
            delete node.fields[field];
          } else {
            node.fields[field] = input.value;
          }
          syncChildrenJson();
        });
        subFieldsRow.appendChild(input);
      });
      wrapper.appendChild(subFieldsRow);

      node.children.forEach(function (child) {
        renderChildNode(child, node.children, wrapper);
      });

      container.appendChild(wrapper);
    }

    var fieldPlaceholders = {
      address: "{{ __('Rue, numéro...', 'configurationglpiauto')|e('js') }}",
      postcode: "{{ __('Code postal', 'configurationglpiauto')|e('js') }}",
      town: "{{ __('Ville', 'configurationglpiauto')|e('js') }}",
      state: "{{ __('Région / État', 'configurationglpiauto')|e('js') }}",
      country: "{{ __('Pays', 'configurationglpiauto')|e('js') }}",
    };

    function renderChildrenEditor() {
      childrenEditor.innerHTML = '';
      childrenState.forEach(function (node) {
        renderChildNode(node, childrenState, childrenEditor);
      });
      syncChildrenJson();
    }

    addChildBtn.addEventListener('click', function () {
      childrenState.push({ name: '', fields: {}, children: [] });
      renderChildrenEditor();
    });

    return panel;
  }

  function cgaCountTreeNodes(nodes) {
    var count = 0;
    (nodes || []).forEach(function (node) {
      count += 1 + cgaCountTreeNodes(node.children || []);
    });
    return count;
  }

  // Un nœud sans adresse ni aucun autre champ rempli ne devient pas un Lieu du tout côté serveur
  // (LocationBuilder) — le panneau de champs reste donc replié par défaut sur chaque nœud plutôt
  // que déployé partout, pour ne pas donner l'impression qu'un Lieu vide sera créé.
  function buildLocationNode(node, path, depth) {
    var nodeName = node.name || "{{ __('(sans nom)', 'configurationglpiauto')|e('js') }}";

    var container = document.createElement('div');
    container.className = 'mb-1';
    container.style.marginLeft = (depth * 20) + 'px';

    var header = document.createElement('div');
    header.className = 'd-flex align-items-center gap-2 mb-1';
    var nameLabel = document.createElement('span');
    nameLabel.textContent = (depth > 0 ? '↳ ' : '') + nodeName;
    if (depth === 0) {
      nameLabel.className = 'fw-bold';
    }
    var toggleBtn = document.createElement('button');
    toggleBtn.type = 'button';
    toggleBtn.className = 'btn btn-sm btn-outline-secondary';
    var addLabel = "{{ __('+ Ajouter une adresse', 'configurationglpiauto')|e('js') }}";
    var collapseLabel = "{{ __('Réduire', 'configurationglpiauto')|e('js') }}";
    toggleBtn.textContent = addLabel;
    header.appendChild(nameLabel);
    header.appendChild(toggleBtn);
    container.appendChild(header);

    var fieldsPanel = buildLocationFieldsPanel(path);
    fieldsPanel.style.display = 'none';
    container.appendChild(fieldsPanel);

    var expanded = false;
    toggleBtn.addEventListener('click', function () {
      expanded = !expanded;
      fieldsPanel.style.display = expanded ? '' : 'none';
      toggleBtn.textContent = expanded ? collapseLabel : addLabel;
    });

    (node.children || []).forEach(function (child, i) {
      container.appendChild(buildLocationNode(child, path + '-' + i, depth + 1));
    });

    return container;
  }

  // Rebuilt only when the tree's total node count (all depths) actually changed, so revisiting
  // this step doesn't collapse panels or wipe fields already typed deeper in the tree.
  function renderLocationsTree() {
    var tree = (window.cgaTree || []);
    var nodes = tree.length ? tree : [{ name: "{{ __('Entité racine', 'configurationglpiauto')|e('js') }}", children: [] }];
    var totalNodes = cgaCountTreeNodes(nodes);
    if (locationsTreeRoot.dataset.nodeCount == totalNodes) {
      return;
    }
    locationsTreeRoot.dataset.nodeCount = String(totalNodes);
    locationsTreeRoot.innerHTML = '';
    nodes.forEach(function (node, i) {
      locationsTreeRoot.appendChild(buildLocationNode(node, String(i), 0));
    });
  }

  var generalSettingsGroupInputs = document.querySelectorAll('.cga-general-settings-group');
  var generalSettingsSelectAll = document.getElementById('cga-general-settings-select-all');
  function syncGeneralSettingsSelectAll() {
    var checkedCount = 0;
    generalSettingsGroupInputs.forEach(function (input) { if (input.checked) { checkedCount++; } });
    generalSettingsSelectAll.checked = checkedCount === generalSettingsGroupInputs.length;
    generalSettingsSelectAll.indeterminate = checkedCount > 0 && checkedCount < generalSettingsGroupInputs.length;
  }
  generalSettingsGroupInputs.forEach(function (input) {
    input.addEventListener('change', syncGeneralSettingsSelectAll);
  });
  generalSettingsSelectAll.addEventListener('change', function () {
    generalSettingsGroupInputs.forEach(function (input) { input.checked = generalSettingsSelectAll.checked; });
    generalSettingsSelectAll.indeterminate = false;
  });
  syncGeneralSettingsSelectAll();

  var ticketTemplateEnabledInput = document.getElementById('cga-ticket-template-enabled');
  var ticketTemplateFields = document.getElementById('cga-ticket-template-fields');
  var helpdeskFormHideFieldsInput = document.getElementById('cga-helpdesk-form-hide-fields');
  function toggleTicketTemplateFields() {
    ticketTemplateFields.style.display = ticketTemplateEnabledInput.checked ? '' : 'none';
  }
  ticketTemplateEnabledInput.addEventListener('change', toggleTicketTemplateFields);
  wireIconsToggle('cga-ticket-template-icons-enabled', '.cga-ticket-template-icon');
  toggleTicketTemplateFields();

  var ldapRightsEnabledInput = document.getElementById('cga-ldap-rights-enabled');
  var ldapRightsFields = document.getElementById('cga-ldap-rights-fields');
  var ldapRightsTemplateInput = document.getElementById('cga-ldap-rights-template');
  var ldapRightsProfileInput = document.getElementById('cga-ldap-rights-profile');
  var ldapRightsPreviewList = document.getElementById('cga-ldap-rights-preview');
  function toggleLdapRightsFields() {
    ldapRightsFields.style.display = ldapRightsEnabledInput.checked ? '' : 'none';
  }
  function collectLeafEntityNames(nodes) {
    var names = [];
    (nodes || []).forEach(function (node) {
      if (!node.name) { return; }
      if (node.children && node.children.length) {
        names = names.concat(collectLeafEntityNames(node.children));
      } else {
        names.push(node.name);
      }
    });
    return names;
  }
  function updateLdapRightsPreview() {
    var template = ldapRightsTemplateInput.value || 'GLPI_{ENTITY}';
    var leaves = collectLeafEntityNames(window.cgaTree || []);
    ldapRightsPreviewList.innerHTML = '';
    if (template.indexOf('{ENTITY}') === -1 || leaves.length === 0) {
      var empty = document.createElement('li');
      empty.className = 'list-group-item text-muted';
      empty.textContent = leaves.length === 0
        ? "{{ __('Aucun site dans l\'arborescence (étape 2) — rien à générer.', 'configurationglpiauto')|e('js') }}"
        : "{{ __('Le gabarit doit contenir {ENTITY}.', 'configurationglpiauto')|e('js') }}";
      ldapRightsPreviewList.appendChild(empty);
      return;
    }
    leaves.forEach(function (name) {
      var group = template.replace('{ENTITY}', name.replace(/ /g, '_'));
      var li = document.createElement('li');
      li.className = 'list-group-item';
      li.textContent = name + ' — ' + group;
      ldapRightsPreviewList.appendChild(li);
    });
  }
  ldapRightsEnabledInput.addEventListener('change', toggleLdapRightsFields);
  ldapRightsTemplateInput.addEventListener('input', updateLdapRightsPreview);
  ldapRightsProfileInput.addEventListener('change', updateLdapRightsPreview);
  toggleLdapRightsFields();

  // Function/department LDAP rules (Sprint 36) — a user-supplied list of (AD group name, profile)
  // pairs, entity-independent, layered on top of the per-site rule above rather than replacing it
  // (confirmed in GLPI's own RuleRight::executeActions(): a rule with only a `profiles_id` assign
  // action and no `entities_id` action accumulates into `_ldap_rules.rules_rights`, separate from
  // the per-site `rules_entities_rights` — GLPI's RuleRightCollection doesn't stop at the first
  // match, so both kinds of rules apply together for the same user). Department names are entirely
  // organization-specific (same reasoning as ldap_rights_group_template's own {ENTITY} placeholder)
  // so this is a blank, admin-filled list, never a guessed set of names like "Finance"/"DSI".
  var NATIVE_PROFILE_NAMES = {{ native_profile_names|json_encode|raw }};
  var ldapFunctionRightsRows = document.getElementById('cga-ldap-function-rights-rows');
  var ldapFunctionRightsAddBtn = document.getElementById('cga-ldap-function-rights-add');
  var ldapFunctionRightsIndex = 0;

  function addLdapFunctionRightsRow(group, profile) {
    var idx = ldapFunctionRightsIndex++;
    var row = document.createElement('div');
    row.className = 'row mb-2 align-items-center';

    var groupCol = document.createElement('div');
    groupCol.className = 'col-5';
    var groupInput = document.createElement('input');
    groupInput.type = 'text';
    groupInput.name = 'ldap_function_rights[' + idx + '][group]';
    groupInput.className = 'form-control form-control-sm';
    groupInput.placeholder = "{{ __('Nom du groupe AD/LDAP', 'configurationglpiauto')|e('js') }}";
    groupInput.value = group || '';
    groupCol.appendChild(groupInput);

    var profileCol = document.createElement('div');
    profileCol.className = 'col-5';
    var profileSelect = document.createElement('select');
    profileSelect.name = 'ldap_function_rights[' + idx + '][profile]';
    profileSelect.className = 'form-select form-select-sm';
    NATIVE_PROFILE_NAMES.forEach(function (name) {
      var opt = document.createElement('option');
      opt.value = name;
      opt.textContent = name;
      if (name === profile) { opt.selected = true; }
      profileSelect.appendChild(opt);
    });
    profileCol.appendChild(profileSelect);

    var removeCol = document.createElement('div');
    removeCol.className = 'col-2';
    var removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'btn btn-sm btn-outline-danger';
    removeBtn.textContent = '×';
    removeBtn.addEventListener('click', function () { row.remove(); });
    removeCol.appendChild(removeBtn);

    row.appendChild(groupCol);
    row.appendChild(profileCol);
    row.appendChild(removeCol);
    ldapFunctionRightsRows.appendChild(row);
  }

  ldapFunctionRightsAddBtn.addEventListener('click', function () { addLdapFunctionRightsRow('', NATIVE_PROFILE_NAMES[0]); });

  ({{ ldap_function_rights|default([])|json_encode|raw }}).forEach(function (pair) {
    addLdapFunctionRightsRow(pair.group, pair.profile);
  });

  function wireSimpleToggle(checkboxId, fieldsId) {
    var checkbox = document.getElementById(checkboxId);
    var fields = document.getElementById(fieldsId);
    function toggle() {
      fields.style.display = checkbox.checked ? '' : 'none';
    }
    checkbox.addEventListener('change', toggle);
    toggle();
    return checkbox;
  }

  // Générique pour tout toggle "icônes" qui bascule la visibilité de spans .cga-xxx-icon dans un
  // aperçu déjà rendu côté serveur — même pattern que toggleStateIcons() ci-dessus, factorisé pour
  // les autres intitulés à icônes (fabricants, raisons d'attente, types de projet, types de
  // solution) plutôt que dupliqué une fois par builder.
  function wireIconsToggle(checkboxId, iconSelector) {
    var checkbox = document.getElementById(checkboxId);
    var icons = document.querySelectorAll(iconSelector);
    function toggle() {
      icons.forEach(function (icon) { icon.style.display = checkbox.checked ? '' : 'none'; });
    }
    checkbox.addEventListener('change', toggle);
    toggle();
  }

