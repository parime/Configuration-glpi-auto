{% macro category_tree(nodes) %}
  <ul class="cga-tree">
    {% for node in nodes %}
      <li>
        {% if node.icon is defined %}<span class="cga-category-tree-icon" style="display: none;">{{ node.icon }}</span>{% endif %}
        {{ node.name }}
        {% if node.comment is defined %}<span class="text-muted small"> — {{ node.comment }}</span>{% endif %}
        {% if node.children is defined and node.children|length %}
          {{ _self.category_tree(node.children) }}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}

<div class="card">
  <div class="card-body">

    {% if prereq_checks is defined and prereq_checks|filter(c => not c.ok)|length > 0 %}
      <div class="alert alert-warning mb-3">
        <strong>{{ __('Vérification de l\'environnement', 'configurationglpiauto') }}</strong> —
        {{ __('certains points ci-dessous peuvent limiter des fonctionnalités du wizard. Cela n\'empêche pas de continuer, mais corrigez-les si la fonctionnalité concernée vous intéresse.', 'configurationglpiauto') }}
        <ul class="mb-0 mt-1">
          {% for check in prereq_checks %}
            <li>{{ check.ok ? '✅' : '⚠️' }} {{ check.label }}{% if not check.ok and check.hint %} — <span class="text-muted">{{ check.hint }}</span>{% endif %}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <div class="progress mb-2" style="height: 6px;">
      <div class="progress-bar" id="cga-wizard-progress" role="progressbar" style="width: 25%;"></div>
    </div>
    <p class="text-muted small mb-4" id="cga-wizard-stepindicator"></p>

    <form method="post" enctype="multipart/form-data" action="{{ config('root_doc') }}/plugins/configurationglpiauto/front/wizard.php" id="cga-wizard-form">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

      {# ---------------------------------------------------------------- Étape 1 : Profil #}
      <div class="cga-wizard-step" data-step="1">
        <h3 class="mb-1">{{ __('Étape', 'configurationglpiauto') }} 1 : {{ __('Profil', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Quel profil correspond le mieux à votre organisation ? Ce choix pré-remplit la structure d\'entités, le calendrier et les SLA des étapes suivantes avec des valeurs adaptées — vous pourrez tout ajuster ensuite.', 'configurationglpiauto') }}</p>

        {% for id, profile in profiles %}
          <div class="form-check mb-2">
            <input
              type="radio"
              name="configurationprofiles_id"
              value="{{ profile.id }}"
              class="form-check-input"
              id="cga-profile-{{ profile.id }}"
              {{ config.configurationprofiles_id|default(0) == profile.id ? 'checked' : '' }}
            >
            <label class="form-check-label" for="cga-profile-{{ profile.id }}">
              <strong>{{ profile.name }}</strong>
              {% if profile.description %}<span class="text-muted"> — {{ profile.description }}</span>{% endif %}
            </label>
          </div>
        {% endfor %}

        <div class="alert alert-light border mt-3 mb-0" id="cga-express-panel">
          <p class="mb-2">
            <strong>⚡ {{ __('Configuration express', 'configurationglpiauto') }}</strong> —
            {{ __('applique tout de suite les réglages recommandés ci-dessus pour le profil sélectionné, sans repasser par chacune des 18 étapes. Idéal pour une installation simple/mono-site ; pour une structure multi-site ou MSP, l\'arborescence réelle (étape 2) reste à construire ensuite, sans quoi tout s\'applique à l\'entité racine seule.', 'configurationglpiauto') }}
          </p>
          <button
            type="submit"
            name="finish"
            class="btn btn-outline-primary"
            id="cga-wizard-express-finish"
            onclick="return confirm('{{ __('Ceci va créer/modifier de vraies entités dans GLPI selon les réglages recommandés du profil sélectionné, sans passer en revue chaque étape. Continuer ?', 'configurationglpiauto')|e('js') }}');"
          >
            <span id="cga-wizard-express-finish-label">{{ __('Terminer avec les réglages recommandés', 'configurationglpiauto') }}</span>
          </button>
        </div>
      </div>

      {# ---------------------------------------------------------------- Étape 2 : Structure des entités #}
      <div class="cga-wizard-step" data-step="2" style="display: none;">
        <h3 class="mb-1">{{ __('Étape', 'configurationglpiauto') }} 2 : {{ __('Structure des entités', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Choisissez la structure d\'entités à mettre en place — l\'aperçu à droite se met à jour en direct.', 'configurationglpiauto') }}</p>

        {% include '@configurationglpiauto/_entity_structure_fields.html.twig' %}
      </div>

      {# ---------------------------------------------------------------- Étape 3 : Lieux #}
      <div class="cga-wizard-step" data-step="3" style="display: none;">
        <h3 class="mb-1">{{ __('Étape', 'configurationglpiauto') }} 3 : {{ __('Lieux', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Optionnel : associez une adresse (ou plus) à une entité de l\'arborescence — rue, ville, coordonnées GPS, alias, téléphone... Aucune adresse saisie, aucun lieu créé, comme sur une installation GLPI neuve.', 'configurationglpiauto') }}</p>

        <div class="form-check form-switch mb-2">
          <input type="hidden" name="locations_enabled" value="0">
          <input type="checkbox" name="locations_enabled" value="1" class="form-check-input" id="cga-locations-enabled" {{ config.locations_enabled|default(0) ? 'checked' : '' }}>
          <label class="form-check-label" for="cga-locations-enabled">{{ __('Associer une adresse à des entités de l\'arborescence', 'configurationglpiauto') }}</label>
        </div>
        <div id="cga-locations-fields" style="display: none;" class="mb-3">
          <p class="text-muted small mb-2">{{ __('Parcourez l\'arborescence ci-dessous et ouvrez « Ajouter une adresse » sur les entités qui en ont une (site, agence...) — les autres n\'auront aucun lieu créé, comme sur une installation GLPI neuve.', 'configurationglpiauto') }}</p>

          <div class="form-check form-switch mb-2">
            <input type="hidden" name="location_geocoding_enabled" value="0">
            <input type="checkbox" name="location_geocoding_enabled" value="1" class="form-check-input" id="cga-location-geocoding-enabled" {{ config.location_geocoding_enabled|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="cga-location-geocoding-enabled">{{ __('Assistant d\'adresse (suggestions de rue pendant la saisie, ville/région/pays pré-remplis)', 'configurationglpiauto') }}</label>
          </div>
          <p class="text-muted small mb-2">{{ __('Envoie chaque saisie à un service externe (OpenStreetMap Nominatim par défaut) pour proposer des suggestions — activé par défaut, désactivable ci-dessus si l\'envoi de l\'adresse en cours de saisie à ce service pose problème.', 'configurationglpiauto') }}</p>

          <div id="cga-location-geocoding-fields" style="display: none;" class="mb-3">
            <label class="form-label" for="cga-location-geocoding-endpoint">{{ __('Service de géocodage (avancé)', 'configurationglpiauto') }}</label>
            <input type="text" name="location_geocoding_endpoint" id="cga-location-geocoding-endpoint" class="form-control" style="max-width: 480px;" value="{{ config.location_geocoding_endpoint|default('https://nominatim.openstreetmap.org') }}">
            <p class="text-muted small mb-0">{{ __('Instance Nominatim/Photon auto-hébergée ou compatible, pour un usage réel au-delà d\'un essai ponctuel.', 'configurationglpiauto') }}</p>
          </div>

          <div class="form-check form-switch mb-2">
            <input type="hidden" name="entity_native_address_enabled" value="0">
            <input type="checkbox" name="entity_native_address_enabled" value="1" class="form-check-input" id="cga-entity-native-address-enabled" {{ config.entity_native_address_enabled|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="cga-entity-native-address-enabled">{{ __('Compléter aussi la fiche adresse native de chaque entité (GLPI > Entités > Adresse)', 'configurationglpiauto') }}</label>
          </div>
          <p class="text-muted small mb-2">{{ __('Reprend l\'adresse déjà saisie ci-dessous pour chaque entité, sans la retaper — ajoute juste téléphone/fax/site web/e-mail, propres à la fiche entité.', 'configurationglpiauto') }}</p>

          <div class="form-check form-switch mb-2">
            <input type="hidden" name="country_holidays_enabled" value="0">
            <input type="checkbox" name="country_holidays_enabled" value="1" class="form-check-input" id="cga-country-holidays-enabled" {{ config.country_holidays_enabled|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="cga-country-holidays-enabled">{{ __('Ajouter les jours fériés des pays saisis ci-dessous (hors France, déjà couverte à l\'étape Calendrier)', 'configurationglpiauto') }}</label>
          </div>
          <p class="text-muted small mb-2">{{ __('Uniquement les jours fériés à date fixe (comme pour la France) — un pays non reconnu ou non couvert par le service utilisé est simplement ignoré, sans rien inventer. Les jours fériés créés ne sont pas rattachés automatiquement à un calendrier : à faire vous-même dans Configuration > Calendriers une fois créés.', 'configurationglpiauto') }}</p>

          <div id="cga-locations-tree"></div>
        </div>
      </div>

      {# ---------------------------------------------------------------- Étape 4 : Calendrier #}
      <div class="cga-wizard-step" data-step="4" style="display: none;">
        <h3 class="mb-1">{{ __('Étape', 'configurationglpiauto') }} 4 : {{ __('Calendrier', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Configurez, si besoin, les horaires d\'ouverture appliqués aux entités créées.', 'configurationglpiauto') }}</p>

        <div id="cga-calendar-per-client-toggle-wrap" style="display: none;" class="mb-3 pb-3 border-bottom">
          <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" id="cga-calendar-per-client-toggle">
            <label class="form-check-label" for="cga-calendar-per-client-toggle">{{ __('Calendrier différent par site ou client', 'configurationglpiauto') }}</label>
          </div>
        </div>

        <div id="cga-calendar-shared-section">
          <div class="form-check form-switch mb-3">
            <input type="hidden" name="calendar_enabled" value="0">
            <input
              type="checkbox"
              name="calendar_enabled"
              value="1"
              class="form-check-input"
              id="cga-calendar-enabled"
              {{ config.calendar_enabled|default(0) ? 'checked' : '' }}
            >
            <label class="form-check-label" for="cga-calendar-enabled">{{ __('Créer un calendrier d\'horaires d\'ouverture', 'configurationglpiauto') }}</label>
          </div>

          <div id="cga-calendar-fields" style="display: none;">
            <div class="mb-3" style="max-width: 320px;">
              <label class="form-label">{{ __('Nom du calendrier', 'configurationglpiauto') }}</label>
              <input type="text" name="calendar_name" class="form-control" value="{{ config.calendar_name|default('Horaires standard') }}">
            </div>

            <div class="mb-3">
              <label class="form-label">{{ __('Jours ouvrés et horaires', 'configurationglpiauto') }}</label>
              <p class="text-muted small mb-2">{{ __('Un horaire par jour coché — modifiez-le librement pour un jour qui diffère des autres (ex. vendredi 9h-12h seulement).', 'configurationglpiauto') }}</p>
              <div id="cga-calendar-days"></div>
              <input type="hidden" name="calendar_begin" value="{{ config.calendar_begin|default('08:00') }}">
              <input type="hidden" name="calendar_end" value="{{ config.calendar_end|default('18:00') }}">
            </div>

            <div class="form-check form-switch mb-2">
              <input type="hidden" name="calendar_lunch_break_enabled" value="0">
              <input
                type="checkbox"
                name="calendar_lunch_break_enabled"
                value="1"
                class="form-check-input"
                id="cga-calendar-lunch-break-enabled"
                {{ config.calendar_lunch_break_enabled|default(0) ? 'checked' : '' }}
              >
              <label class="form-check-label" for="cga-calendar-lunch-break-enabled">{{ __('Coupure déjeuner', 'configurationglpiauto') }}</label>
            </div>
            <div class="row mb-2" id="cga-calendar-lunch-fields" style="max-width: 320px; display: none;">
              <div class="col mb-2">
                <label class="form-label">{{ __('Début pause', 'configurationglpiauto') }}</label>
                <input type="time" name="calendar_lunch_begin" class="form-control" value="{{ config.calendar_lunch_begin|default('12:00') }}">
              </div>
              <div class="col mb-2">
                <label class="form-label">{{ __('Fin pause', 'configurationglpiauto') }}</label>
                <input type="time" name="calendar_lunch_end" class="form-control" value="{{ config.calendar_lunch_end|default('13:00') }}">
              </div>
            </div>
            <p class="text-muted small">{{ __('Si activée, tout jour dont les horaires couvrent la pause est scindé en deux plages (matin + après-midi) au lieu d\'une plage continue.', 'configurationglpiauto') }}</p>

            <div class="form-check form-switch mb-3">
              <input type="hidden" name="calendar_holidays_enabled" value="0">
              <input
                type="checkbox"
                name="calendar_holidays_enabled"
                value="1"
                class="form-check-input"
                id="cga-calendar-holidays-enabled"
                {{ config.calendar_holidays_enabled|default(0) ? 'checked' : '' }}
              >
              <label class="form-check-label" for="cga-calendar-holidays-enabled">{{ __('Ajouter les jours fériés français (8 jours fixes)', 'configurationglpiauto') }}</label>
            </div>
            <p class="text-muted small">{{ __('Jour de l\'An, Fête du Travail, Victoire 1945, Fête nationale, Assomption, Toussaint, Armistice, Noël. Sans ça, les échéances SLA/OLA continuent de courir un jour férié. Les jours mobiles (Pâques, Ascension, Pentecôte) ne sont pas inclus — ils changent de date chaque année, à ajouter à la main.', 'configurationglpiauto') }}</p>
          </div>
        </div>

        <div id="cga-calendar-per-client-panels" style="display: none;"></div>
      </div>

      {# ---------------------------------------------------------------- Étape 5 : Niveaux de service (SLA) #}
      <div class="cga-wizard-step" data-step="5" style="display: none;">
        <h3 class="mb-1">{{ __('Étape', 'configurationglpiauto') }} 5 : {{ __('Niveaux de service (SLA)', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Optionnel : délais standards de prise en charge et de résolution des tickets, appliqués aux entités créées.', 'configurationglpiauto') }}</p>

        <div id="cga-sla-per-client-toggle-wrap" style="display: none;" class="mb-3 pb-3 border-bottom">
          <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" id="cga-sla-per-client-toggle">
            <label class="form-check-label" for="cga-sla-per-client-toggle">{{ __('SLA différent par site ou client', 'configurationglpiauto') }}</label>
          </div>
        </div>

        <div id="cga-sla-shared-section">
          <div class="form-check form-switch mb-3">
            <input type="hidden" name="sla_enabled" value="0">
            <input
              type="checkbox"
              name="sla_enabled"
              value="1"
              class="form-check-input"
              id="cga-sla-enabled"
              {{ config.sla_enabled|default(0) ? 'checked' : '' }}
            >
            <label class="form-check-label" for="cga-sla-enabled">{{ __('Créer des SLA standards', 'configurationglpiauto') }}</label>
          </div>

          <div id="cga-sla-fields" style="display: none;">
            <table class="table table-sm mb-3" style="max-width: 480px;">
              <thead>
                <tr>
                  <th>{{ __('Priorité', 'configurationglpiauto') }}</th>
                  <th>{{ __('Prise en charge (h)', 'configurationglpiauto') }}</th>
                  <th>{{ __('Résolution (h)', 'configurationglpiauto') }}</th>
                </tr>
              </thead>
              <tbody>
                {% for level in priority_levels %}
                  <tr>
                    <td>{{ priority_labels[level] }}</td>
                    <td><input type="number" min="1" class="form-control form-control-sm" name="sla_tiers[{{ level }}][tto_hours]" value="{{ sla_tiers[level]['tto_hours'] }}"></td>
                    <td><input type="number" min="1" class="form-control form-control-sm" name="sla_tiers[{{ level }}][ttr_hours]" value="{{ sla_tiers[level]['ttr_hours'] }}"></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>

            <div class="form-check form-switch mb-3">
              <input type="hidden" name="sla_astreinte" value="0">
              <input
                type="checkbox"
                name="sla_astreinte"
                value="1"
                class="form-check-input"
                id="cga-sla-astreinte"
                {{ config.sla_astreinte|default(0) ? 'checked' : '' }}
              >
              <label class="form-check-label" for="cga-sla-astreinte">{{ __('Astreinte (couverture 24h/24, 7j/7 — le délai continue de courir en dehors des horaires ouvrés)', 'configurationglpiauto') }}</label>
            </div>

            <div class="form-check form-switch mb-2">
              <input type="hidden" name="ola_enabled" value="0">
              <input
                type="checkbox"
                name="ola_enabled"
                value="1"
                class="form-check-input"
                id="cga-ola-enabled"
                {{ config.ola_enabled|default(0) ? 'checked' : '' }}
              >
              <label class="form-check-label" for="cga-ola-enabled">{{ __('Ajouter des engagements internes (OLA)', 'configurationglpiauto') }}</label>
            </div>
            <p class="text-muted small">{{ __('L\'OLA est un engagement interne entre le support et les équipes techniques, plus court que le SLA externe — il doit être tenu pour que le SLA le soit aussi.', 'configurationglpiauto') }}</p>

            <table class="table table-sm mb-3" id="cga-ola-fields" style="max-width: 480px; display: none;">
              <thead>
                <tr>
                  <th>{{ __('Priorité', 'configurationglpiauto') }}</th>
                  <th>{{ __('Prise en charge (h)', 'configurationglpiauto') }}</th>
                  <th>{{ __('Résolution (h)', 'configurationglpiauto') }}</th>
                </tr>
              </thead>
              <tbody>
                {% for level in priority_levels %}
                  <tr>
                    <td>{{ priority_labels[level] }}</td>
                    <td><input type="number" min="1" class="form-control form-control-sm" name="ola_tiers[{{ level }}][tto_hours]" value="{{ ola_tiers[level]['tto_hours'] }}"></td>
                    <td><input type="number" min="1" class="form-control form-control-sm" name="ola_tiers[{{ level }}][ttr_hours]" value="{{ ola_tiers[level]['ttr_hours'] }}"></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <div id="cga-sla-per-client-panels" style="display: none;"></div>

        <div class="mt-3 pt-3 border-top">
          <div class="form-check form-switch mb-2">
            <input type="hidden" name="sla_escalation_enabled" value="0">
            <input
              type="checkbox"
              name="sla_escalation_enabled"
              value="1"
              class="form-check-input"
              id="cga-sla-escalation-enabled"
              {{ config.sla_escalation_enabled|default(0) ? 'checked' : '' }}
            >
            <label class="form-check-label" for="cga-sla-escalation-enabled">{{ __('Escalade automatique avant échéance', 'configurationglpiauto') }}</label>
          </div>
          <div id="cga-sla-escalation-fields" style="display: none;" class="d-flex align-items-center gap-2 mb-2">
            <label class="form-label mb-0" for="cga-sla-escalation-threshold">{{ __('Déclenchement à', 'configurationglpiauto') }}</label>
            <input
              type="number"
              min="50"
              max="95"
              name="sla_escalation_threshold_percent"
              id="cga-sla-escalation-threshold"
              class="form-control form-control-sm"
              style="width: 80px;"
              value="{{ config.sla_escalation_threshold_percent|default(75) }}"
            >
            <span>% {{ __('du délai écoulé → priorité relevée d\'un cran (résolution, et engagement interne si activé)', 'configurationglpiauto') }}</span>
          </div>
          <p class="text-muted small">{{ __('S\'applique à tout SLA/OLA créé sur cette étape — partagé ou par site/client.', 'configurationglpiauto') }}</p>
        </div>

        <div class="mt-3 pt-3 border-top">
          <div class="form-check form-switch mb-2">
            <input type="hidden" name="escalation_enabled" value="0">
            <input type="checkbox" name="escalation_enabled" value="1" class="form-check-input" id="cga-escalation-enabled" {{ config.escalation_enabled|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="cga-escalation-enabled">{{ __('Activer l\'escalade entre niveaux de support (N1 → N2 → N3)', 'configurationglpiauto') }}</label>
          </div>
          <div id="cga-escalation-fields" style="display: none;">
            <p class="text-muted small mb-2">{{ __('Crée 3 groupes techniciens (Support N1/N2/N3 — convention ITSM la plus répandue). Tout ticket créé démarre au N1 ; l\'escalade automatique (ci-dessous) le réaffecte au niveau suivant si le SLA de résolution approche ou dépasse son échéance.', 'configurationglpiauto') }}</p>

            <div class="form-check form-switch mb-2">
              <input type="hidden" name="support_tier_icons_enabled" value="0">
              <input type="checkbox" name="support_tier_icons_enabled" value="1" class="form-check-input" id="cga-support-tier-icons-enabled" {{ config.support_tier_icons_enabled|default(0) ? 'checked' : '' }}>
              <label class="form-check-label" for="cga-support-tier-icons-enabled">{{ __('Ajouter des icônes (repérage rapide dans les listes d\'affectation)', 'configurationglpiauto') }}</label>
            </div>
            <p class="text-muted small mb-2">
              {% for key, tier in support_tiers_preview %}<span class="cga-support-tier-icon" style="display: none;">{{ tier.icon }}</span> {{ tier.name }}{% if not loop.last %}, {% endif %}{% endfor %}
            </p>

            <div class="form-check form-switch mb-2">
              <input type="hidden" name="escalation_includes_n0" value="0">
              <input type="checkbox" name="escalation_includes_n0" value="1" class="form-check-input" id="cga-escalation-includes-n0" {{ config.escalation_includes_n0|default(0) ? 'checked' : '' }}>
              <label class="form-check-label" for="cga-escalation-includes-n0">{{ __('Inclure le niveau N0 (portail libre-service) dans le récapitulatif', 'configurationglpiauto') }}</label>
            </div>
            <p class="text-muted small mb-2">{{ __('N0 = le libre-service déjà configuré aux étapes Catalogue de services / Formulaire d\'accueil — pas un groupe supplémentaire, juste un repère pour situer où commence le support humain.', 'configurationglpiauto') }}</p>

            <div class="form-check form-switch mb-2">
              <input type="hidden" name="escalation_auto_n1_n2" value="0">
              <input type="checkbox" name="escalation_auto_n1_n2" value="1" class="form-check-input" id="cga-escalation-auto-n1-n2" {{ config.escalation_auto_n1_n2|default(1) ? 'checked' : '' }}>
              <label class="form-check-label" for="cga-escalation-auto-n1-n2">{{ __('Escalade automatique N1 → N2 (au seuil ci-dessus)', 'configurationglpiauto') }}</label>
            </div>
            <div class="form-check form-switch mb-2">
              <input type="hidden" name="escalation_auto_n2_n3" value="0">
              <input type="checkbox" name="escalation_auto_n2_n3" value="1" class="form-check-input" id="cga-escalation-auto-n2-n3" {{ config.escalation_auto_n2_n3|default(1) ? 'checked' : '' }}>
