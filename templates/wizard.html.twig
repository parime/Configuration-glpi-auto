<div class="card">
  <div class="card-body">

    <div class="progress mb-2" style="height: 6px;">
      <div class="progress-bar" id="cga-wizard-progress" role="progressbar" style="width: 25%;"></div>
    </div>
    <p class="text-muted small mb-4" id="cga-wizard-stepindicator"></p>

    <form method="post" action="{{ config('root_doc') }}/plugins/configurationglpiauto/front/wizard.php" id="cga-wizard-form">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

      {# ---------------------------------------------------------------- Étape 1 : Profil #}
      <div class="cga-wizard-step" data-step="1">
        <h3 class="mb-1">{{ __('Étape 1 : Profil', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Quel profil correspond le mieux à votre organisation ? Ce choix pré-remplit la structure d\'entités, le calendrier et les SLA des étapes suivantes avec des valeurs adaptées — vous pourrez tout ajuster ensuite.', 'configurationglpiauto') }}</p>

        {% for id, profile in profiles %}
          <div class="form-check mb-2">
            <input
              type="radio"
              name="configurationprofiles_id"
              value="{{ profile.id }}"
              class="form-check-input"
              id="cga-profile-{{ profile.id }}"
              {{ config.configurationprofiles_id|default(0) == profile.id ? 'checked' : '' }}
            >
            <label class="form-check-label" for="cga-profile-{{ profile.id }}">
              <strong>{{ profile.name }}</strong>
              {% if profile.description %}<span class="text-muted"> — {{ profile.description }}</span>{% endif %}
            </label>
          </div>
        {% endfor %}
      </div>

      {# ---------------------------------------------------------------- Étape 2 : Entités #}
      <div class="cga-wizard-step" data-step="2" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 2 : Structure des entités', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Choisissez la structure d\'entités à mettre en place — l\'aperçu à droite se met à jour en direct.', 'configurationglpiauto') }}</p>

        {% include '@configurationglpiauto/_entity_structure_fields.html.twig' %}
      </div>

      {# ---------------------------------------------------------------- Étape 3 : Calendrier #}
      <div class="cga-wizard-step" data-step="3" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 3 : Calendrier', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Configurez, si besoin, les horaires d\'ouverture appliqués aux entités créées.', 'configurationglpiauto') }}</p>

        <div id="cga-calendar-per-client-toggle-wrap" style="display: none;" class="mb-3 pb-3 border-bottom">
          <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" id="cga-calendar-per-client-toggle">
            <label class="form-check-label" for="cga-calendar-per-client-toggle">{{ __('Calendrier différent par site ou client', 'configurationglpiauto') }}</label>
          </div>
        </div>

        <div id="cga-calendar-shared-section">
          <div class="form-check form-switch mb-3">
            <input type="hidden" name="calendar_enabled" value="0">
            <input
              type="checkbox"
              name="calendar_enabled"
              value="1"
              class="form-check-input"
              id="cga-calendar-enabled"
              {{ config.calendar_enabled|default(0) ? 'checked' : '' }}
            >
            <label class="form-check-label" for="cga-calendar-enabled">{{ __('Créer un calendrier d\'horaires d\'ouverture', 'configurationglpiauto') }}</label>
          </div>

          <div id="cga-calendar-fields" style="display: none;">
            <div class="mb-3" style="max-width: 320px;">
              <label class="form-label">{{ __('Nom du calendrier', 'configurationglpiauto') }}</label>
              <input type="text" name="calendar_name" class="form-control" value="{{ config.calendar_name|default('Horaires standard') }}">
            </div>

            <div class="mb-3">
              <label class="form-label">{{ __('Jours ouvrés', 'configurationglpiauto') }}</label>
              <div id="cga-calendar-days"></div>
            </div>

            <div class="row" style="max-width: 320px;">
              <div class="col mb-3">
                <label class="form-label">{{ __('Ouverture', 'configurationglpiauto') }}</label>
                <input type="time" name="calendar_begin" class="form-control" value="{{ config.calendar_begin|default('08:00') }}">
              </div>
              <div class="col mb-3">
                <label class="form-label">{{ __('Fermeture', 'configurationglpiauto') }}</label>
                <input type="time" name="calendar_end" class="form-control" value="{{ config.calendar_end|default('18:00') }}">
              </div>
            </div>
          </div>
        </div>

        <div id="cga-calendar-per-client-panels" style="display: none;"></div>
      </div>

      {# ---------------------------------------------------------------- Étape 4 : SLA #}
      <div class="cga-wizard-step" data-step="4" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 4 : Niveaux de service (SLA)', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Optionnel : délais standards de prise en charge et de résolution des tickets, appliqués aux entités créées.', 'configurationglpiauto') }}</p>

        <div id="cga-sla-per-client-toggle-wrap" style="display: none;" class="mb-3 pb-3 border-bottom">
          <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" id="cga-sla-per-client-toggle">
            <label class="form-check-label" for="cga-sla-per-client-toggle">{{ __('SLA différent par site ou client', 'configurationglpiauto') }}</label>
          </div>
        </div>

        <div id="cga-sla-shared-section">
          <div class="form-check form-switch mb-3">
            <input type="hidden" name="sla_enabled" value="0">
            <input
              type="checkbox"
              name="sla_enabled"
              value="1"
              class="form-check-input"
              id="cga-sla-enabled"
              {{ config.sla_enabled|default(0) ? 'checked' : '' }}
            >
            <label class="form-check-label" for="cga-sla-enabled">{{ __('Créer des SLA standards', 'configurationglpiauto') }}</label>
          </div>

          <div id="cga-sla-fields" style="display: none;">
            <table class="table table-sm mb-3" style="max-width: 480px;">
              <thead>
                <tr>
                  <th>{{ __('Priorité', 'configurationglpiauto') }}</th>
                  <th>{{ __('Prise en charge (h)', 'configurationglpiauto') }}</th>
                  <th>{{ __('Résolution (h)', 'configurationglpiauto') }}</th>
                </tr>
              </thead>
              <tbody>
                {% for level in priority_levels %}
                  <tr>
                    <td>{{ priority_labels[level] }}</td>
                    <td><input type="number" min="1" class="form-control form-control-sm" name="sla_tiers[{{ level }}][tto_hours]" value="{{ sla_tiers[level]['tto_hours'] }}"></td>
                    <td><input type="number" min="1" class="form-control form-control-sm" name="sla_tiers[{{ level }}][ttr_hours]" value="{{ sla_tiers[level]['ttr_hours'] }}"></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>

            <div class="form-check form-switch mb-3">
              <input type="hidden" name="sla_astreinte" value="0">
              <input
                type="checkbox"
                name="sla_astreinte"
                value="1"
                class="form-check-input"
                id="cga-sla-astreinte"
                {{ config.sla_astreinte|default(0) ? 'checked' : '' }}
              >
              <label class="form-check-label" for="cga-sla-astreinte">{{ __('Astreinte (couverture 24h/24, 7j/7 — le délai continue de courir en dehors des horaires ouvrés)', 'configurationglpiauto') }}</label>
            </div>
          </div>
        </div>

        <div id="cga-sla-per-client-panels" style="display: none;"></div>
      </div>

      {# ---------------------------------------------------------------- Étape 5 : Branding #}
      <div class="cga-wizard-step" data-step="5" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 5 : Personnalisation graphique', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Optionnel : une couleur principale appliquée à l\'interface des entités créées.', 'configurationglpiauto') }}</p>

        <div class="form-check form-switch mb-3">
          <input type="hidden" name="branding_enabled" value="0">
          <input
            type="checkbox"
            name="branding_enabled"
            value="1"
            class="form-check-input"
            id="cga-branding-enabled"
            {{ config.branding_enabled|default(0) ? 'checked' : '' }}
          >
          <label class="form-check-label" for="cga-branding-enabled">{{ __('Personnaliser la couleur principale', 'configurationglpiauto') }}</label>
        </div>

        <div id="cga-branding-fields" style="display: none;" class="d-flex align-items-center gap-3">
          <div class="mb-3">
            <label class="form-label">{{ __('Couleur principale', 'configurationglpiauto') }}</label>
            <input type="color" name="branding_primary_color" id="cga-branding-color" class="form-control form-control-color" value="{{ config.branding_primary_color|default('#206bc4') }}">
          </div>
          <button type="button" class="btn" id="cga-branding-swatch" style="min-width: 140px;">{{ __('Aperçu', 'configurationglpiauto') }}</button>
        </div>
      </div>

      {# ---------------------------------------------------------------- Étape 6 : Récapitulatif #}
      <div class="cga-wizard-step" data-step="6" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 6 : Récapitulatif', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Vérifiez vos choix avant de terminer — cette étape crée réellement les entités, le calendrier, les SLA et la personnalisation graphique.', 'configurationglpiauto') }}</p>

        <ul class="list-group mb-3">
          <li class="list-group-item">
            <strong>{{ __('Profil', 'configurationglpiauto') }} :</strong> <span id="cga-summary-profile"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Structure', 'configurationglpiauto') }} :</strong> <span id="cga-summary-mode"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Arborescence', 'configurationglpiauto') }} :</strong> <span id="cga-summary-tree"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Calendrier', 'configurationglpiauto') }} :</strong> <span id="cga-summary-calendar"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('SLA', 'configurationglpiauto') }} :</strong> <span id="cga-summary-sla"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Personnalisation', 'configurationglpiauto') }} :</strong> <span id="cga-summary-branding"></span>
          </li>
        </ul>
      </div>

      <div class="mt-4 d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" id="cga-wizard-prev">{{ __('Précédent', 'configurationglpiauto') }}</button>
        <button type="button" class="btn btn-primary" id="cga-wizard-next">{{ __('Suivant', 'configurationglpiauto') }}</button>
        <button
          type="submit"
          name="finish"
          class="btn btn-primary"
          id="cga-wizard-finish"
          style="display: none;"
          onclick="return confirm('{{ __('Ceci va créer/modifier de vraies entités dans GLPI (et, si activés, un calendrier et une personnalisation graphique) selon les choix faits. Continuer ?', 'configurationglpiauto')|e('js') }}');"
        >
          {{ __('Terminer', 'configurationglpiauto') }}
        </button>
      </div>
    </form>

  </div>
</div>

<script>
(function () {
  var STEP_COUNT = 6;
  var currentStep = 1;
  var steps = document.querySelectorAll('.cga-wizard-step');
  var progressBar = document.getElementById('cga-wizard-progress');
  var stepIndicator = document.getElementById('cga-wizard-stepindicator');
  var prevBtn = document.getElementById('cga-wizard-prev');
  var nextBtn = document.getElementById('cga-wizard-next');
  var finishBtn = document.getElementById('cga-wizard-finish');
  var stepLabels = [
    "{{ __('Profil', 'configurationglpiauto')|e('js') }}",
    "{{ __('Entités', 'configurationglpiauto')|e('js') }}",
    "{{ __('Calendrier', 'configurationglpiauto')|e('js') }}",
    "{{ __('SLA', 'configurationglpiauto')|e('js') }}",
    "{{ __('Personnalisation', 'configurationglpiauto')|e('js') }}",
    "{{ __('Récapitulatif', 'configurationglpiauto')|e('js') }}"
  ];

  var DAYS = [
    { value: 1, label: "{{ __('Lundi')|e('js') }}" },
    { value: 2, label: "{{ __('Mardi')|e('js') }}" },
    { value: 3, label: "{{ __('Mercredi')|e('js') }}" },
    { value: 4, label: "{{ __('Jeudi')|e('js') }}" },
    { value: 5, label: "{{ __('Vendredi')|e('js') }}" },
    { value: 6, label: "{{ __('Samedi')|e('js') }}" },
    { value: 0, label: "{{ __('Dimanche')|e('js') }}" }
  ];
  var initialCalendarDays = {{ config.calendar_days|default('[1,2,3,4,5]')|raw }};

  var PRIORITY_LEVELS = {{ priority_levels|json_encode|raw }};
  var PRIORITY_LABELS = {{ priority_labels|json_encode|raw }};

  var calendarEnabledInput = document.getElementById('cga-calendar-enabled');
  var calendarFields = document.getElementById('cga-calendar-fields');
  var calendarDaysContainer = document.getElementById('cga-calendar-days');

  DAYS.forEach(function (day) {
    var wrapper = document.createElement('div');
    wrapper.className = 'form-check form-check-inline';
    var input = document.createElement('input');
    input.type = 'checkbox';
    input.name = 'calendar_day[]';
    input.value = day.value;
    input.className = 'form-check-input';
    input.id = 'cga-calendar-day-' + day.value;
    input.checked = initialCalendarDays.indexOf(day.value) !== -1;
    var label = document.createElement('label');
    label.className = 'form-check-label';
    label.setAttribute('for', input.id);
    label.textContent = day.label;
    wrapper.appendChild(input);
    wrapper.appendChild(label);
    calendarDaysContainer.appendChild(wrapper);
  });

  function toggleCalendarFields() {
    calendarFields.style.display = calendarEnabledInput.checked ? '' : 'none';
  }
  calendarEnabledInput.addEventListener('change', toggleCalendarFields);
  toggleCalendarFields();

  var slaEnabledInput = document.getElementById('cga-sla-enabled');
  var slaFields = document.getElementById('cga-sla-fields');
  var slaAstreinteInput = document.getElementById('cga-sla-astreinte');
  function toggleSlaFields() {
    slaFields.style.display = slaEnabledInput.checked ? '' : 'none';
  }
  slaEnabledInput.addEventListener('change', toggleSlaFields);
  toggleSlaFields();

  var brandingEnabledInput = document.getElementById('cga-branding-enabled');
  var brandingFields = document.getElementById('cga-branding-fields');
  var brandingColorInput = document.getElementById('cga-branding-color');
  var brandingSwatch = document.getElementById('cga-branding-swatch');

  function toggleBrandingFields() {
    brandingFields.style.display = brandingEnabledInput.checked ? 'flex' : 'none';
  }
  function updateSwatch() {
    brandingSwatch.style.backgroundColor = brandingColorInput.value;
    brandingSwatch.style.color = '#fff';
    brandingSwatch.style.borderColor = brandingColorInput.value;
  }
  brandingEnabledInput.addEventListener('change', toggleBrandingFields);
  brandingColorInput.addEventListener('input', updateSwatch);
  toggleBrandingFields();
  updateSwatch();

  // Per-client/site calendar & SLA (Sprint 13): only meaningful once there's more than one
  // top-level entity to have its own settings, i.e. any multi-entité mode — not mono. Reuses
  // window.cgaTree (same array reference the tree editor in step 2 mutates, see
  // _entity_structure_fields.html.twig) rather than a second data channel kept in sync by index.
  function currentEntityMode() {
    var checked = document.querySelector('input[name="entity_mode"]:checked');
    return checked ? checked.value : 'mono';
  }

  function syncTreeJson() {
    var input = document.getElementById('cga-entity-tree-json');
    if (input) {
      input.value = JSON.stringify(window.cgaTree || []);
    }
  }

  function ensureClientSettings(key, defaults) {
    (window.cgaTree || []).forEach(function (node) {
      node.settings = node.settings || {};
      if (!node.settings[key]) {
        node.settings[key] = Object.assign({}, defaults);
      }
    });
  }

  function stripClientSettings(key) {
    (window.cgaTree || []).forEach(function (node) {
      if (node.settings) {
        delete node.settings[key];
        if (Object.keys(node.settings).length === 0) {
          delete node.settings;
        }
      }
    });
  }

  function anyClientHasSettings(key) {
    return (window.cgaTree || []).some(function (node) {
      return node.settings && node.settings[key];
    });
  }

  function buildDayCheckboxes(container, selectedDays, idPrefix, onChange) {
    container.innerHTML = '';
    DAYS.forEach(function (day) {
      var wrapper = document.createElement('div');
      wrapper.className = 'form-check form-check-inline';
      var input = document.createElement('input');
      input.type = 'checkbox';
      input.className = 'form-check-input';
      input.id = idPrefix + '-day-' + day.value;
      input.checked = selectedDays.indexOf(day.value) !== -1;
      input.addEventListener('change', onChange);
      var label = document.createElement('label');
      label.className = 'form-check-label';
      label.setAttribute('for', input.id);
      label.textContent = day.label;
      wrapper.appendChild(input);
      wrapper.appendChild(label);
      container.appendChild(wrapper);
    });
  }

  function readSharedSlaTiers() {
    var tiers = {};
    PRIORITY_LEVELS.forEach(function (level) {
      var ttoInput = document.querySelector('input[name="sla_tiers[' + level + '][tto_hours]"]');
      var ttrInput = document.querySelector('input[name="sla_tiers[' + level + '][ttr_hours]"]');
      tiers[level] = {
        tto_hours: ttoInput ? (parseInt(ttoInput.value, 10) || 1) : 4,
        ttr_hours: ttrInput ? (parseInt(ttrInput.value, 10) || 1) : 48,
      };
    });
    return tiers;
  }

  function buildTierTable(container, tiers, idPrefix, onChange) {
    container.innerHTML = '';
    var table = document.createElement('table');
    table.className = 'table table-sm';
    table.style.maxWidth = '480px';
    var thead = document.createElement('thead');
    var headRow = document.createElement('tr');
    [
      "{{ __('Priorité', 'configurationglpiauto')|e('js') }}",
      "{{ __('Prise en charge (h)', 'configurationglpiauto')|e('js') }}",
      "{{ __('Résolution (h)', 'configurationglpiauto')|e('js') }}",
    ].forEach(function (text) {
      var th = document.createElement('th');
      th.textContent = text;
      headRow.appendChild(th);
    });
    thead.appendChild(headRow);
    table.appendChild(thead);

    var tbody = document.createElement('tbody');
    PRIORITY_LEVELS.forEach(function (level) {
      var tr = document.createElement('tr');
      var tdLabel = document.createElement('td');
      tdLabel.textContent = PRIORITY_LABELS[level];
      tr.appendChild(tdLabel);

      ['tto_hours', 'ttr_hours'].forEach(function (key) {
        var td = document.createElement('td');
        var inp = document.createElement('input');
        inp.type = 'number';
        inp.min = '1';
        inp.className = 'form-control form-control-sm';
        inp.id = idPrefix + '-' + level + '-' + key;
        inp.value = (tiers[level] && tiers[level][key]) || 1;
        inp.addEventListener('input', function (e) {
          tiers[level] = tiers[level] || {};
          tiers[level][key] = parseInt(e.target.value, 10) || 1;
          onChange();
        });
        td.appendChild(inp);
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    });
    table.appendChild(tbody);
    container.appendChild(table);
  }

  // ---- Calendrier par client/site ----
  var calendarPerClientToggle = document.getElementById('cga-calendar-per-client-toggle');
  var calendarPerClientToggleWrap = document.getElementById('cga-calendar-per-client-toggle-wrap');
  var calendarSharedSection = document.getElementById('cga-calendar-shared-section');
  var calendarPerClientPanels = document.getElementById('cga-calendar-per-client-panels');

  function renderCalendarPerClientPanels() {
    calendarPerClientPanels.innerHTML = '';
    (window.cgaTree || []).forEach(function (node, i) {
      var settings = (node.settings && node.settings.calendar) || { enabled: false, days: [1, 2, 3, 4, 5], begin: '08:00', end: '18:00' };

      var card = document.createElement('div');
      card.className = 'card mb-2';
      var body = document.createElement('div');
      body.className = 'card-body';

      var title = document.createElement('h4');
      title.className = 'mb-2';
      title.textContent = node.name || "{{ __('(sans nom)', 'configurationglpiauto')|e('js') }}";
      body.appendChild(title);

      var switchWrap = document.createElement('div');
      switchWrap.className = 'form-check form-switch mb-2';
      var enabledInput = document.createElement('input');
      enabledInput.type = 'checkbox';
      enabledInput.className = 'form-check-input';
      enabledInput.id = 'cga-cal-pc-' + i + '-enabled';
      enabledInput.checked = !!settings.enabled;
      var enabledLabel = document.createElement('label');
      enabledLabel.className = 'form-check-label';
      enabledLabel.setAttribute('for', enabledInput.id);
      enabledLabel.textContent = "{{ __('Créer un calendrier pour cette entité', 'configurationglpiauto')|e('js') }}";
      switchWrap.appendChild(enabledInput);
      switchWrap.appendChild(enabledLabel);
      body.appendChild(switchWrap);

      var fieldsWrap = document.createElement('div');
      fieldsWrap.style.display = settings.enabled ? '' : 'none';

      function writeBack() {
        node.settings = node.settings || {};
        settings.enabled = enabledInput.checked;
        node.settings.calendar = settings;
        syncTreeJson();
      }

      var daysLabel = document.createElement('label');
      daysLabel.className = 'form-label d-block';
      daysLabel.textContent = "{{ __('Jours ouvrés', 'configurationglpiauto')|e('js') }}";
      fieldsWrap.appendChild(daysLabel);
      var daysContainer = document.createElement('div');
      daysContainer.className = 'mb-2';
      fieldsWrap.appendChild(daysContainer);
      buildDayCheckboxes(daysContainer, settings.days, 'cga-cal-pc-' + i, function () {
        settings.days = DAYS.filter(function (d) {
          return document.getElementById('cga-cal-pc-' + i + '-day-' + d.value).checked;
        }).map(function (d) { return d.value; });
        writeBack();
      });

      var row = document.createElement('div');
      row.className = 'row';
      row.style.maxWidth = '320px';
      [
        ["{{ __('Ouverture', 'configurationglpiauto')|e('js') }}", 'begin'],
        ["{{ __('Fermeture', 'configurationglpiauto')|e('js') }}", 'end'],
      ].forEach(function (pair) {
        var col = document.createElement('div');
        col.className = 'col mb-2';
        var lbl = document.createElement('label');
        lbl.className = 'form-label';
        lbl.textContent = pair[0];
        var inp = document.createElement('input');
        inp.type = 'time';
        inp.className = 'form-control';
        inp.value = settings[pair[1]];
        inp.addEventListener('input', function (e) {
          settings[pair[1]] = e.target.value;
          writeBack();
        });
        col.appendChild(lbl);
        col.appendChild(inp);
        row.appendChild(col);
      });
      fieldsWrap.appendChild(row);
      body.appendChild(fieldsWrap);

      enabledInput.addEventListener('change', function () {
        fieldsWrap.style.display = enabledInput.checked ? '' : 'none';
        writeBack();
      });

      card.appendChild(body);
      calendarPerClientPanels.appendChild(card);
    });
  }

  function updateCalendarMode() {
    var multiEntity = currentEntityMode() !== 'mono';
    calendarPerClientToggleWrap.style.display = multiEntity ? '' : 'none';
    if (!multiEntity && calendarPerClientToggle.checked) {
      calendarPerClientToggle.checked = false;
    }

    var perClient = multiEntity && calendarPerClientToggle.checked;
    calendarSharedSection.style.display = perClient ? 'none' : '';
    calendarPerClientPanels.style.display = perClient ? '' : 'none';

    if (perClient) {
      ensureClientSettings('calendar', { enabled: false, days: [1, 2, 3, 4, 5], begin: '08:00', end: '18:00' });
      renderCalendarPerClientPanels();
    } else {
      stripClientSettings('calendar');
    }
    syncTreeJson();
  }
  calendarPerClientToggle.addEventListener('change', updateCalendarMode);

  // ---- SLA par client/site ----
  var slaPerClientToggle = document.getElementById('cga-sla-per-client-toggle');
  var slaPerClientToggleWrap = document.getElementById('cga-sla-per-client-toggle-wrap');
  var slaSharedSection = document.getElementById('cga-sla-shared-section');
  var slaPerClientPanels = document.getElementById('cga-sla-per-client-panels');

  function renderSlaPerClientPanels() {
    slaPerClientPanels.innerHTML = '';
    (window.cgaTree || []).forEach(function (node, i) {
      var hasOverride = !!(node.settings && node.settings.sla);
      var settings = (node.settings && node.settings.sla) || { enabled: false, astreinte: false, tiers: {} };

      var card = document.createElement('div');
      card.className = 'card mb-2';
      var body = document.createElement('div');
      body.className = 'card-body';

      var title = document.createElement('h4');
      title.className = 'mb-2';
      title.textContent = node.name || "{{ __('(sans nom)', 'configurationglpiauto')|e('js') }}";
      body.appendChild(title);

      // "Utiliser le SLA par défaut" (coché par défaut) : ce client suit le tableau partagé,
      // rien n'est stocké pour lui (même principe que le repli Sprint 13). Décoché : tableau à 6
      // niveaux propre à ce client, pré-rempli avec les valeurs actuelles du tableau partagé —
      // un point de départ, pas des champs vides.
      var useDefaultWrap = document.createElement('div');
      useDefaultWrap.className = 'form-check form-switch mb-2';
      var useDefaultInput = document.createElement('input');
      useDefaultInput.type = 'checkbox';
      useDefaultInput.className = 'form-check-input';
      useDefaultInput.id = 'cga-sla-pc-' + i + '-usedefault';
      useDefaultInput.checked = !hasOverride;
      var useDefaultLabel = document.createElement('label');
      useDefaultLabel.className = 'form-check-label';
      useDefaultLabel.setAttribute('for', useDefaultInput.id);
      useDefaultLabel.textContent = "{{ __('Utiliser le SLA par défaut', 'configurationglpiauto')|e('js') }}";
      useDefaultWrap.appendChild(useDefaultInput);
      useDefaultWrap.appendChild(useDefaultLabel);
      body.appendChild(useDefaultWrap);

      var customWrap = document.createElement('div');
      customWrap.style.display = hasOverride ? '' : 'none';

      var enabledWrap = document.createElement('div');
      enabledWrap.className = 'form-check form-switch mb-2';
      var enabledInput = document.createElement('input');
      enabledInput.type = 'checkbox';
      enabledInput.className = 'form-check-input';
      enabledInput.id = 'cga-sla-pc-' + i + '-enabled';
      enabledInput.checked = !!settings.enabled;
      var enabledLabel = document.createElement('label');
      enabledLabel.className = 'form-check-label';
      enabledLabel.setAttribute('for', enabledInput.id);
      enabledLabel.textContent = "{{ __('Créer un SLA pour cette entité', 'configurationglpiauto')|e('js') }}";
      enabledWrap.appendChild(enabledInput);
      enabledWrap.appendChild(enabledLabel);
      customWrap.appendChild(enabledWrap);

      var fieldsWrap = document.createElement('div');
      fieldsWrap.style.display = settings.enabled ? '' : 'none';

      function writeBack() {
        node.settings = node.settings || {};
        settings.enabled = enabledInput.checked;
        node.settings.sla = settings;
        syncTreeJson();
      }

      var tiersContainer = document.createElement('div');
      fieldsWrap.appendChild(tiersContainer);
      buildTierTable(tiersContainer, settings.tiers, 'cga-sla-pc-' + i, writeBack);

      var astreinteWrap = document.createElement('div');
      astreinteWrap.className = 'form-check form-switch mb-2 mt-2';
      var astreinteInput = document.createElement('input');
      astreinteInput.type = 'checkbox';
      astreinteInput.className = 'form-check-input';
      astreinteInput.id = 'cga-sla-pc-' + i + '-astreinte';
      astreinteInput.checked = !!settings.astreinte;
      astreinteInput.addEventListener('change', function () {
        settings.astreinte = astreinteInput.checked;
        writeBack();
      });
      var astreinteLabel = document.createElement('label');
      astreinteLabel.className = 'form-check-label';
      astreinteLabel.setAttribute('for', astreinteInput.id);
      astreinteLabel.textContent = "{{ __('Astreinte (24h/24, 7j/7)', 'configurationglpiauto')|e('js') }}";
      astreinteWrap.appendChild(astreinteInput);
      astreinteWrap.appendChild(astreinteLabel);
      fieldsWrap.appendChild(astreinteWrap);

      customWrap.appendChild(fieldsWrap);
      body.appendChild(customWrap);

      enabledInput.addEventListener('change', function () {
        fieldsWrap.style.display = enabledInput.checked ? '' : 'none';
        writeBack();
      });

      useDefaultInput.addEventListener('change', function () {
        if (useDefaultInput.checked) {
          if (node.settings) {
            delete node.settings.sla;
            if (Object.keys(node.settings).length === 0) {
              delete node.settings;
            }
          }
          syncTreeJson();
          customWrap.style.display = 'none';
        } else {
          node.settings = node.settings || {};
          node.settings.sla = { enabled: false, astreinte: false, tiers: readSharedSlaTiers() };
          syncTreeJson();
          renderSlaPerClientPanels();
        }
      });

      card.appendChild(body);
      slaPerClientPanels.appendChild(card);
    });
  }

  function updateSlaMode() {
    var multiEntity = currentEntityMode() !== 'mono';
    slaPerClientToggleWrap.style.display = multiEntity ? '' : 'none';
    if (!multiEntity && slaPerClientToggle.checked) {
      slaPerClientToggle.checked = false;
    }

    var perClient = multiEntity && slaPerClientToggle.checked;
    slaSharedSection.style.display = perClient ? 'none' : '';
    slaPerClientPanels.style.display = perClient ? '' : 'none';

    if (perClient) {
      // Unlike calendar, no ensureClientSettings() here: a client defaults to "use the shared
      // SLA table" (no settings.sla stored at all) until it explicitly opts out via its own
      // "Utiliser le SLA par défaut" checkbox (see renderSlaPerClientPanels()) — the per-client
      // mode toggle alone shouldn't force every client into a custom table.
      renderSlaPerClientPanels();
    } else {
      stripClientSettings('sla');
    }
    syncTreeJson();
  }
  slaPerClientToggle.addEventListener('change', updateSlaMode);

  // Tree changes (add/remove/rename a node, or switch entity_mode) come from step 2's script —
  // re-derive both panels' visibility/content from the live window.cgaTree reference.
  document.addEventListener('cga:tree-changed', function () {
    updateCalendarMode();
    updateSlaMode();
  });

  // Reloading a config that already has per-client settings saved: default the toggle to ON
  // instead of stripping data the admin already entered in an earlier pass.
  calendarPerClientToggle.checked = anyClientHasSettings('calendar');
  slaPerClientToggle.checked = anyClientHasSettings('sla');
  updateCalendarMode();
  updateSlaMode();

  function fillSummary() {
    var profileInput = document.querySelector('input[name="configurationprofiles_id"]:checked');
    var profileLabel = profileInput
      ? profileInput.closest('.form-check').querySelector('label').textContent.trim()
      : "{{ __('Aucun', 'configurationglpiauto')|e('js') }}";
    document.getElementById('cga-summary-profile').textContent = profileLabel;

    var modeInput = document.querySelector('input[name="entity_mode"]:checked');
    var modeLabel = modeInput
      ? modeInput.closest('.form-check').querySelector('label').textContent.trim()
      : '';
    document.getElementById('cga-summary-mode').textContent = modeLabel;

    var preview = document.getElementById('cga-tree-preview');
    document.getElementById('cga-summary-tree').innerHTML = preview ? preview.innerHTML : '';

    var calendarSummary;
    if (calendarPerClientToggle.checked) {
      var calPcCount = (window.cgaTree || []).filter(function (n) { return n.settings && n.settings.calendar && n.settings.calendar.enabled; }).length;
      calendarSummary = calPcCount + ' ' + "{{ __('site(s)/client(s) avec un calendrier propre', 'configurationglpiauto')|e('js') }}";
    } else if (!calendarEnabledInput.checked) {
      calendarSummary = "{{ __('Aucun', 'configurationglpiauto')|e('js') }}";
    } else {
      var checkedDays = DAYS.filter(function (d) {
        return document.getElementById('cga-calendar-day-' + d.value).checked;
      }).map(function (d) { return d.label; });
      var name = document.querySelector('input[name="calendar_name"]').value || "{{ __('Horaires standard', 'configurationglpiauto')|e('js') }}";
      var begin = document.querySelector('input[name="calendar_begin"]').value;
      var end = document.querySelector('input[name="calendar_end"]').value;
      calendarSummary = name + ' — ' + checkedDays.join(', ') + ' — ' + begin + '-' + end;
    }
    document.getElementById('cga-summary-calendar').textContent = calendarSummary;

    if (slaPerClientToggle.checked) {
      var slaPcCount = (window.cgaTree || []).filter(function (n) { return n.settings && n.settings.sla && n.settings.sla.enabled; }).length;
      document.getElementById('cga-summary-sla').textContent = slaPcCount + ' ' + "{{ __('site(s)/client(s) avec un SLA propre', 'configurationglpiauto')|e('js') }}";
    } else if (!slaEnabledInput.checked) {
      document.getElementById('cga-summary-sla').textContent = "{{ __('Aucun', 'configurationglpiauto')|e('js') }}";
    } else {
      var tiers = readSharedSlaTiers();
      var slaSummary = PRIORITY_LEVELS.map(function (level) {
        return PRIORITY_LABELS[level] + ' ' + tiers[level].tto_hours + 'h/' + tiers[level].ttr_hours + 'h';
      }).join(', ');
      if (slaAstreinteInput.checked) {
        slaSummary += " — {{ __('astreinte 24h/24, 7j/7', 'configurationglpiauto')|e('js') }}";
      }
      document.getElementById('cga-summary-sla').textContent = slaSummary;
    }

    document.getElementById('cga-summary-branding').textContent = brandingEnabledInput.checked
      ? "{{ __('Couleur principale', 'configurationglpiauto')|e('js') }} " + brandingColorInput.value
      : "{{ __('Aucune', 'configurationglpiauto')|e('js') }}";
  }

  function showStep(n) {
    currentStep = Math.max(1, Math.min(STEP_COUNT, n));
    steps.forEach(function (stepEl) {
      stepEl.style.display = (parseInt(stepEl.dataset.step, 10) === currentStep) ? '' : 'none';
    });
    progressBar.style.width = Math.round((currentStep / STEP_COUNT) * 100) + '%';
    stepIndicator.textContent = "{{ __('Étape', 'configurationglpiauto')|e('js') }} " + currentStep + "/" + STEP_COUNT + " — " + stepLabels[currentStep - 1];
    prevBtn.style.display = currentStep === 1 ? 'none' : '';
    nextBtn.style.display = currentStep === STEP_COUNT ? 'none' : '';
    finishBtn.style.display = currentStep === STEP_COUNT ? '' : 'none';

    if (currentStep === STEP_COUNT) {
      fillSummary();
    }
  }

  prevBtn.addEventListener('click', function () { showStep(currentStep - 1); });
  nextBtn.addEventListener('click', function () { showStep(currentStep + 1); });

  // Profile pre-fill: picking a profile in step 1 suggests a starting point for steps 2-5
  // (entity mode, calendar, SLA) — never entity_tree itself (no realistic way to guess real
  // client/site names) and never overrides anything a profile's defaults don't mention. Purely
  // a suggestion: every field stays a normal input the admin can still change afterward.
  var profileDefaults = {{ profile_defaults|default({})|json_encode|raw }};

  function applyProfileDefaults(profileId) {
    var defaults = profileDefaults[profileId];
    if (!defaults) {
      return;
    }

    if (defaults.entity_mode) {
      var modeRadio = document.getElementById('cga-mode-' + defaults.entity_mode);
      if (modeRadio) {
        modeRadio.checked = true;
        modeRadio.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    if (typeof defaults.calendar_enabled !== 'undefined') {
      calendarEnabledInput.checked = !!defaults.calendar_enabled;
      toggleCalendarFields();
    }
    if (defaults.calendar_days) {
      DAYS.forEach(function (d) {
        var cb = document.getElementById('cga-calendar-day-' + d.value);
        if (cb) {
          cb.checked = defaults.calendar_days.indexOf(d.value) !== -1;
        }
      });
    }
    if (defaults.calendar_begin) {
      document.querySelector('input[name="calendar_begin"]').value = defaults.calendar_begin;
    }
    if (defaults.calendar_end) {
      document.querySelector('input[name="calendar_end"]').value = defaults.calendar_end;
    }

    if (typeof defaults.sla_enabled !== 'undefined') {
      slaEnabledInput.checked = !!defaults.sla_enabled;
      toggleSlaFields();
    }
    if (defaults.sla_tiers) {
      PRIORITY_LEVELS.forEach(function (level) {
        var tier = defaults.sla_tiers[level];
        if (!tier) {
          return;
        }
        var ttoInput = document.querySelector('input[name="sla_tiers[' + level + '][tto_hours]"]');
        var ttrInput = document.querySelector('input[name="sla_tiers[' + level + '][ttr_hours]"]');
        if (ttoInput) {
          ttoInput.value = tier.tto_hours;
        }
        if (ttrInput) {
          ttrInput.value = tier.ttr_hours;
        }
      });
    }
    if (typeof defaults.sla_astreinte !== 'undefined') {
      slaAstreinteInput.checked = !!defaults.sla_astreinte;
    }
  }

  document.querySelectorAll('input[name="configurationprofiles_id"]').forEach(function (radio) {
    radio.addEventListener('change', function () { applyProfileDefaults(radio.value); });
  });

  showStep(1);
})();
</script>
