            </div>
          </div>
        </div>

        <div class="form-check form-switch mb-2">
          <input type="hidden" name="project_task_templates_enabled" value="0">
          <input type="checkbox" name="project_task_templates_enabled" value="1" class="form-check-input" id="cga-project-task-templates-enabled" {{ config.project_task_templates_enabled|default(0) ? 'checked' : '' }}>
          <label class="form-check-label" for="cga-project-task-templates-enabled">{{ __('Créer les gabarits de tâches de projets', 'configurationglpiauto') }}</label>
