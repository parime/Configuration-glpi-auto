  // Per-client/site calendar & SLA (Sprint 13): only meaningful once there's more than one
  // top-level entity to have its own settings, i.e. any multi-entité mode — not mono. Reuses
  // window.cgaTree (same array reference the tree editor in step 2 mutates, see
  // _entity_structure_fields.html.twig) rather than a second data channel kept in sync by index.
  function currentEntityMode() {
    var checked = document.querySelector('input[name="entity_mode"]:checked');
    return checked ? checked.value : 'mono';
  }

  function syncTreeJson() {
    var input = document.getElementById('cga-entity-tree-json');
    if (input) {
      input.value = JSON.stringify(window.cgaTree || []);
    }
  }

  function ensureClientSettings(key, defaults) {
    (window.cgaTree || []).forEach(function (node) {
      node.settings = node.settings || {};
      if (!node.settings[key]) {
        node.settings[key] = Object.assign({}, defaults);
      }
    });
  }

  function stripClientSettings(key) {
    (window.cgaTree || []).forEach(function (node) {
      if (node.settings) {
        delete node.settings[key];
        if (Object.keys(node.settings).length === 0) {
          delete node.settings;
        }
      }
    });
  }

  function anyClientHasSettings(key) {
    return (window.cgaTree || []).some(function (node) {
      return node.settings && node.settings[key];
    });
  }

  function readSharedTiers(fieldPrefix) {
    var tiers = {};
    PRIORITY_LEVELS.forEach(function (level) {
      var ttoInput = document.querySelector('input[name="' + fieldPrefix + '[' + level + '][tto_hours]"]');
      var ttrInput = document.querySelector('input[name="' + fieldPrefix + '[' + level + '][ttr_hours]"]');
      tiers[level] = {
        tto_hours: ttoInput ? (parseInt(ttoInput.value, 10) || 1) : 4,
        ttr_hours: ttrInput ? (parseInt(ttrInput.value, 10) || 1) : 48,
      };
    });
    return tiers;
  }
  function readSharedSlaTiers() { return readSharedTiers('sla_tiers'); }
  function readSharedOlaTiers() { return readSharedTiers('ola_tiers'); }

  function buildTierTable(container, tiers, idPrefix, onChange) {
    container.innerHTML = '';
    var table = document.createElement('table');
    table.className = 'table table-sm';
    table.style.maxWidth = '480px';
    var thead = document.createElement('thead');
    var headRow = document.createElement('tr');
    [
      "{{ __('Priorité', 'configurationglpiauto')|e('js') }}",
      "{{ __('Prise en charge (h)', 'configurationglpiauto')|e('js') }}",
      "{{ __('Résolution (h)', 'configurationglpiauto')|e('js') }}",
    ].forEach(function (text) {
      var th = document.createElement('th');
      th.textContent = text;
      headRow.appendChild(th);
    });
    thead.appendChild(headRow);
    table.appendChild(thead);

    var tbody = document.createElement('tbody');
    PRIORITY_LEVELS.forEach(function (level) {
      var tr = document.createElement('tr');
      var tdLabel = document.createElement('td');
      tdLabel.textContent = PRIORITY_LABELS[level];
      tr.appendChild(tdLabel);

      ['tto_hours', 'ttr_hours'].forEach(function (key) {
        var td = document.createElement('td');
        var inp = document.createElement('input');
        inp.type = 'number';
        inp.min = '1';
        inp.className = 'form-control form-control-sm';
        inp.id = idPrefix + '-' + level + '-' + key;
        inp.value = (tiers[level] && tiers[level][key]) || 1;
        inp.addEventListener('input', function (e) {
          tiers[level] = tiers[level] || {};
          tiers[level][key] = parseInt(e.target.value, 10) || 1;
          onChange();
        });
        td.appendChild(inp);
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    });
    table.appendChild(tbody);
    container.appendChild(table);
  }

  // ---- Calendrier par client/site ----
  var calendarPerClientToggle = document.getElementById('cga-calendar-per-client-toggle');
  var calendarPerClientToggleWrap = document.getElementById('cga-calendar-per-client-toggle-wrap');
