      <div class="mt-4 d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" id="cga-wizard-prev">{{ __('Précédent', 'configurationglpiauto') }}</button>
        <button type="button" class="btn btn-primary" id="cga-wizard-next">{{ __('Suivant', 'configurationglpiauto') }}</button>
        <button
          type="submit"
          name="finish"
          class="btn btn-primary"
          id="cga-wizard-finish"
          style="display: none;"
          onclick="return confirm('{{ __('Ceci va créer/modifier de vraies entités dans GLPI (et, si activés, un calendrier et une personnalisation graphique) selon les choix faits. Continuer ?', 'configurationglpiauto')|e('js') }}');"
        >
          <span id="cga-wizard-finish-label">{{ __('Terminer', 'configurationglpiauto') }}</span>
        </button>
      </div>
    </form>

  </div>
</div>

<script>
(function () {
  var STEP_COUNT = 17;
  var currentStep = 1;
  var steps = document.querySelectorAll('.cga-wizard-step');
  var progressBar = document.getElementById('cga-wizard-progress');
  var stepIndicator = document.getElementById('cga-wizard-stepindicator');
  var prevBtn = document.getElementById('cga-wizard-prev');
  var nextBtn = document.getElementById('cga-wizard-next');
  var finishBtn = document.getElementById('cga-wizard-finish');
  var finishLabel = document.getElementById('cga-wizard-finish-label');
  var wizardForm = document.getElementById('cga-wizard-form');

  // Le traitement serveur (~25 builders séquentiels) prend plusieurs secondes : sans garde, un
  // admin qui ne voit rien se passer peut cliquer une seconde fois. Le jeton CSRF est à usage
  // unique côté GLPI (Session::validateCSRF() le consomme dès sa première validation) — un second
  // clic renverrait donc le même jeton déjà consommé et se ferait rejeter par le pare-feu GLPI
  // (AccessDeniedHttpException brute, avant même que ce plugin ne s'exécute). Désactiver le bouton
  // dès le premier submit réel (après confirm()) empêche mécaniquement cette resoumission.
  wizardForm.addEventListener('submit', function () {
    finishBtn.disabled = true;
    prevBtn.disabled = true;
    nextBtn.disabled = true;
    finishLabel.textContent = "{{ __('Création en cours...', 'configurationglpiauto')|e('js') }}";
  });

  var stepLabels = [
    "{{ __('Profil', 'configurationglpiauto')|e('js') }}",
    "{{ __('Entités', 'configurationglpiauto')|e('js') }}",
    "{{ __('Calendrier', 'configurationglpiauto')|e('js') }}",
    "{{ __('SLA', 'configurationglpiauto')|e('js') }}",
    "{{ __('Catégories', 'configurationglpiauto')|e('js') }}",
    "{{ __('Catalogue de services', 'configurationglpiauto')|e('js') }}",
    "{{ __('Statuts', 'configurationglpiauto')|e('js') }}",
    "{{ __('Raisons d\'attente', 'configurationglpiauto')|e('js') }}",
    "{{ __('Personnalisation', 'configurationglpiauto')|e('js') }}",
    "{{ __('Réglages généraux', 'configurationglpiauto')|e('js') }}",
    "{{ __('Modèles de tickets', 'configurationglpiauto')|e('js') }}",
    "{{ __('Droits LDAP', 'configurationglpiauto')|e('js') }}",
    "{{ __('Tâches & solutions', 'configurationglpiauto')|e('js') }}",
    "{{ __('Suivis & validations', 'configurationglpiauto')|e('js') }}",
    "{{ __('Général & Outils', 'configurationglpiauto')|e('js') }}",
    "{{ __('Projets', 'configurationglpiauto')|e('js') }}",
    "{{ __('Récapitulatif', 'configurationglpiauto')|e('js') }}"
  ];

  var DAYS = [
    { value: 1, label: "{{ __('Lundi')|e('js') }}" },
    { value: 2, label: "{{ __('Mardi')|e('js') }}" },
    { value: 3, label: "{{ __('Mercredi')|e('js') }}" },
    { value: 4, label: "{{ __('Jeudi')|e('js') }}" },
    { value: 5, label: "{{ __('Vendredi')|e('js') }}" },
    { value: 6, label: "{{ __('Samedi')|e('js') }}" },
    { value: 0, label: "{{ __('Dimanche')|e('js') }}" }
  ];
  var initialCalendarDays = {{ config.calendar_days|default('[1,2,3,4,5]')|raw }};

  var PRIORITY_LEVELS = {{ priority_levels|json_encode|raw }};
  var PRIORITY_LABELS = {{ priority_labels|json_encode|raw }};

  var calendarEnabledInput = document.getElementById('cga-calendar-enabled');
  var calendarFields = document.getElementById('cga-calendar-fields');
  var calendarDaysContainer = document.getElementById('cga-calendar-days');

  DAYS.forEach(function (day) {
    var wrapper = document.createElement('div');
    wrapper.className = 'form-check form-check-inline';
    var input = document.createElement('input');
    input.type = 'checkbox';
    input.name = 'calendar_day[]';
    input.value = day.value;
    input.className = 'form-check-input';
    input.id = 'cga-calendar-day-' + day.value;
    input.checked = initialCalendarDays.indexOf(day.value) !== -1;
    var label = document.createElement('label');
    label.className = 'form-check-label';
    label.setAttribute('for', input.id);
    label.textContent = day.label;
    wrapper.appendChild(input);
    wrapper.appendChild(label);
    calendarDaysContainer.appendChild(wrapper);
  });

  function toggleCalendarFields() {
    calendarFields.style.display = calendarEnabledInput.checked ? '' : 'none';
  }
  calendarEnabledInput.addEventListener('change', toggleCalendarFields);
  toggleCalendarFields();

  var slaEnabledInput = document.getElementById('cga-sla-enabled');
  var slaFields = document.getElementById('cga-sla-fields');
  var slaAstreinteInput = document.getElementById('cga-sla-astreinte');
  function toggleSlaFields() {
    slaFields.style.display = slaEnabledInput.checked ? '' : 'none';
  }
  slaEnabledInput.addEventListener('change', toggleSlaFields);
  toggleSlaFields();

  var olaEnabledInput = document.getElementById('cga-ola-enabled');
  var olaFields = document.getElementById('cga-ola-fields');
  function toggleOlaFields() {
    olaFields.style.display = olaEnabledInput.checked ? '' : 'none';
  }
  olaEnabledInput.addEventListener('change', toggleOlaFields);
  toggleOlaFields();

  var slaEscalationEnabledInput = document.getElementById('cga-sla-escalation-enabled');
  var slaEscalationFields = document.getElementById('cga-sla-escalation-fields');
  function toggleSlaEscalationFields() {
    slaEscalationFields.style.display = slaEscalationEnabledInput.checked ? '' : 'none';
  }
  slaEscalationEnabledInput.addEventListener('change', toggleSlaEscalationFields);
  toggleSlaEscalationFields();

  var categoryEnabledInput = document.getElementById('cga-category-enabled');
  var categoryFields = document.getElementById('cga-category-fields');
  var categoryIconsEnabledInput = document.getElementById('cga-category-icons-enabled');
  var categoryPreviewIcons = document.querySelectorAll('.cga-category-tree-icon');
  var categoryBranchToggles = document.querySelectorAll('.cga-category-branch-toggle');
  function toggleCategoryFields() {
    categoryFields.style.display = categoryEnabledInput.checked ? '' : 'none';
  }
  function toggleCategoryIcons() {
    categoryPreviewIcons.forEach(function (icon) {
      icon.style.display = categoryIconsEnabledInput.checked ? '' : 'none';
    });
  }
  function toggleCategoryBranchPreview(toggle) {
    var preview = document.querySelector('.cga-category-branch-preview[data-branch="' + toggle.dataset.branch + '"]');
    if (preview) {
      preview.style.display = toggle.checked ? '' : 'none';
    }
    var servicePreview = document.querySelector('.cga-service-branch-preview[data-branch="' + toggle.dataset.branch + '"]');
    if (servicePreview) {
      servicePreview.style.display = toggle.checked ? '' : 'none';
    }
    var kbPreview = document.querySelector('.cga-kb-branch-preview[data-branch="' + toggle.dataset.branch + '"]');
    if (kbPreview) {
      kbPreview.style.display = toggle.checked ? '' : 'none';
    }
  }
  categoryEnabledInput.addEventListener('change', toggleCategoryFields);
  categoryIconsEnabledInput.addEventListener('change', toggleCategoryIcons);
  categoryBranchToggles.forEach(function (toggle) {
    toggle.addEventListener('change', function () { toggleCategoryBranchPreview(toggle); });
    toggleCategoryBranchPreview(toggle);
  });
  toggleCategoryFields();
  toggleCategoryIcons();

  var serviceCatalogEnabledInput = document.getElementById('cga-service-catalog-enabled');
  var serviceCatalogFields = document.getElementById('cga-service-catalog-fields');
  function toggleServiceCatalogFields() {
    serviceCatalogFields.style.display = serviceCatalogEnabledInput.checked ? '' : 'none';
  }
  serviceCatalogEnabledInput.addEventListener('change', toggleServiceCatalogFields);
  toggleServiceCatalogFields();

  var stateEnabledInput = document.getElementById('cga-state-enabled');
  var stateFields = document.getElementById('cga-state-fields');
  var stateIconsEnabledInput = document.getElementById('cga-state-icons-enabled');
  var statePreviewIcons = document.querySelectorAll('.cga-state-preview-icon');
  function toggleStateFields() {
    stateFields.style.display = stateEnabledInput.checked ? '' : 'none';
  }
  function toggleStateIcons() {
    statePreviewIcons.forEach(function (icon) {
      icon.style.display = stateIconsEnabledInput.checked ? '' : 'none';
    });
  }
  stateEnabledInput.addEventListener('change', toggleStateFields);
  stateIconsEnabledInput.addEventListener('change', toggleStateIcons);
  toggleStateFields();
  toggleStateIcons();

  var waitReasonsEnabledInput = document.getElementById('cga-wait-reasons-enabled');
  var waitReasonsFields = document.getElementById('cga-wait-reasons-fields');
  function toggleWaitReasonsFields() {
    waitReasonsFields.style.display = waitReasonsEnabledInput.checked ? '' : 'none';
  }
  waitReasonsEnabledInput.addEventListener('change', toggleWaitReasonsFields);
  wireIconsToggle('cga-wait-reason-icons-enabled', '.cga-wait-reason-icon');
  toggleWaitReasonsFields();

  var brandingEnabledInput = document.getElementById('cga-branding-enabled');
  var brandingFields = document.getElementById('cga-branding-fields');
  var brandingColorInput = document.getElementById('cga-branding-color');
  var brandingPreviewHeader = document.getElementById('cga-branding-preview-header');
  var brandingPreviewBtn = document.getElementById('cga-branding-preview-btn');
  var brandingPreviewLogo = document.getElementById('cga-branding-preview-logo');
  var brandingPreviewCaption = document.getElementById('cga-branding-preview-caption');

  function toggleBrandingFields() {
    brandingFields.style.display = brandingEnabledInput.checked ? 'flex' : 'none';
  }
  // Mini simulation de l'en-tête GLPI (.glpi-logo, --tblr-primary) — met à jour la couleur en
  // direct depuis le sélecteur, sans attendre la soumission du formulaire.
  function updatePreview() {
    brandingPreviewHeader.style.backgroundColor = brandingColorInput.value;
    brandingPreviewBtn.style.backgroundColor = '#fff';
    brandingPreviewBtn.style.color = brandingColorInput.value;
    brandingPreviewBtn.style.border = 'none';
  }
  brandingEnabledInput.addEventListener('change', toggleBrandingFields);
  brandingColorInput.addEventListener('input', updatePreview);
  toggleBrandingFields();
  updatePreview();

  var entityLogosEnabledInput = document.getElementById('cga-entity-logos-enabled');
  var entityLogosFields = document.getElementById('cga-entity-logos-fields');
  var entityLogosPanels = document.getElementById('cga-entity-logos-panels');
  function toggleEntityLogosFields() {
    entityLogosFields.style.display = entityLogosEnabledInput.checked ? '' : 'none';
  }
  entityLogosEnabledInput.addEventListener('change', toggleEntityLogosFields);
  toggleEntityLogosFields();

  // One file input per top-level entity (or a single one for mono-entité/empty tree, matching
  // entities_id=0 fallback) — named by index, matching how front/wizard.php pairs
  // EntityBuilder::topEntityIds() (same order as this array) with $_FILES['entity_logo_N'].
  // Re-rendered whenever the branding step is shown so it always reflects the current tree; a
  // previously-chosen file is lost on re-render (native <input type="file"> can't be repopulated
  // programmatically anyway, same limitation any tree edit would cause).
  function renderEntityLogoPanels() {
    var tree = (window.cgaTree || []);
    var nodes = tree.length ? tree : [{ name: "{{ __('Entité racine', 'configurationglpiauto')|e('js') }}" }];
    entityLogosPanels.innerHTML = '';
    nodes.forEach(function (node, i) {
      var wrapper = document.createElement('div');
      wrapper.className = 'mb-2';
      var label = document.createElement('label');
      label.className = 'form-label mb-1';
      label.textContent = node.name || "{{ __('(sans nom)', 'configurationglpiauto')|e('js') }}";
      var input = document.createElement('input');
      input.type = 'file';
      input.name = 'entity_logo_' + i;
      input.accept = 'image/png,image/jpeg,image/webp,image/gif';
      input.className = 'form-control form-control-sm';
      // Aperçu instantané côté client (FileReader), indépendant de la conversion en data URI
      // faite côté serveur à la soumission (front/wizard.php) — juste pour visualiser le choix
      // avant d'envoyer le formulaire.
      input.addEventListener('change', function () {
        var file = input.files && input.files[0];
        if (!file) {
          return;
        }
        var reader = new FileReader();
        reader.onload = function () {
          brandingPreviewLogo.style.backgroundImage = 'url(' + reader.result + ')';
          brandingPreviewCaption.textContent = "{{ __('Aperçu :', 'configurationglpiauto')|e('js') }} " + (node.name || "{{ __('(sans nom)', 'configurationglpiauto')|e('js') }}");
        };
        reader.readAsDataURL(file);
      });
      wrapper.appendChild(label);
      wrapper.appendChild(input);
      entityLogosPanels.appendChild(wrapper);
    });
  }

  var generalSettingsGroupInputs = document.querySelectorAll('.cga-general-settings-group');
  var generalSettingsSelectAll = document.getElementById('cga-general-settings-select-all');
  function syncGeneralSettingsSelectAll() {
    var checkedCount = 0;
    generalSettingsGroupInputs.forEach(function (input) { if (input.checked) { checkedCount++; } });
    generalSettingsSelectAll.checked = checkedCount === generalSettingsGroupInputs.length;
    generalSettingsSelectAll.indeterminate = checkedCount > 0 && checkedCount < generalSettingsGroupInputs.length;
  }
  generalSettingsGroupInputs.forEach(function (input) {
    input.addEventListener('change', syncGeneralSettingsSelectAll);
  });
  generalSettingsSelectAll.addEventListener('change', function () {
    generalSettingsGroupInputs.forEach(function (input) { input.checked = generalSettingsSelectAll.checked; });
    generalSettingsSelectAll.indeterminate = false;
  });
  syncGeneralSettingsSelectAll();

  var ticketTemplateEnabledInput = document.getElementById('cga-ticket-template-enabled');
  var ticketTemplateFields = document.getElementById('cga-ticket-template-fields');
  var helpdeskFormHideFieldsInput = document.getElementById('cga-helpdesk-form-hide-fields');
  function toggleTicketTemplateFields() {
    ticketTemplateFields.style.display = ticketTemplateEnabledInput.checked ? '' : 'none';
  }
  ticketTemplateEnabledInput.addEventListener('change', toggleTicketTemplateFields);
  toggleTicketTemplateFields();

  var ldapRightsEnabledInput = document.getElementById('cga-ldap-rights-enabled');
  var ldapRightsFields = document.getElementById('cga-ldap-rights-fields');
  var ldapRightsTemplateInput = document.getElementById('cga-ldap-rights-template');
  var ldapRightsProfileInput = document.getElementById('cga-ldap-rights-profile');
  var ldapRightsPreviewList = document.getElementById('cga-ldap-rights-preview');
  function toggleLdapRightsFields() {
    ldapRightsFields.style.display = ldapRightsEnabledInput.checked ? '' : 'none';
  }
  function collectLeafEntityNames(nodes) {
    var names = [];
    (nodes || []).forEach(function (node) {
      if (!node.name) { return; }
      if (node.children && node.children.length) {
        names = names.concat(collectLeafEntityNames(node.children));
      } else {
        names.push(node.name);
      }
    });
    return names;
  }
  function updateLdapRightsPreview() {
    var template = ldapRightsTemplateInput.value || 'GLPI_{ENTITY}';
    var leaves = collectLeafEntityNames(window.cgaTree || []);
    ldapRightsPreviewList.innerHTML = '';
    if (template.indexOf('{ENTITY}') === -1 || leaves.length === 0) {
      var empty = document.createElement('li');
      empty.className = 'list-group-item text-muted';
      empty.textContent = leaves.length === 0
        ? "{{ __('Aucun site dans l\'arborescence (étape 2) — rien à générer.', 'configurationglpiauto')|e('js') }}"
        : "{{ __('Le gabarit doit contenir {ENTITY}.', 'configurationglpiauto')|e('js') }}";
      ldapRightsPreviewList.appendChild(empty);
      return;
    }
    leaves.forEach(function (name) {
      var group = template.replace('{ENTITY}', name.replace(/ /g, '_'));
      var li = document.createElement('li');
      li.className = 'list-group-item';
      li.textContent = name + ' — ' + group;
      ldapRightsPreviewList.appendChild(li);
    });
  }
  ldapRightsEnabledInput.addEventListener('change', toggleLdapRightsFields);
  ldapRightsTemplateInput.addEventListener('input', updateLdapRightsPreview);
  ldapRightsProfileInput.addEventListener('change', updateLdapRightsPreview);
  toggleLdapRightsFields();

  function wireSimpleToggle(checkboxId, fieldsId) {
    var checkbox = document.getElementById(checkboxId);
    var fields = document.getElementById(fieldsId);
    function toggle() {
      fields.style.display = checkbox.checked ? '' : 'none';
    }
    checkbox.addEventListener('change', toggle);
    toggle();
    return checkbox;
  }

  // Générique pour tout toggle "icônes" qui bascule la visibilité de spans .cga-xxx-icon dans un
  // aperçu déjà rendu côté serveur — même pattern que toggleStateIcons() ci-dessus, factorisé pour
  // les autres intitulés à icônes (fabricants, raisons d'attente, types de projet, types de
  // solution) plutôt que dupliqué une fois par builder.
  function wireIconsToggle(checkboxId, iconSelector) {
    var checkbox = document.getElementById(checkboxId);
    var icons = document.querySelectorAll(iconSelector);
    function toggle() {
      icons.forEach(function (icon) { icon.style.display = checkbox.checked ? '' : 'none'; });
    }
    checkbox.addEventListener('change', toggle);
    toggle();
  }

  var taskCategoriesEnabledInput = wireSimpleToggle('cga-task-categories-enabled', 'cga-task-categories-fields');
  var taskTemplatesEnabledInput = wireSimpleToggle('cga-task-templates-enabled', 'cga-task-templates-fields');
  var solutionLibraryEnabledInput = wireSimpleToggle('cga-solution-library-enabled', 'cga-solution-library-fields');
  wireIconsToggle('cga-solution-type-icons-enabled', '.cga-solution-type-icon');
  var followupLibraryEnabledInput = wireSimpleToggle('cga-followup-library-enabled', 'cga-followup-library-fields');
  var validationTemplatesEnabledInput = wireSimpleToggle('cga-validation-templates-enabled', 'cga-validation-templates-fields');
  var changeProblemTemplatesEnabledInput = document.getElementById('cga-change-problem-templates-enabled');
  var locationsEnabledInput = wireSimpleToggle('cga-locations-enabled', 'cga-locations-fields');
  var manufacturersEnabledInput = wireSimpleToggle('cga-manufacturers-enabled', 'cga-manufacturers-fields');
  wireIconsToggle('cga-manufacturer-icons-enabled', '.cga-manufacturer-icon');
  var kbCategoriesEnabledInput = document.getElementById('cga-kb-categories-enabled');
  var kbCategoriesFields = document.getElementById('cga-kb-categories-fields');
  function toggleKbCategoriesFields() {
    kbCategoriesFields.style.display = kbCategoriesEnabledInput.checked ? '' : 'none';
  }
  kbCategoriesEnabledInput.addEventListener('change', toggleKbCategoriesFields);
  toggleKbCategoriesFields();

  var projectTaxonomyEnabledInput = wireSimpleToggle('cga-project-taxonomy-enabled', 'cga-project-taxonomy-fields');
  wireIconsToggle('cga-project-taxonomy-icons-enabled', '.cga-project-taxonomy-icon');
  var projectTaskTemplatesEnabledInput = wireSimpleToggle('cga-project-task-templates-enabled', 'cga-project-task-templates-fields');

  // Per-client/site calendar & SLA (Sprint 13): only meaningful once there's more than one
  // top-level entity to have its own settings, i.e. any multi-entité mode — not mono. Reuses
  // window.cgaTree (same array reference the tree editor in step 2 mutates, see
  // _entity_structure_fields.html.twig) rather than a second data channel kept in sync by index.
  function currentEntityMode() {
    var checked = document.querySelector('input[name="entity_mode"]:checked');
    return checked ? checked.value : 'mono';
  }

  function syncTreeJson() {
    var input = document.getElementById('cga-entity-tree-json');
    if (input) {
      input.value = JSON.stringify(window.cgaTree || []);
    }
  }

  function ensureClientSettings(key, defaults) {
    (window.cgaTree || []).forEach(function (node) {
      node.settings = node.settings || {};
      if (!node.settings[key]) {
        node.settings[key] = Object.assign({}, defaults);
      }
    });
  }

  function stripClientSettings(key) {
    (window.cgaTree || []).forEach(function (node) {
      if (node.settings) {
        delete node.settings[key];
        if (Object.keys(node.settings).length === 0) {
          delete node.settings;
        }
      }
    });
  }

  function anyClientHasSettings(key) {
    return (window.cgaTree || []).some(function (node) {
      return node.settings && node.settings[key];
    });
  }

  function buildDayCheckboxes(container, selectedDays, idPrefix, onChange) {
    container.innerHTML = '';
    DAYS.forEach(function (day) {
      var wrapper = document.createElement('div');
      wrapper.className = 'form-check form-check-inline';
      var input = document.createElement('input');
      input.type = 'checkbox';
      input.className = 'form-check-input';
      input.id = idPrefix + '-day-' + day.value;
      input.checked = selectedDays.indexOf(day.value) !== -1;
      input.addEventListener('change', onChange);
      var label = document.createElement('label');
      label.className = 'form-check-label';
      label.setAttribute('for', input.id);
      label.textContent = day.label;
      wrapper.appendChild(input);
      wrapper.appendChild(label);
      container.appendChild(wrapper);
    });
  }

  function readSharedTiers(fieldPrefix) {
    var tiers = {};
    PRIORITY_LEVELS.forEach(function (level) {
      var ttoInput = document.querySelector('input[name="' + fieldPrefix + '[' + level + '][tto_hours]"]');
      var ttrInput = document.querySelector('input[name="' + fieldPrefix + '[' + level + '][ttr_hours]"]');
      tiers[level] = {
        tto_hours: ttoInput ? (parseInt(ttoInput.value, 10) || 1) : 4,
        ttr_hours: ttrInput ? (parseInt(ttrInput.value, 10) || 1) : 48,
      };
    });
    return tiers;
  }
  function readSharedSlaTiers() { return readSharedTiers('sla_tiers'); }
  function readSharedOlaTiers() { return readSharedTiers('ola_tiers'); }

  function buildTierTable(container, tiers, idPrefix, onChange) {
    container.innerHTML = '';
    var table = document.createElement('table');
    table.className = 'table table-sm';
    table.style.maxWidth = '480px';
    var thead = document.createElement('thead');
    var headRow = document.createElement('tr');
    [
      "{{ __('Priorité', 'configurationglpiauto')|e('js') }}",
      "{{ __('Prise en charge (h)', 'configurationglpiauto')|e('js') }}",
      "{{ __('Résolution (h)', 'configurationglpiauto')|e('js') }}",
    ].forEach(function (text) {
      var th = document.createElement('th');
      th.textContent = text;
      headRow.appendChild(th);
    });
    thead.appendChild(headRow);
    table.appendChild(thead);

    var tbody = document.createElement('tbody');
    PRIORITY_LEVELS.forEach(function (level) {
      var tr = document.createElement('tr');
      var tdLabel = document.createElement('td');
      tdLabel.textContent = PRIORITY_LABELS[level];
      tr.appendChild(tdLabel);

      ['tto_hours', 'ttr_hours'].forEach(function (key) {
        var td = document.createElement('td');
        var inp = document.createElement('input');
        inp.type = 'number';
        inp.min = '1';
        inp.className = 'form-control form-control-sm';
        inp.id = idPrefix + '-' + level + '-' + key;
        inp.value = (tiers[level] && tiers[level][key]) || 1;
        inp.addEventListener('input', function (e) {
          tiers[level] = tiers[level] || {};
          tiers[level][key] = parseInt(e.target.value, 10) || 1;
          onChange();
        });
        td.appendChild(inp);
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    });
    table.appendChild(tbody);
    container.appendChild(table);
  }

  // ---- Calendrier par client/site ----
  var calendarPerClientToggle = document.getElementById('cga-calendar-per-client-toggle');
  var calendarPerClientToggleWrap = document.getElementById('cga-calendar-per-client-toggle-wrap');
  var calendarSharedSection = document.getElementById('cga-calendar-shared-section');
  var calendarPerClientPanels = document.getElementById('cga-calendar-per-client-panels');

  function renderCalendarPerClientPanels() {
    calendarPerClientPanels.innerHTML = '';
    (window.cgaTree || []).forEach(function (node, i) {
      var settings = (node.settings && node.settings.calendar) || { enabled: false, days: [1, 2, 3, 4, 5], begin: '08:00', end: '18:00' };

      var card = document.createElement('div');
      card.className = 'card mb-2';
      var body = document.createElement('div');
      body.className = 'card-body';

      var title = document.createElement('h4');
      title.className = 'mb-2';
      title.textContent = node.name || "{{ __('(sans nom)', 'configurationglpiauto')|e('js') }}";
      body.appendChild(title);

      var switchWrap = document.createElement('div');
      switchWrap.className = 'form-check form-switch mb-2';
      var enabledInput = document.createElement('input');
      enabledInput.type = 'checkbox';
      enabledInput.className = 'form-check-input';
      enabledInput.id = 'cga-cal-pc-' + i + '-enabled';
      enabledInput.checked = !!settings.enabled;
      var enabledLabel = document.createElement('label');
      enabledLabel.className = 'form-check-label';
      enabledLabel.setAttribute('for', enabledInput.id);
      enabledLabel.textContent = "{{ __('Créer un calendrier pour cette entité', 'configurationglpiauto')|e('js') }}";
      switchWrap.appendChild(enabledInput);
      switchWrap.appendChild(enabledLabel);
      body.appendChild(switchWrap);

      var fieldsWrap = document.createElement('div');
      fieldsWrap.style.display = settings.enabled ? '' : 'none';

      function writeBack() {
        node.settings = node.settings || {};
        settings.enabled = enabledInput.checked;
        node.settings.calendar = settings;
        syncTreeJson();
      }

      var daysLabel = document.createElement('label');
      daysLabel.className = 'form-label d-block';
      daysLabel.textContent = "{{ __('Jours ouvrés', 'configurationglpiauto')|e('js') }}";
      fieldsWrap.appendChild(daysLabel);
      var daysContainer = document.createElement('div');
      daysContainer.className = 'mb-2';
      fieldsWrap.appendChild(daysContainer);
      buildDayCheckboxes(daysContainer, settings.days, 'cga-cal-pc-' + i, function () {
        settings.days = DAYS.filter(function (d) {
          return document.getElementById('cga-cal-pc-' + i + '-day-' + d.value).checked;
        }).map(function (d) { return d.value; });
        writeBack();
      });

      var row = document.createElement('div');
      row.className = 'row';
      row.style.maxWidth = '320px';
      [
        ["{{ __('Ouverture', 'configurationglpiauto')|e('js') }}", 'begin'],
        ["{{ __('Fermeture', 'configurationglpiauto')|e('js') }}", 'end'],
      ].forEach(function (pair) {
        var col = document.createElement('div');
        col.className = 'col mb-2';
        var lbl = document.createElement('label');
        lbl.className = 'form-label';
        lbl.textContent = pair[0];
        var inp = document.createElement('input');
        inp.type = 'time';
        inp.className = 'form-control';
        inp.value = settings[pair[1]];
        inp.addEventListener('input', function (e) {
          settings[pair[1]] = e.target.value;
          writeBack();
        });
        col.appendChild(lbl);
        col.appendChild(inp);
        row.appendChild(col);
      });
      fieldsWrap.appendChild(row);
      body.appendChild(fieldsWrap);

      enabledInput.addEventListener('change', function () {
        fieldsWrap.style.display = enabledInput.checked ? '' : 'none';
        writeBack();
      });

      card.appendChild(body);
      calendarPerClientPanels.appendChild(card);
    });
  }

  function updateCalendarMode() {
    var multiEntity = currentEntityMode() !== 'mono';
    calendarPerClientToggleWrap.style.display = multiEntity ? '' : 'none';
    if (!multiEntity && calendarPerClientToggle.checked) {
      calendarPerClientToggle.checked = false;
    }

    var perClient = multiEntity && calendarPerClientToggle.checked;
    calendarSharedSection.style.display = perClient ? 'none' : '';
    calendarPerClientPanels.style.display = perClient ? '' : 'none';

    if (perClient) {
      ensureClientSettings('calendar', { enabled: false, days: [1, 2, 3, 4, 5], begin: '08:00', end: '18:00' });
      renderCalendarPerClientPanels();
    } else {
      stripClientSettings('calendar');
    }
    syncTreeJson();
  }
  calendarPerClientToggle.addEventListener('change', updateCalendarMode);

  // ---- SLA par client/site ----
  var slaPerClientToggle = document.getElementById('cga-sla-per-client-toggle');
  var slaPerClientToggleWrap = document.getElementById('cga-sla-per-client-toggle-wrap');
  var slaSharedSection = document.getElementById('cga-sla-shared-section');
  var slaPerClientPanels = document.getElementById('cga-sla-per-client-panels');

  function renderSlaPerClientPanels() {
    slaPerClientPanels.innerHTML = '';
    (window.cgaTree || []).forEach(function (node, i) {
      var hasOverride = !!(node.settings && node.settings.sla);
      var settings = (node.settings && node.settings.sla) || { enabled: false, astreinte: false, tiers: {}, ola_enabled: false, ola_tiers: {} };

      var card = document.createElement('div');
      card.className = 'card mb-2';
      var body = document.createElement('div');
      body.className = 'card-body';

      var title = document.createElement('h4');
      title.className = 'mb-2';
      title.textContent = node.name || "{{ __('(sans nom)', 'configurationglpiauto')|e('js') }}";
      body.appendChild(title);

      // "Utiliser le SLA par défaut" (coché par défaut) : ce client suit le tableau partagé,
      // rien n'est stocké pour lui (même principe que le repli Sprint 13). Décoché : tableau à 6
      // niveaux propre à ce client, pré-rempli avec les valeurs actuelles du tableau partagé —
      // un point de départ, pas des champs vides.
      var useDefaultWrap = document.createElement('div');
      useDefaultWrap.className = 'form-check form-switch mb-2';
      var useDefaultInput = document.createElement('input');
      useDefaultInput.type = 'checkbox';
      useDefaultInput.className = 'form-check-input';
      useDefaultInput.id = 'cga-sla-pc-' + i + '-usedefault';
      useDefaultInput.checked = !hasOverride;
      var useDefaultLabel = document.createElement('label');
      useDefaultLabel.className = 'form-check-label';
      useDefaultLabel.setAttribute('for', useDefaultInput.id);
      useDefaultLabel.textContent = "{{ __('Utiliser le SLA par défaut', 'configurationglpiauto')|e('js') }}";
      useDefaultWrap.appendChild(useDefaultInput);
      useDefaultWrap.appendChild(useDefaultLabel);
      body.appendChild(useDefaultWrap);

      var customWrap = document.createElement('div');
      customWrap.style.display = hasOverride ? '' : 'none';

      var enabledWrap = document.createElement('div');
      enabledWrap.className = 'form-check form-switch mb-2';
      var enabledInput = document.createElement('input');
      enabledInput.type = 'checkbox';
      enabledInput.className = 'form-check-input';
      enabledInput.id = 'cga-sla-pc-' + i + '-enabled';
      enabledInput.checked = !!settings.enabled;
      var enabledLabel = document.createElement('label');
      enabledLabel.className = 'form-check-label';
      enabledLabel.setAttribute('for', enabledInput.id);
      enabledLabel.textContent = "{{ __('Créer un SLA pour cette entité', 'configurationglpiauto')|e('js') }}";
      enabledWrap.appendChild(enabledInput);
      enabledWrap.appendChild(enabledLabel);
      customWrap.appendChild(enabledWrap);

      var fieldsWrap = document.createElement('div');
      fieldsWrap.style.display = settings.enabled ? '' : 'none';

      function writeBack() {
        node.settings = node.settings || {};
        settings.enabled = enabledInput.checked;
        node.settings.sla = settings;
        syncTreeJson();
      }

      var tiersContainer = document.createElement('div');
      fieldsWrap.appendChild(tiersContainer);
      buildTierTable(tiersContainer, settings.tiers, 'cga-sla-pc-' + i, writeBack);

      var astreinteWrap = document.createElement('div');
      astreinteWrap.className = 'form-check form-switch mb-2 mt-2';
      var astreinteInput = document.createElement('input');
      astreinteInput.type = 'checkbox';
      astreinteInput.className = 'form-check-input';
      astreinteInput.id = 'cga-sla-pc-' + i + '-astreinte';
      astreinteInput.checked = !!settings.astreinte;
      astreinteInput.addEventListener('change', function () {
        settings.astreinte = astreinteInput.checked;
        writeBack();
      });
      var astreinteLabel = document.createElement('label');
      astreinteLabel.className = 'form-check-label';
      astreinteLabel.setAttribute('for', astreinteInput.id);
      astreinteLabel.textContent = "{{ __('Astreinte (24h/24, 7j/7)', 'configurationglpiauto')|e('js') }}";
      astreinteWrap.appendChild(astreinteInput);
      astreinteWrap.appendChild(astreinteLabel);
      fieldsWrap.appendChild(astreinteWrap);

      var olaWrap = document.createElement('div');
      olaWrap.className = 'form-check form-switch mb-2';
      var olaInput = document.createElement('input');
      olaInput.type = 'checkbox';
      olaInput.className = 'form-check-input';
      olaInput.id = 'cga-sla-pc-' + i + '-ola-enabled';
      olaInput.checked = !!settings.ola_enabled;
      var olaLabel = document.createElement('label');
      olaLabel.className = 'form-check-label';
      olaLabel.setAttribute('for', olaInput.id);
      olaLabel.textContent = "{{ __('Ajouter des engagements internes (OLA)', 'configurationglpiauto')|e('js') }}";
      olaWrap.appendChild(olaInput);
      olaWrap.appendChild(olaLabel);
      fieldsWrap.appendChild(olaWrap);

      var olaTiersContainer = document.createElement('div');
      olaTiersContainer.style.display = settings.ola_enabled ? '' : 'none';
      fieldsWrap.appendChild(olaTiersContainer);
      buildTierTable(olaTiersContainer, settings.ola_tiers, 'cga-sla-pc-' + i + '-ola', function () {
        settings.ola_enabled = olaInput.checked;
        writeBack();
      });

      olaInput.addEventListener('change', function () {
        settings.ola_enabled = olaInput.checked;
        olaTiersContainer.style.display = olaInput.checked ? '' : 'none';
        writeBack();
      });

      customWrap.appendChild(fieldsWrap);
      body.appendChild(customWrap);

      enabledInput.addEventListener('change', function () {
        fieldsWrap.style.display = enabledInput.checked ? '' : 'none';
        writeBack();
      });

      useDefaultInput.addEventListener('change', function () {
        if (useDefaultInput.checked) {
          if (node.settings) {
            delete node.settings.sla;
            if (Object.keys(node.settings).length === 0) {
              delete node.settings;
            }
          }
          syncTreeJson();
          customWrap.style.display = 'none';
        } else {
          node.settings = node.settings || {};
          node.settings.sla = {
            enabled: false,
            astreinte: false,
            tiers: readSharedSlaTiers(),
            ola_enabled: false,
            ola_tiers: readSharedOlaTiers(),
          };
          syncTreeJson();
          renderSlaPerClientPanels();
        }
      });

      card.appendChild(body);
      slaPerClientPanels.appendChild(card);
    });
  }

  function updateSlaMode() {
    var multiEntity = currentEntityMode() !== 'mono';
    slaPerClientToggleWrap.style.display = multiEntity ? '' : 'none';
    if (!multiEntity && slaPerClientToggle.checked) {
      slaPerClientToggle.checked = false;
    }

    var perClient = multiEntity && slaPerClientToggle.checked;
    slaSharedSection.style.display = perClient ? 'none' : '';
    slaPerClientPanels.style.display = perClient ? '' : 'none';

    if (perClient) {
      // Unlike calendar, no ensureClientSettings() here: a client defaults to "use the shared
      // SLA table" (no settings.sla stored at all) until it explicitly opts out via its own
      // "Utiliser le SLA par défaut" checkbox (see renderSlaPerClientPanels()) — the per-client
      // mode toggle alone shouldn't force every client into a custom table.
      renderSlaPerClientPanels();
    } else {
      stripClientSettings('sla');
    }
    syncTreeJson();
  }
  slaPerClientToggle.addEventListener('change', updateSlaMode);

  // Tree changes (add/remove/rename a node, or switch entity_mode) come from step 2's script —
  // re-derive both panels' visibility/content from the live window.cgaTree reference.
  document.addEventListener('cga:tree-changed', function () {
    updateCalendarMode();
    updateSlaMode();
  });

  // Reloading a config that already has per-client settings saved: default the toggle to ON
  // instead of stripping data the admin already entered in an earlier pass.
  calendarPerClientToggle.checked = anyClientHasSettings('calendar');
  slaPerClientToggle.checked = anyClientHasSettings('sla');
  updateCalendarMode();
  updateSlaMode();

  function fillSummary() {
    var profileInput = document.querySelector('input[name="configurationprofiles_id"]:checked');
    var profileLabel = profileInput
      ? profileInput.closest('.form-check').querySelector('label').textContent.trim()
      : "{{ __('Aucun', 'configurationglpiauto')|e('js') }}";
    document.getElementById('cga-summary-profile').textContent = profileLabel;

    var modeInput = document.querySelector('input[name="entity_mode"]:checked');
    var modeLabel = modeInput
      ? modeInput.closest('.form-check').querySelector('label').textContent.trim()
      : '';
    document.getElementById('cga-summary-mode').textContent = modeLabel;

    var preview = document.getElementById('cga-tree-preview');
    document.getElementById('cga-summary-tree').innerHTML = preview ? preview.innerHTML : '';

    var calendarSummary;
    if (calendarPerClientToggle.checked) {
      var calPcCount = (window.cgaTree || []).filter(function (n) { return n.settings && n.settings.calendar && n.settings.calendar.enabled; }).length;
      calendarSummary = calPcCount + ' ' + "{{ __('site(s)/client(s) avec un calendrier propre', 'configurationglpiauto')|e('js') }}";
    } else if (!calendarEnabledInput.checked) {
      calendarSummary = "{{ __('Aucun', 'configurationglpiauto')|e('js') }}";
    } else {
      var checkedDays = DAYS.filter(function (d) {
        return document.getElementById('cga-calendar-day-' + d.value).checked;
      }).map(function (d) { return d.label; });
      var name = document.querySelector('input[name="calendar_name"]').value || "{{ __('Horaires standard', 'configurationglpiauto')|e('js') }}";
      var begin = document.querySelector('input[name="calendar_begin"]').value;
      var end = document.querySelector('input[name="calendar_end"]').value;
      calendarSummary = name + ' — ' + checkedDays.join(', ') + ' — ' + begin + '-' + end
        + (document.getElementById('cga-calendar-holidays-enabled').checked ? ' + ' + "{{ __('jours fériés', 'configurationglpiauto')|e('js') }}" : '');
    }
    document.getElementById('cga-summary-calendar').textContent = calendarSummary;

    var slaEscalationSuffix = slaEscalationEnabledInput.checked
      ? (" — {{ __('escalade à', 'configurationglpiauto')|e('js') }} " + document.getElementById('cga-sla-escalation-threshold').value + '%')
      : '';
    if (slaPerClientToggle.checked) {
      var slaPcCount = (window.cgaTree || []).filter(function (n) { return n.settings && n.settings.sla && n.settings.sla.enabled; }).length;
      document.getElementById('cga-summary-sla').textContent = slaPcCount + ' ' + "{{ __('site(s)/client(s) avec un SLA propre', 'configurationglpiauto')|e('js') }}" + slaEscalationSuffix;
    } else if (!slaEnabledInput.checked) {
      document.getElementById('cga-summary-sla').textContent = "{{ __('Aucun', 'configurationglpiauto')|e('js') }}";
    } else {
      var tiers = readSharedSlaTiers();
      var slaSummary = PRIORITY_LEVELS.map(function (level) {
        return PRIORITY_LABELS[level] + ' ' + tiers[level].tto_hours + 'h/' + tiers[level].ttr_hours + 'h';
      }).join(', ');
      if (slaAstreinteInput.checked) {
        slaSummary += " — {{ __('astreinte 24h/24, 7j/7', 'configurationglpiauto')|e('js') }}";
      }
      if (olaEnabledInput.checked) {
        slaSummary += " — {{ __('+ OLA (engagements internes)', 'configurationglpiauto')|e('js') }}";
      }
      slaSummary += slaEscalationSuffix;
      document.getElementById('cga-summary-sla').textContent = slaSummary;
    }

    document.getElementById('cga-summary-categories').textContent = !categoryEnabledInput.checked
      ? "{{ __('Aucune', 'configurationglpiauto')|e('js') }}"
      : Array.prototype.filter.call(categoryBranchToggles, function (t) { return t.checked; }).length
        + ' / ' + categoryBranchToggles.length + ' ' + "{{ __('branches', 'configurationglpiauto')|e('js') }}"
        + (categoryIconsEnabledInput.checked ? " {{ __('(avec icônes)', 'configurationglpiauto')|e('js') }}" : '');

    document.getElementById('cga-summary-service-catalog').textContent = !serviceCatalogEnabledInput.checked
      ? "{{ __('Aucun', 'configurationglpiauto')|e('js') }}"
      : Array.prototype.filter.call(document.querySelectorAll('.cga-service-branch-preview'), function (el) { return el.style.display !== 'none'; }).length
        + ' ' + "{{ __('branches avec services', 'configurationglpiauto')|e('js') }}";

    var selectedStateCount = Array.prototype.filter.call(document.querySelectorAll('.cga-state-name-toggle'), function (el) { return el.checked; }).length;
    document.getElementById('cga-summary-states').textContent = (!stateEnabledInput.checked || selectedStateCount === 0)
      ? "{{ __('Aucun', 'configurationglpiauto')|e('js') }}"
      : (selectedStateCount + ' ' + "{{ __('statuts', 'configurationglpiauto')|e('js') }}" + (stateIconsEnabledInput.checked ? " {{ __('(avec icônes)', 'configurationglpiauto')|e('js') }}" : ''));

    document.getElementById('cga-summary-wait-reasons').textContent = !waitReasonsEnabledInput.checked
      ? "{{ __('Aucune', 'configurationglpiauto')|e('js') }}"
      : ({{ wait_reasons_preview|length }} + ' ' + "{{ __('raisons d\'attente', 'configurationglpiauto')|e('js') }}");

    var brandingParts = [];
    if (brandingEnabledInput.checked) { brandingParts.push("{{ __('Couleur principale', 'configurationglpiauto')|e('js') }} " + brandingColorInput.value); }
    if (entityLogosEnabledInput.checked) { brandingParts.push("{{ __('logo(s) par entité', 'configurationglpiauto')|e('js') }}"); }
    document.getElementById('cga-summary-branding').textContent = brandingParts.length
      ? brandingParts.join(' + ')
      : "{{ __('Aucune', 'configurationglpiauto')|e('js') }}";

    var generalSettingsCheckedCount = 0;
    generalSettingsGroupInputs.forEach(function (input) { if (input.checked) { generalSettingsCheckedCount++; } });
    document.getElementById('cga-summary-general-settings').textContent = generalSettingsCheckedCount === 0
      ? "{{ __('Aucun', 'configurationglpiauto')|e('js') }}"
      : (generalSettingsCheckedCount === generalSettingsGroupInputs.length
        ? "{{ __('Tous les groupes appliqués', 'configurationglpiauto')|e('js') }}"
        : (generalSettingsCheckedCount + ' ' + "{{ __('groupe(s) appliqué(s)', 'configurationglpiauto')|e('js') }}"));

    document.getElementById('cga-summary-ticket-templates').textContent = ticketTemplateEnabledInput.checked
      ? "{{ __('Simplifié + Complet, assignés aux profils', 'configurationglpiauto')|e('js') }}" + (helpdeskFormHideFieldsInput.checked ? " {{ __('(+ formulaires libre-service allégés)', 'configurationglpiauto')|e('js') }}" : '')
      : "{{ __('Aucun', 'configurationglpiauto')|e('js') }}";

    var ldapRightsLeafCount = collectLeafEntityNames(window.cgaTree || []).length;
    document.getElementById('cga-summary-ldap-rights').textContent = (ldapRightsEnabledInput.checked && ldapRightsLeafCount > 0)
      ? (ldapRightsLeafCount + ' ' + "{{ __('règle(s)', 'configurationglpiauto')|e('js') }}" + ' — ' + ldapRightsProfileInput.value)
      : "{{ __('Aucun', 'configurationglpiauto')|e('js') }}";

    var tasksSolutionsParts = [];
    if (taskCategoriesEnabledInput.checked) { tasksSolutionsParts.push("{{ __('catégories de tâches', 'configurationglpiauto')|e('js') }}"); }
    if (taskTemplatesEnabledInput.checked) { tasksSolutionsParts.push("{{ __('gabarits de tâche', 'configurationglpiauto')|e('js') }}"); }
    if (solutionLibraryEnabledInput.checked) { tasksSolutionsParts.push("{{ __('types/gabarits de solution', 'configurationglpiauto')|e('js') }}"); }
    document.getElementById('cga-summary-tasks-solutions').textContent = tasksSolutionsParts.length
      ? tasksSolutionsParts.join(', ')
      : "{{ __('Aucun', 'configurationglpiauto')|e('js') }}";

    var followupsValidationsParts = [];
    if (followupLibraryEnabledInput.checked) { followupsValidationsParts.push("{{ __('gabarits de suivis', 'configurationglpiauto')|e('js') }}"); }
    if (validationTemplatesEnabledInput.checked) { followupsValidationsParts.push("{{ __('gabarits de validation', 'configurationglpiauto')|e('js') }}"); }
    if (changeProblemTemplatesEnabledInput.checked) { followupsValidationsParts.push("{{ __('modèles changement/problème', 'configurationglpiauto')|e('js') }}"); }
    document.getElementById('cga-summary-followups-validations').textContent = followupsValidationsParts.length
      ? followupsValidationsParts.join(', ')
      : "{{ __('Aucun', 'configurationglpiauto')|e('js') }}";

    var generalToolsParts = [];
    if (locationsEnabledInput.checked) { generalToolsParts.push("{{ __('lieux', 'configurationglpiauto')|e('js') }}"); }
    if (manufacturersEnabledInput.checked) { generalToolsParts.push("{{ __('fabricants', 'configurationglpiauto')|e('js') }}"); }
    if (kbCategoriesEnabledInput.checked) { generalToolsParts.push("{{ __('catégories base de connaissances', 'configurationglpiauto')|e('js') }}"); }
    document.getElementById('cga-summary-general-tools').textContent = generalToolsParts.length
      ? generalToolsParts.join(', ')
      : "{{ __('Aucun', 'configurationglpiauto')|e('js') }}";

    var projectsParts = [];
    if (projectTaxonomyEnabledInput.checked) { projectsParts.push("{{ __('types de projet/tâche', 'configurationglpiauto')|e('js') }}"); }
    if (projectTaskTemplatesEnabledInput.checked) { projectsParts.push("{{ __('gabarits de tâches de projets', 'configurationglpiauto')|e('js') }}"); }
    document.getElementById('cga-summary-projects').textContent = projectsParts.length
      ? projectsParts.join(', ')
      : "{{ __('Aucun', 'configurationglpiauto')|e('js') }}";
  }

  function showStep(n) {
    currentStep = Math.max(1, Math.min(STEP_COUNT, n));
    steps.forEach(function (stepEl) {
      stepEl.style.display = (parseInt(stepEl.dataset.step, 10) === currentStep) ? '' : 'none';
    });
    progressBar.style.width = Math.round((currentStep / STEP_COUNT) * 100) + '%';
    stepIndicator.textContent = "{{ __('Étape', 'configurationglpiauto')|e('js') }} " + currentStep + "/" + STEP_COUNT + " — " + stepLabels[currentStep - 1];
    prevBtn.style.display = currentStep === 1 ? 'none' : '';
    nextBtn.style.display = currentStep === STEP_COUNT ? 'none' : '';
    finishBtn.style.display = currentStep === STEP_COUNT ? '' : 'none';

    if (currentStep === STEP_COUNT) {
      fillSummary();
    }
    updateLdapRightsPreview();
    if (currentStep === 9) {
      // Re-rendered only when actually entering this step (not on every navigation elsewhere) —
      // a native <input type="file">'s selection can't survive a re-render, so this only refreshes
      // when it matters (the tree may have changed since last time) rather than on every click.
      renderEntityLogoPanels();
    }
  }

  prevBtn.addEventListener('click', function () { showStep(currentStep - 1); });
  nextBtn.addEventListener('click', function () { showStep(currentStep + 1); });

  // Profile pre-fill: picking a profile in step 1 suggests a starting point for steps 2-5
  // (entity mode, calendar, SLA) — never entity_tree itself (no realistic way to guess real
  // client/site names) and never overrides anything a profile's defaults don't mention. Purely
  // a suggestion: every field stays a normal input the admin can still change afterward.
  var profileDefaults = {{ profile_defaults|default({})|json_encode|raw }};

  function applyProfileDefaults(profileId) {
    var defaults = profileDefaults[profileId];
    if (!defaults) {
      return;
    }

    if (defaults.entity_mode) {
      var modeRadio = document.getElementById('cga-mode-' + defaults.entity_mode);
      if (modeRadio) {
        modeRadio.checked = true;
        modeRadio.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    if (typeof defaults.calendar_enabled !== 'undefined') {
      calendarEnabledInput.checked = !!defaults.calendar_enabled;
      toggleCalendarFields();
    }
    if (defaults.calendar_days) {
      DAYS.forEach(function (d) {
        var cb = document.getElementById('cga-calendar-day-' + d.value);
        if (cb) {
          cb.checked = defaults.calendar_days.indexOf(d.value) !== -1;
        }
      });
    }
    if (defaults.calendar_begin) {
      document.querySelector('input[name="calendar_begin"]').value = defaults.calendar_begin;
    }
    if (defaults.calendar_end) {
      document.querySelector('input[name="calendar_end"]').value = defaults.calendar_end;
    }
    if (typeof defaults.calendar_holidays_enabled !== 'undefined') {
      document.getElementById('cga-calendar-holidays-enabled').checked = !!defaults.calendar_holidays_enabled;
    }

    if (typeof defaults.sla_enabled !== 'undefined') {
      slaEnabledInput.checked = !!defaults.sla_enabled;
      toggleSlaFields();
    }
    applyTierDefaults('sla_tiers', defaults.sla_tiers);
    if (typeof defaults.sla_astreinte !== 'undefined') {
      slaAstreinteInput.checked = !!defaults.sla_astreinte;
    }
    if (typeof defaults.sla_escalation_enabled !== 'undefined') {
      slaEscalationEnabledInput.checked = !!defaults.sla_escalation_enabled;
      toggleSlaEscalationFields();
    }

    if (typeof defaults.ola_enabled !== 'undefined') {
      olaEnabledInput.checked = !!defaults.ola_enabled;
      toggleOlaFields();
    }
    applyTierDefaults('ola_tiers', defaults.ola_tiers);

    if (typeof defaults.category_enabled !== 'undefined') {
      categoryEnabledInput.checked = !!defaults.category_enabled;
      toggleCategoryFields();
    }
    if (defaults.category_branches) {
      categoryBranchToggles.forEach(function (toggle) {
        toggle.checked = defaults.category_branches.indexOf(toggle.dataset.branch) !== -1;
        toggleCategoryBranchPreview(toggle);
      });
    }
    if (typeof defaults.category_icons_enabled !== 'undefined') {
      categoryIconsEnabledInput.checked = !!defaults.category_icons_enabled;
      toggleCategoryIcons();
    }

    if (typeof defaults.service_catalog_enabled !== 'undefined') {
      serviceCatalogEnabledInput.checked = !!defaults.service_catalog_enabled;
      toggleServiceCatalogFields();
    }

    if (typeof defaults.state_enabled !== 'undefined') {
      stateEnabledInput.checked = !!defaults.state_enabled;
      toggleStateFields();
    }
    if (typeof defaults.state_icons_enabled !== 'undefined') {
      stateIconsEnabledInput.checked = !!defaults.state_icons_enabled;
      toggleStateIcons();
    }

    if (typeof defaults.wait_reasons_enabled !== 'undefined') {
      waitReasonsEnabledInput.checked = !!defaults.wait_reasons_enabled;
      toggleWaitReasonsFields();
    }

    ['general_ui_enabled', 'notifications_enabled', 'financial_info_enabled', 'project_task_states_enabled', 'satisfaction_survey_enabled', 'committee_validation_enabled'].forEach(function (field) {
      if (typeof defaults[field] !== 'undefined') {
        document.getElementById('cga-' + field.replace(/_/g, '-')).checked = !!defaults[field];
      }
    });
    syncGeneralSettingsSelectAll();

    ['task_categories_enabled', 'task_templates_enabled', 'solution_library_enabled', 'followup_library_enabled', 'validation_templates_enabled', 'change_problem_templates_enabled', 'locations_enabled', 'manufacturers_enabled', 'kb_categories_enabled', 'project_taxonomy_enabled', 'project_task_templates_enabled'].forEach(function (field) {
      if (typeof defaults[field] !== 'undefined') {
        var input = document.getElementById('cga-' + field.replace(/_/g, '-'));
        input.checked = !!defaults[field];
        input.dispatchEvent(new Event('change'));
      }
    });

    if (typeof defaults.ticket_template_enabled !== 'undefined') {
      ticketTemplateEnabledInput.checked = !!defaults.ticket_template_enabled;
      toggleTicketTemplateFields();
    }

    if (typeof defaults.helpdesk_form_hide_fields !== 'undefined') {
      helpdeskFormHideFieldsInput.checked = !!defaults.helpdesk_form_hide_fields;
    }
  }

  function applyTierDefaults(fieldPrefix, tiersDefaults) {
    if (!tiersDefaults) {
      return;
    }
    PRIORITY_LEVELS.forEach(function (level) {
      var tier = tiersDefaults[level];
      if (!tier) {
        return;
      }
      var ttoInput = document.querySelector('input[name="' + fieldPrefix + '[' + level + '][tto_hours]"]');
      var ttrInput = document.querySelector('input[name="' + fieldPrefix + '[' + level + '][ttr_hours]"]');
      if (ttoInput) {
        ttoInput.value = tier.tto_hours;
      }
      if (ttrInput) {
        ttrInput.value = tier.ttr_hours;
      }
    });
  }

  document.querySelectorAll('input[name="configurationprofiles_id"]').forEach(function (radio) {
    radio.addEventListener('change', function () { applyProfileDefaults(radio.value); });
  });

  showStep(1);
})();
</script>
