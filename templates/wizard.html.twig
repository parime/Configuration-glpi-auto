{% macro category_tree(nodes) %}
  <ul class="cga-tree">
    {% for node in nodes %}
      <li>
        {% if node.icon is defined %}<span class="cga-category-tree-icon" style="display: none;">{{ node.icon }}</span>{% endif %}
        {{ node.name }}
        {% if node.comment is defined %}<span class="text-muted small"> — {{ node.comment }}</span>{% endif %}
        {% if node.children is defined and node.children|length %}
          {{ _self.category_tree(node.children) }}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}

<div class="card">
  <div class="card-body">

    <div class="progress mb-2" style="height: 6px;">
      <div class="progress-bar" id="cga-wizard-progress" role="progressbar" style="width: 25%;"></div>
    </div>
    <p class="text-muted small mb-4" id="cga-wizard-stepindicator"></p>

    <form method="post" enctype="multipart/form-data" action="{{ config('root_doc') }}/plugins/configurationglpiauto/front/wizard.php" id="cga-wizard-form">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

      {# ---------------------------------------------------------------- Étape 1 : Profil #}
      <div class="cga-wizard-step" data-step="1">
        <h3 class="mb-1">{{ __('Étape 1 : Profil', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Quel profil correspond le mieux à votre organisation ? Ce choix pré-remplit la structure d\'entités, le calendrier et les SLA des étapes suivantes avec des valeurs adaptées — vous pourrez tout ajuster ensuite.', 'configurationglpiauto') }}</p>

        {% for id, profile in profiles %}
          <div class="form-check mb-2">
            <input
              type="radio"
              name="configurationprofiles_id"
              value="{{ profile.id }}"
              class="form-check-input"
              id="cga-profile-{{ profile.id }}"
              {{ config.configurationprofiles_id|default(0) == profile.id ? 'checked' : '' }}
            >
            <label class="form-check-label" for="cga-profile-{{ profile.id }}">
              <strong>{{ profile.name }}</strong>
              {% if profile.description %}<span class="text-muted"> — {{ profile.description }}</span>{% endif %}
            </label>
          </div>
        {% endfor %}
      </div>

      {# ---------------------------------------------------------------- Étape 2 : Entités #}
      <div class="cga-wizard-step" data-step="2" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 2 : Structure des entités', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Choisissez la structure d\'entités à mettre en place — l\'aperçu à droite se met à jour en direct.', 'configurationglpiauto') }}</p>

        {% include '@configurationglpiauto/_entity_structure_fields.html.twig' %}
      </div>

      {# ---------------------------------------------------------------- Étape 3 : Calendrier #}
      <div class="cga-wizard-step" data-step="3" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 3 : Calendrier', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Configurez, si besoin, les horaires d\'ouverture appliqués aux entités créées.', 'configurationglpiauto') }}</p>

        <div id="cga-calendar-per-client-toggle-wrap" style="display: none;" class="mb-3 pb-3 border-bottom">
          <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" id="cga-calendar-per-client-toggle">
            <label class="form-check-label" for="cga-calendar-per-client-toggle">{{ __('Calendrier différent par site ou client', 'configurationglpiauto') }}</label>
          </div>
        </div>

        <div id="cga-calendar-shared-section">
          <div class="form-check form-switch mb-3">
            <input type="hidden" name="calendar_enabled" value="0">
            <input
              type="checkbox"
              name="calendar_enabled"
              value="1"
              class="form-check-input"
              id="cga-calendar-enabled"
              {{ config.calendar_enabled|default(0) ? 'checked' : '' }}
            >
            <label class="form-check-label" for="cga-calendar-enabled">{{ __('Créer un calendrier d\'horaires d\'ouverture', 'configurationglpiauto') }}</label>
          </div>

          <div id="cga-calendar-fields" style="display: none;">
            <div class="mb-3" style="max-width: 320px;">
              <label class="form-label">{{ __('Nom du calendrier', 'configurationglpiauto') }}</label>
              <input type="text" name="calendar_name" class="form-control" value="{{ config.calendar_name|default('Horaires standard') }}">
            </div>

            <div class="mb-3">
              <label class="form-label">{{ __('Jours ouvrés', 'configurationglpiauto') }}</label>
              <div id="cga-calendar-days"></div>
            </div>

            <div class="row" style="max-width: 320px;">
              <div class="col mb-3">
                <label class="form-label">{{ __('Ouverture', 'configurationglpiauto') }}</label>
                <input type="time" name="calendar_begin" class="form-control" value="{{ config.calendar_begin|default('08:00') }}">
              </div>
              <div class="col mb-3">
                <label class="form-label">{{ __('Fermeture', 'configurationglpiauto') }}</label>
                <input type="time" name="calendar_end" class="form-control" value="{{ config.calendar_end|default('18:00') }}">
              </div>
            </div>

            <div class="form-check form-switch mb-3">
              <input type="hidden" name="calendar_holidays_enabled" value="0">
              <input
                type="checkbox"
                name="calendar_holidays_enabled"
                value="1"
                class="form-check-input"
                id="cga-calendar-holidays-enabled"
                {{ config.calendar_holidays_enabled|default(0) ? 'checked' : '' }}
              >
              <label class="form-check-label" for="cga-calendar-holidays-enabled">{{ __('Ajouter les jours fériés français (8 jours fixes)', 'configurationglpiauto') }}</label>
            </div>
            <p class="text-muted small">{{ __('Jour de l\'An, Fête du Travail, Victoire 1945, Fête nationale, Assomption, Toussaint, Armistice, Noël. Sans ça, les échéances SLA/OLA continuent de courir un jour férié. Les jours mobiles (Pâques, Ascension, Pentecôte) ne sont pas inclus — ils changent de date chaque année, à ajouter à la main.', 'configurationglpiauto') }}</p>
          </div>
        </div>

        <div id="cga-calendar-per-client-panels" style="display: none;"></div>
      </div>

      {# ---------------------------------------------------------------- Étape 4 : SLA #}
      <div class="cga-wizard-step" data-step="4" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 4 : Niveaux de service (SLA)', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Optionnel : délais standards de prise en charge et de résolution des tickets, appliqués aux entités créées.', 'configurationglpiauto') }}</p>

        <div id="cga-sla-per-client-toggle-wrap" style="display: none;" class="mb-3 pb-3 border-bottom">
          <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" id="cga-sla-per-client-toggle">
            <label class="form-check-label" for="cga-sla-per-client-toggle">{{ __('SLA différent par site ou client', 'configurationglpiauto') }}</label>
          </div>
        </div>

        <div id="cga-sla-shared-section">
          <div class="form-check form-switch mb-3">
            <input type="hidden" name="sla_enabled" value="0">
            <input
              type="checkbox"
              name="sla_enabled"
              value="1"
              class="form-check-input"
              id="cga-sla-enabled"
              {{ config.sla_enabled|default(0) ? 'checked' : '' }}
            >
            <label class="form-check-label" for="cga-sla-enabled">{{ __('Créer des SLA standards', 'configurationglpiauto') }}</label>
          </div>

          <div id="cga-sla-fields" style="display: none;">
            <table class="table table-sm mb-3" style="max-width: 480px;">
              <thead>
                <tr>
                  <th>{{ __('Priorité', 'configurationglpiauto') }}</th>
                  <th>{{ __('Prise en charge (h)', 'configurationglpiauto') }}</th>
                  <th>{{ __('Résolution (h)', 'configurationglpiauto') }}</th>
                </tr>
              </thead>
              <tbody>
                {% for level in priority_levels %}
                  <tr>
                    <td>{{ priority_labels[level] }}</td>
                    <td><input type="number" min="1" class="form-control form-control-sm" name="sla_tiers[{{ level }}][tto_hours]" value="{{ sla_tiers[level]['tto_hours'] }}"></td>
                    <td><input type="number" min="1" class="form-control form-control-sm" name="sla_tiers[{{ level }}][ttr_hours]" value="{{ sla_tiers[level]['ttr_hours'] }}"></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>

            <div class="form-check form-switch mb-3">
              <input type="hidden" name="sla_astreinte" value="0">
              <input
                type="checkbox"
                name="sla_astreinte"
                value="1"
                class="form-check-input"
                id="cga-sla-astreinte"
                {{ config.sla_astreinte|default(0) ? 'checked' : '' }}
              >
              <label class="form-check-label" for="cga-sla-astreinte">{{ __('Astreinte (couverture 24h/24, 7j/7 — le délai continue de courir en dehors des horaires ouvrés)', 'configurationglpiauto') }}</label>
            </div>

            <div class="form-check form-switch mb-2">
              <input type="hidden" name="ola_enabled" value="0">
              <input
                type="checkbox"
                name="ola_enabled"
                value="1"
                class="form-check-input"
                id="cga-ola-enabled"
                {{ config.ola_enabled|default(0) ? 'checked' : '' }}
              >
              <label class="form-check-label" for="cga-ola-enabled">{{ __('Ajouter des engagements internes (OLA)', 'configurationglpiauto') }}</label>
            </div>
            <p class="text-muted small">{{ __('L\'OLA est un engagement interne entre le support et les équipes techniques, plus court que le SLA externe — il doit être tenu pour que le SLA le soit aussi.', 'configurationglpiauto') }}</p>

            <table class="table table-sm mb-3" id="cga-ola-fields" style="max-width: 480px; display: none;">
              <thead>
                <tr>
                  <th>{{ __('Priorité', 'configurationglpiauto') }}</th>
                  <th>{{ __('Prise en charge (h)', 'configurationglpiauto') }}</th>
                  <th>{{ __('Résolution (h)', 'configurationglpiauto') }}</th>
                </tr>
              </thead>
              <tbody>
                {% for level in priority_levels %}
                  <tr>
                    <td>{{ priority_labels[level] }}</td>
                    <td><input type="number" min="1" class="form-control form-control-sm" name="ola_tiers[{{ level }}][tto_hours]" value="{{ ola_tiers[level]['tto_hours'] }}"></td>
                    <td><input type="number" min="1" class="form-control form-control-sm" name="ola_tiers[{{ level }}][ttr_hours]" value="{{ ola_tiers[level]['ttr_hours'] }}"></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <div id="cga-sla-per-client-panels" style="display: none;"></div>

        <div class="mt-3 pt-3 border-top">
          <div class="form-check form-switch mb-2">
            <input type="hidden" name="sla_escalation_enabled" value="0">
            <input
              type="checkbox"
              name="sla_escalation_enabled"
              value="1"
              class="form-check-input"
              id="cga-sla-escalation-enabled"
              {{ config.sla_escalation_enabled|default(0) ? 'checked' : '' }}
            >
            <label class="form-check-label" for="cga-sla-escalation-enabled">{{ __('Escalade automatique avant échéance', 'configurationglpiauto') }}</label>
          </div>
          <div id="cga-sla-escalation-fields" style="display: none;" class="d-flex align-items-center gap-2 mb-2">
            <label class="form-label mb-0" for="cga-sla-escalation-threshold">{{ __('Déclenchement à', 'configurationglpiauto') }}</label>
            <input
              type="number"
              min="50"
              max="95"
              name="sla_escalation_threshold_percent"
              id="cga-sla-escalation-threshold"
              class="form-control form-control-sm"
              style="width: 80px;"
              value="{{ config.sla_escalation_threshold_percent|default(75) }}"
            >
            <span>% {{ __('du délai écoulé → priorité relevée d\'un cran (résolution, et engagement interne si activé)', 'configurationglpiauto') }}</span>
          </div>
          <p class="text-muted small">{{ __('S\'applique à tout SLA/OLA créé sur cette étape — partagé ou par site/client. N\'affecte que la priorité — pas de réaffectation automatique à une autre équipe, GLPI ne sachant pas laquelle serait la bonne.', 'configurationglpiauto') }}</p>
        </div>
      </div>

      {# ---------------------------------------------------------------- Étape 5 : Catégories #}
      <div class="cga-wizard-step" data-step="5" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 5 : Catégories de tickets', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Optionnel : une arborescence de catégories thématiques (IT, Bâtiment, Flotte, RH...), pas une par type ITIL — le type (Incident/Demande) est déjà géré nativement par GLPI. Décochez les branches qui ne s\'appliquent pas à votre organisation.', 'configurationglpiauto') }}</p>

        <div class="form-check form-switch mb-3">
          <input type="hidden" name="category_enabled" value="0">
          <input
            type="checkbox"
            name="category_enabled"
            value="1"
            class="form-check-input"
            id="cga-category-enabled"
            {{ config.category_enabled|default(0) ? 'checked' : '' }}
          >
          <label class="form-check-label" for="cga-category-enabled">{{ __('Créer les catégories de tickets', 'configurationglpiauto') }}</label>
        </div>

        <div id="cga-category-fields" style="display: none;">
          <div class="form-check form-switch mb-3">
            <input type="hidden" name="category_icons_enabled" value="0">
            <input
              type="checkbox"
              name="category_icons_enabled"
              value="1"
              class="form-check-input"
              id="cga-category-icons-enabled"
              {{ config.category_icons_enabled|default(0) ? 'checked' : '' }}
            >
            <label class="form-check-label" for="cga-category-icons-enabled">{{ __('Ajouter des icônes (visibles dans la liste, le nom lui-même reste sans icône)', 'configurationglpiauto') }}</label>
          </div>

          <div class="row mb-3">
            {% for branch in categories_preview %}
              <div class="col-6">
                <div class="form-check">
                  <input
                    type="checkbox"
                    name="category_branches[]"
                    value="{{ branch.key }}"
                    class="form-check-input cga-category-branch-toggle"
                    id="cga-category-branch-{{ branch.key }}"
                    data-branch="{{ branch.key }}"
                    {{ branch.key in category_branches ? 'checked' : '' }}
                  >
                  <label class="form-check-label" for="cga-category-branch-{{ branch.key }}">{{ branch.icon }} {{ branch.name }}</label>
                </div>
              </div>
            {% endfor %}
          </div>

          <div id="cga-category-preview">
            {% for branch in categories_preview %}
              <div class="cga-category-branch-preview mb-2" data-branch="{{ branch.key }}">
                <strong>{{ branch.icon }} {{ branch.name }}</strong>
                {{ _self.category_tree(branch.children) }}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      {# ---------------------------------------------------------------- Étape 6 : Catalogue de services #}
      <div class="cga-wizard-step" data-step="6" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 6 : Catalogue de services', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Optionnel : des formulaires prêts à l\'emploi dans le portail libre-service — l\'utilisateur choisit un service précis, jamais une catégorie ; le ticket est automatiquement routé vers la bonne catégorie.', 'configurationglpiauto') }}</p>

        <div class="form-check form-switch mb-3">
          <input type="hidden" name="service_catalog_enabled" value="0">
          <input
            type="checkbox"
            name="service_catalog_enabled"
            value="1"
            class="form-check-input"
            id="cga-service-catalog-enabled"
            {{ config.service_catalog_enabled|default(0) ? 'checked' : '' }}
          >
          <label class="form-check-label" for="cga-service-catalog-enabled">{{ __('Créer le catalogue de services', 'configurationglpiauto') }}</label>
        </div>

        <div id="cga-service-catalog-fields" style="display: none;">
          <p class="text-muted small">{{ __('Un service par ligne, groupé par branche cochée à l\'étape Catégories — décocher une branche là-bas retire aussi ses services ici.', 'configurationglpiauto') }}</p>
          <div id="cga-service-catalog-preview">
            {% for branch in categories_preview %}
              {% set branch_services = services_preview|filter(s => s.branch == branch.key) %}
              {% if branch_services|length %}
                <div class="cga-service-branch-preview mb-2" data-branch="{{ branch.key }}">
                  <strong>{{ branch.icon }} {{ branch.name }}</strong>
                  <ul class="mb-0">
                    {% for service in branch_services %}
                      <li>{{ service.name }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>

      {# ---------------------------------------------------------------- Étape 7 : Statuts des éléments #}
      <div class="cga-wizard-step" data-step="7" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 7 : Statuts des éléments', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Optionnel : un jeu de statuts standards pour le parc (ordinateurs, moniteurs, téléphones...) — aucun n\'existe par défaut dans GLPI.', 'configurationglpiauto') }}</p>

        <div class="form-check form-switch mb-3">
          <input type="hidden" name="state_enabled" value="0">
          <input
            type="checkbox"
            name="state_enabled"
            value="1"
            class="form-check-input"
            id="cga-state-enabled"
            {{ config.state_enabled|default(0) ? 'checked' : '' }}
          >
          <label class="form-check-label" for="cga-state-enabled">{{ __('Créer les statuts d\'éléments standards', 'configurationglpiauto') }}</label>
        </div>

        <div id="cga-state-fields" style="display: none;">
          <div class="form-check form-switch mb-3">
            <input type="hidden" name="state_icons_enabled" value="0">
            <input
              type="checkbox"
              name="state_icons_enabled"
              value="1"
              class="form-check-input"
              id="cga-state-icons-enabled"
              {{ config.state_icons_enabled|default(0) ? 'checked' : '' }}
            >
            <label class="form-check-label" for="cga-state-icons-enabled">{{ __('Ajouter des icônes (visibles dans la liste, le nom lui-même reste sans icône)', 'configurationglpiauto') }}</label>
          </div>

          <p class="text-muted small mb-1">{{ __('Le statut décrit la situation d\'un équipement dans son cycle de vie (en stock, attribué, en panne...) — il sert à filtrer et suivre le parc, indépendamment de sa localisation ou de son entité. Ne cochez que les statuts qui correspondent à des situations réelles chez vous ; chacun peut être appliqué aux ordinateurs, téléphones, moniteurs, licences, etc.', 'configurationglpiauto') }}</p>
          <p class="text-muted small mb-1">{{ __('Les statuts marqués « recommandé » sont ceux utilisés par remise-glpi (déclenchement automatique remise/don/vente/restitution) — les décocher n\'empêche rien de fonctionner mais réduit l\'interopérabilité entre les deux plugins si vous utilisez remise-glpi.', 'configurationglpiauto') }}</p>
          <ul class="list-group" id="cga-state-preview" style="max-width: 560px;">
            {% for state in states_preview %}
              <li class="list-group-item d-flex align-items-start gap-2">
                <input
                  type="checkbox"
                  name="state_names[]"
                  value="{{ state.name }}"
                  class="form-check-input cga-state-name-toggle mt-1"
                  id="cga-state-name-{{ loop.index0 }}"
                  {{ state.name in state_names ? 'checked' : '' }}
                >
                <span class="cga-state-preview-icon" style="display: none;">{{ state.icon }}</span>
                <div class="flex-grow-1">
                  <label class="form-check-label d-block" for="cga-state-name-{{ loop.index0 }}">{{ state.name }}</label>
                  {% if state.comment %}<div class="text-muted small">{{ state.comment }}</div>{% endif %}
                </div>
                {% if state.name in state_recommended_names %}
                  <span class="badge bg-azure-lt">{{ __('recommandé', 'configurationglpiauto') }}</span>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>

      {# ---------------------------------------------------------------- Étape 8 : Raisons d'attente #}
      <div class="cga-wizard-step" data-step="8" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 8 : Raisons d\'attente', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Optionnel : des raisons de mise en attente avec relance et clôture automatiques — évite les tickets qui traînent indéfiniment. Le moteur d\'automatisation de GLPI est déjà actif par défaut, seules les raisons manquent.', 'configurationglpiauto') }}</p>

        <div class="form-check form-switch mb-3">
          <input type="hidden" name="wait_reasons_enabled" value="0">
          <input
            type="checkbox"
            name="wait_reasons_enabled"
            value="1"
            class="form-check-input"
            id="cga-wait-reasons-enabled"
            {{ config.wait_reasons_enabled|default(0) ? 'checked' : '' }}
          >
          <label class="form-check-label" for="cga-wait-reasons-enabled">{{ __('Créer les raisons d\'attente standards', 'configurationglpiauto') }}</label>
        </div>

        <div id="cga-wait-reasons-fields" style="display: none;">
          <div class="form-check form-switch mb-2">
            <input type="hidden" name="wait_reason_icons_enabled" value="0">
            <input type="checkbox" name="wait_reason_icons_enabled" value="1" class="form-check-input" id="cga-wait-reason-icons-enabled" {{ config.wait_reason_icons_enabled|default(0) ? 'checked' : '' }}>
            <label class="form-check-label" for="cga-wait-reason-icons-enabled">{{ __('Ajouter des icônes', 'configurationglpiauto') }}</label>
          </div>
          <ul class="list-group" style="max-width: 560px;">
            {% for reason in wait_reasons_preview %}
              <li class="list-group-item">
                <span class="cga-wait-reason-icon" style="display: none;">{{ reason.icon }}</span>
                <strong>{{ reason.name }}</strong><br>
                {% if reason.followup_weeks > 0 %}
                  <span class="text-muted small">{{ __('Relance toutes les', 'configurationglpiauto') }} {{ reason.followup_weeks }} {{ reason.followup_weeks > 1 ? __('semaines', 'configurationglpiauto') : __('semaine', 'configurationglpiauto') }}{% if reason.followups_before_resolution > 0 %}, {{ __('clôture automatique après', 'configurationglpiauto') }} {{ reason.followups_before_resolution }} {{ __('relances sans réponse', 'configurationglpiauto') }}{% endif %}</span>
                {% else %}
                  <span class="text-muted small">{{ __('Pas de relance automatique — catégorisation uniquement', 'configurationglpiauto') }}</span>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>

      {# ---------------------------------------------------------------- Étape 9 : Branding #}
      <div class="cga-wizard-step" data-step="9" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 9 : Personnalisation graphique', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Optionnel : une couleur principale appliquée à l\'interface des entités créées.', 'configurationglpiauto') }}</p>

        <div class="form-check form-switch mb-3">
          <input type="hidden" name="branding_enabled" value="0">
          <input
            type="checkbox"
            name="branding_enabled"
            value="1"
            class="form-check-input"
            id="cga-branding-enabled"
