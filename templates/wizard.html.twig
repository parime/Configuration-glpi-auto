      {# ---------------------------------------------------------------- Étape 17 : Récapitulatif #}
      <div class="cga-wizard-step" data-step="17" style="display: none;">
        <h3 class="mb-1">{{ __('Étape 17 : Récapitulatif', 'configurationglpiauto') }}</h3>
        <p class="text-muted">{{ __('Vérifiez vos choix avant de terminer — cette étape crée réellement les entités, le calendrier, les SLA, les catégories, le catalogue de services, les statuts, les raisons d\'attente, la personnalisation graphique, les réglages généraux, les modèles de tickets, les droits LDAP, les intitulés de tâches/solutions/validations, les lieux/fabricants/catégories de base de connaissances, et les types/gabarits de projet.', 'configurationglpiauto') }}</p>

        <ul class="list-group mb-3">
          <li class="list-group-item">
            <strong>{{ __('Profil', 'configurationglpiauto') }} :</strong> <span id="cga-summary-profile"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Structure', 'configurationglpiauto') }} :</strong> <span id="cga-summary-mode"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Arborescence', 'configurationglpiauto') }} :</strong> <span id="cga-summary-tree"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Calendrier', 'configurationglpiauto') }} :</strong> <span id="cga-summary-calendar"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('SLA', 'configurationglpiauto') }} :</strong> <span id="cga-summary-sla"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Catégories', 'configurationglpiauto') }} :</strong> <span id="cga-summary-categories"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Catalogue de services', 'configurationglpiauto') }} :</strong> <span id="cga-summary-service-catalog"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Statuts des éléments', 'configurationglpiauto') }} :</strong> <span id="cga-summary-states"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Raisons d\'attente', 'configurationglpiauto') }} :</strong> <span id="cga-summary-wait-reasons"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Personnalisation', 'configurationglpiauto') }} :</strong> <span id="cga-summary-branding"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Réglages généraux', 'configurationglpiauto') }} :</strong> <span id="cga-summary-general-settings"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Modèles de tickets', 'configurationglpiauto') }} :</strong> <span id="cga-summary-ticket-templates"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Droits LDAP', 'configurationglpiauto') }} :</strong> <span id="cga-summary-ldap-rights"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Tâches & solutions', 'configurationglpiauto') }} :</strong> <span id="cga-summary-tasks-solutions"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Suivis, validations & modèles CP', 'configurationglpiauto') }} :</strong> <span id="cga-summary-followups-validations"></span>
          </li>
          <li class="list-group-item">
            <strong>{{ __('Général & Outils', 'configurationglpiauto') }} :</strong> <span id="cga-summary-general-tools"></span>
          </li>
          <li class="list-group-item">
