{# Issue #345 : import de tickets Jira (export CSV), en deux temps (issue #355 : passé de PHP à Twig) #}
<div class="card"><div class="card-body">
   <h3 class="card-title"><i class="ti ti-transfer-in me-1"></i>{{ __('Importer depuis Jira', 'configurationglpiauto') }}</h3>

   {% if step == 'result' %}
      <div class="alert alert-success">{{ __('Import terminé : %1$d ticket(s) créé(s), %2$d mis à jour.', 'configurationglpiauto')|format(result.created, result.updated) }}
         {% if result.attachments %} {{ __('%d pièce(s) jointe(s) ajoutée(s).', 'configurationglpiauto')|format(result.attachments) }}{% endif %}
         {% if result.labels %} {{ __('%d étiquette(s) posée(s).', 'configurationglpiauto')|format(result.labels) }}{% endif %}</div>
      {% for error in result.errors %}<div class="alert alert-danger py-2">{{ error }}</div>{% endfor %}
      <details><summary>{{ __('Journal de l\'import', 'configurationglpiauto') }}</summary><pre class="small">{{ result.log|join("\n") }}</pre></details>
      <a class="btn btn-outline-primary mt-3" href="{{ tickets_url }}">{{ __('Voir les tickets', 'configurationglpiauto') }}</a>

   {% elseif step == 'upload' %}
      {# Étape 1 : fichier et entité. #}
      <p>{{ __('Dans Jira, exportez les tickets en CSV (« Toutes les colonnes »). L\'import se fait en deux temps : un aperçu à blanc, sans rien écrire, où vous vérifiez les correspondances de statuts et de types, puis l\'import. Les personnes sont reconnues par adresse e-mail ou par nom ; une personne inconnue est signalée, jamais créée. Réimporter le même fichier met à jour les tickets au lieu de les recréer. Aucune notification n\'est envoyée.', 'configurationglpiauto') }}</p>
      <form method="post" enctype="multipart/form-data" action="{{ url }}" class="row g-3 align-items-end">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <div class="col-md-5"><label class="form-label" for="jira_csv">{{ __('Export CSV de Jira', 'configurationglpiauto') }}</label><input type="file" id="jira_csv" name="jira_csv" accept=".csv,text/csv" class="form-control" required></div>
         <div class="col-md-4"><div class="form-label">{{ __('Entité des tickets', 'configurationglpiauto') }}</div>{{ entity_dropdown|raw }}</div>
         <div class="col-md-3"><button type="submit" name="upload" value="1" class="btn btn-primary"><i class="ti ti-eye me-1"></i>{{ __('Aperçu (rien n\'est écrit)', 'configurationglpiauto') }}</button></div>
      </form>

      {# Issue #345, phase 2 : lecture directe par l'API REST de Jira, même aperçu ensuite. #}
      <hr class="my-4">
      <h4><i class="ti ti-plug-connected me-1"></i>{{ __('Ou directement depuis l\'API de Jira', 'configurationglpiauto') }}</h4>
      <p class="text-muted">{{ __('Lecture seule. Le jeton sert uniquement à cette lecture : il n\'est jamais enregistré. Jira Cloud : adresse e-mail du compte et jeton d\'API ; Jira Data Center : jeton d\'accès personnel.', 'configurationglpiauto') }}</p>
      <form method="post" action="{{ url }}" class="row g-3 align-items-end" autocomplete="off">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <div class="col-md-5"><label class="form-label" for="jira_url">{{ __('Adresse de Jira', 'configurationglpiauto') }}</label><input type="url" id="jira_url" name="jira_url" class="form-control" placeholder="https://exemple.atlassian.net" required></div>
         <div class="col-md-3"><label class="form-label" for="jira_flavour">{{ __('Type', 'configurationglpiauto') }}</label>
            <select id="jira_flavour" name="jira_flavour" class="form-select">
               <option value="cloud">Jira Cloud</option>
               <option value="datacenter">Jira Data Center / Server</option>
            </select></div>
         <div class="col-md-4"><label class="form-label" for="jira_user">{{ __('Adresse e-mail (Jira Cloud)', 'configurationglpiauto') }}</label><input type="email" id="jira_user" name="jira_user" class="form-control" autocomplete="off"></div>
         <div class="col-md-5"><label class="form-label" for="jira_token">{{ __('Jeton d\'API', 'configurationglpiauto') }}</label><input type="password" id="jira_token" name="jira_token" class="form-control" autocomplete="new-password" required></div>
         <div class="col-md-7"><label class="form-label" for="jira_jql">{{ __('Requête JQL', 'configurationglpiauto') }}</label><input type="text" id="jira_jql" name="jira_jql" class="form-control" value="project = SUP ORDER BY created ASC" required></div>
         <div class="col-md-5"><div class="form-label">{{ __('Entité des tickets', 'configurationglpiauto') }}</div>{{ api_entity_dropdown|raw }}</div>
         <div class="col-md-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="allow_http" name="allow_http" value="1"><label class="form-check-label" for="allow_http">{{ __('Autoriser HTTP (jeton transmis en clair : réseau interne seulement)', 'configurationglpiauto') }}</label></div></div>
         <div class="col-md-3"><button type="submit" name="fetch_api" value="1" class="btn btn-primary"><i class="ti ti-eye me-1"></i>{{ __('Aperçu (rien n\'est écrit)', 'configurationglpiauto') }}</button></div>
      </form>

   {% else %}
      {# Étape 2 : aperçu à blanc et correspondances. #}
      <div class="alert alert-info">{{ __('%1$d ticket(s) lus, dont %2$d déjà importé(s) (mis à jour plutôt que recréés). Entité : %3$s.', 'configurationglpiauto')|format(preview.total, preview.already_imported, entity_name) }}</div>
      {% for error in parse_errors %}<div class="alert alert-warning py-2">{{ __('Ligne %1$d : %2$s', 'configurationglpiauto')|format(error.line, error.label) }}</div>{% endfor %}
      <form method="post" action="{{ url }}">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <div class="row g-4">
            <div class="col-lg-6">
               <h4>{{ __('Statuts Jira', 'configurationglpiauto') }}</h4>
               <table class="table table-sm align-middle">
                  {% for jira_status, default in preview.statuses %}
                     <tr>
                        <td>{{ jira_status }} <span class="badge bg-secondary-lt">{{ preview.summary.statuses[jira_status] }}</span></td>
                        <td><select name="status_map[{{ jira_status }}]" class="form-select form-select-sm" aria-label="{{ jira_status }}">
                           {% for value, label in status_labels %}<option value="{{ value }}" {{ value ~ '' == default ~ '' ? 'selected' }}>{{ label }}</option>{% endfor %}
                        </select></td>
                     </tr>
                  {% endfor %}
               </table>
            </div>
            <div class="col-lg-6">
               <h4>{{ __('Types de ticket Jira', 'configurationglpiauto') }}</h4>
               <table class="table table-sm align-middle">
                  {% for jira_type, default in preview.types %}
                     <tr>
                        <td>{{ jira_type }} <span class="badge bg-secondary-lt">{{ preview.summary.types[jira_type] }}</span></td>
                        <td><select name="type_map[{{ jira_type }}]" class="form-select form-select-sm" aria-label="{{ jira_type }}">
                           {% for value, label in type_labels %}<option value="{{ value }}" {{ value == default ? 'selected' }}>{{ label }}</option>{% endfor %}
                        </select></td>
                     </tr>
                  {% endfor %}
               </table>
            </div>
         </div>
         {# Issue #345 : entité et catégorie de tickets par projet Jira (tickets créés ; un ticket déjà importé garde les siennes). #}
         {% if projects is not empty %}
            <h4 class="mt-3">{{ __('Projets Jira', 'configurationglpiauto') }}</h4>
            <p class="text-muted small">{{ __('Entité et catégorie des tickets créés pour chaque projet. Un ticket déjà importé garde son entité et sa catégorie.', 'configurationglpiauto') }}</p>
            <table class="table table-sm align-middle">
               <thead><tr><th>{{ __('Projet', 'configurationglpiauto') }}</th><th>{{ __('Entité', 'configurationglpiauto') }}</th><th>{{ __('Catégorie', 'configurationglpiauto') }}</th></tr></thead>
               {% for project in projects %}
                  <tr>
                     <td>{{ project.name }} <span class="badge bg-secondary-lt">{{ project.count }}</span></td>
                     {# Listes produites par le cœur GLPI (Entity::dropdown(), ITILCategory::dropdown()). #}
                     {% set project_entity_dropdown = project.entity %}
                     {% set project_category_dropdown = project.category %}
                     <td>{{ project_entity_dropdown|raw }}</td>
                     <td>{{ project_category_dropdown|raw }}</td>
                  </tr>
               {% endfor %}
            </table>
         {% endif %}
         <h4 class="mt-3">{{ __('Personnes', 'configurationglpiauto') }}</h4>
         <p>{{ __('%1$d reconnue(s) dans GLPI, %2$d inconnue(s).', 'configurationglpiauto')|format(preview.people_found|length, preview.people_missing|length) }}</p>
         {# Issue #345, bonus : sujets fréquents de l'historique et formulaires du catalogue qui y répondent. #}
         {% if preview.subjects is not empty %}
            <h4>{{ __('Sujets fréquents', 'configurationglpiauto') }}</h4>
            <p class="text-muted small">{{ __('Les mots qui reviennent le plus dans les titres importés. Un sujet fréquent sans formulaire est un bon candidat pour le catalogue de services.', 'configurationglpiauto') }}</p>
            <table class="table table-sm align-middle">
               {% for subject in preview.subjects %}
                  <tr>
                     <td class="text-nowrap"><span class="badge bg-purple-lt">{{ subject.word }}</span> <span class="text-muted">{{ __('%d ticket(s)', 'configurationglpiauto')|format(subject.count) }}</span></td>
                     <td class="text-muted small">{{ subject.examples|join(' ; ') }}</td>
                     <td>
                        {% for form in subject.forms %}<a class="badge bg-green-lt me-1" href="{{ form.url }}"><i class="ti ti-forms me-1"></i>{{ form.name }}</a>{% else %}<span class="text-muted small"><i class="ti ti-bulb me-1"></i>{{ __('aucun formulaire : à créer ?', 'configurationglpiauto') }}</span>{% endfor %}
                     </td>
                  </tr>
               {% endfor %}
            </table>
         {% endif %}

         {# Issue #345, phase 2 : étiquettes Jira vers le plugin Tag. #}
         {% if preview.labels is not empty %}
            <h4>{{ __('Étiquettes', 'configurationglpiauto') }}</h4>
            <p>{% for label, count in preview.labels %}<span class="badge bg-blue-lt me-1 mb-1"><i class="ti ti-tag me-1"></i>{{ label }} <span class="text-muted">{{ count }}</span></span>{% endfor %}</p>
            {% if preview.tags_available %}
               <div class="form-check mb-3">
                  <input class="form-check-input" type="checkbox" id="import_labels" name="import_labels" value="1" checked>
                  <label class="form-check-label" for="import_labels">{{ __('Poser ces étiquettes sur les tickets avec le plugin Tag (une étiquette absente est créée, récursive, dans l\'entité de l\'import)', 'configurationglpiauto') }}</label>
               </div>
            {% else %}
               <p class="text-muted"><i class="ti ti-info-circle me-1"></i>{{ __('Installez le plugin Tag pour importer ces étiquettes ; sans lui, elles sont ignorées.', 'configurationglpiauto') }}</p>
            {% endif %}
         {% endif %}
         {% if preview.attachments > 0 or preview.attachments_skipped > 0 %}
            <h4>{{ __('Pièces jointes', 'configurationglpiauto') }}</h4>
            <p><i class="ti ti-paperclip me-1"></i>{{ __('%d pièce(s) jointe(s) seront ajoutées aux tickets comme documents GLPI (extensions autorisées par GLPI seulement).', 'configurationglpiauto')|format(preview.attachments) }}</p>
            {% if preview.attachments_skipped > 0 %}
               <div class="alert alert-warning py-2">{{ __('%d pièce(s) jointe(s) écartée(s) : trop volumineuses (10 Mo par fichier, 200 Mo en tout), hors de l\'adresse de Jira ou illisibles.', 'configurationglpiauto')|format(preview.attachments_skipped) }}</div>
            {% endif %}
         {% endif %}
         {% if preview.people_missing is not empty %}
            <div class="alert alert-warning py-2">{{ __('Inconnues (aucun compte créé ; le ticket sera importé sans elles, leurs commentaires gardent leur nom) :', 'configurationglpiauto') }} {{ preview.people_missing|join(', ') }}</div>
         {% endif %}
         <div class="d-flex gap-2 mt-3">
            <button type="submit" name="import" value="1" class="btn btn-primary"><i class="ti ti-transfer-in me-1"></i>{{ __('Importer %d ticket(s)', 'configurationglpiauto')|format(preview.total) }}</button>
            <button type="submit" name="cancel" value="1" class="btn btn-outline-secondary" formnovalidate>{{ __('Annuler', 'configurationglpiauto') }}</button>
         </div>
      </form>
   {% endif %}
</div></div>
