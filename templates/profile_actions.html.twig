{# Barre d'actions de la liste des profils de configuration (front/profile.php) #}
{% include '@configurationglpiauto/_page_help.html.twig' with {
   page: 'profiles',
   purpose: __('Retrouver les profils de configuration (Blueprints) : chacun pré-remplit l\'assistant avec des valeurs adaptées à un type d\'organisation.', 'configurationglpiauto'),
   expected: __('Ouvrez un profil de la liste pour le consulter ou l\'exporter, ou importez un Blueprint reçu d\'une autre instance. Les autres écrans (assistant, audit, historique, imports) sont dans les onglets ci-dessus.', 'configurationglpiauto'),
} %}
{# Issue #495 : l'assistant, l'audit, l'historique, le plan d'adressage et les imports de tickets
   sont des onglets (UsageTabs) : restent ici les actions propres à la liste des profils. #}
{% if blueprint_url or add_url %}
<div class="mb-3 d-flex flex-wrap gap-2">
   {% if blueprint_url %}
      <a class="btn btn-outline-primary" href="{{ blueprint_url }}"><i class="ti ti-upload"></i> {{ __('Importer un Blueprint (JSON)', 'configurationglpiauto') }}</a>
   {% endif %}
   {% if add_url %}
      <a class="btn btn-primary" href="{{ add_url }}"><i class="ti ti-plus"></i> {{ __('Ajouter') }}</a>
   {% endif %}
</div>
{% endif %}
