{# Issue #112 ("Mode Audit avancé") : analyse l'état réel de l'instance GLPI (pas seulement la
   configuration de ce plugin) et affiche les constats groupés par gravité, avec une correction
   d'un clic uniquement pour les constats dont le "bon" état n'est pas ambigu (voir
   NotificationsDisabledCheck) : les autres n'affichent qu'une recommandation, jamais une valeur
   inventée à la place de l'administrateur. #}

{% include '@configurationglpiauto/_page_help.html.twig' with {
   page: 'audit',
   purpose: __('Analyse de l\'état actuel de votre instance GLPI : indépendante de ce que cet assistant a lui-même configuré.', 'configurationglpiauto'),
   expected: __('Traitez les constats en commençant par les plus graves. Un bouton de correction n\'apparaît que lorsque le bon réglage ne fait aucun doute et que vous avez le droit de modifier la configuration ; sinon, suivez la recommandation.', 'configurationglpiauto'),
} %}
{% include '@configurationglpiauto/audit/_hardening_score.html.twig' %}
<div class="card">
  <div class="card-body">

    {# Issue #131 ("Analyse continue") : compteur accumulé par la tâche planifiée AuditWatchCron
       depuis la dernière visite de cet écran : déjà remis à zéro côté PHP au moment du rendu, cette
       bannière n'apparaît donc qu'une seule fois par lot de nouveaux constats. Message déjà rendu
       côté PHP (front/audit.php) : extract-locales n'extrait `_n()` que depuis le code PHP. #}
    {% if new_critical_message is not null %}
      <div class="alert alert-danger">
        <i class="ti ti-alert-triangle me-1"></i>
        {{ new_critical_message }}
      </div>
    {% endif %}

    {% if findings is empty %}
      <div class="alert alert-success">
        <i class="ti ti-circle-check me-1"></i>
        {{ __('Aucun problème détecté par cet audit.', 'configurationglpiauto') }}
      </div>
    {% else %}
      {% for finding in findings %}
        {% set severityClass = {
          'critical': 'alert-danger',
          'warning': 'alert-warning',
          'info': 'alert-info'
        }[finding.severity]|default('alert-info') %}
        {# Badge commun (charte, section 8) : même couleur et même icône dans tous les plugins. #}
        {% set severityBadge = {
          'critical': ['danger', __('Critique', 'configurationglpiauto')],
          'warning': ['warning', __('À surveiller', 'configurationglpiauto')],
          'info': ['info', __('Information', 'configurationglpiauto')]
        }[finding.severity]|default(['info', __('Information', 'configurationglpiauto')]) %}
        <div class="alert {{ severityClass }} d-flex justify-content-between align-items-start gap-3">
          <div>
            <div class="text-muted small">
              {% include '@configurationglpiauto/_badge.html.twig' with {kind: severityBadge[0], label: severityBadge[1]} %}
              {{ finding.domain }}
            </div>
            <strong>{{ finding.title }}</strong>
            <p class="mb-1">{{ finding.description }}</p>
            <p class="mb-0 small">{{ finding.recommendation }}</p>
            {% if finding.links is not empty %}
              <ul class="mb-0 mt-1 small">
                {% for label, url in finding.links %}<li><a href="{{ url }}">{{ label }}</a></li>{% endfor %}
              </ul>
            {% endif %}
          </div>
          {% if finding.fixable and can_fix %}
            <form method="post" action="{{ config('root_doc') }}/plugins/configurationglpiauto/front/audit.php" class="flex-shrink-0">
              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
              <input type="hidden" name="fix" value="{{ finding.checkKey }}">
              <button type="submit" class="btn btn-sm btn-primary">
                {% if finding.fixLabel %}<i class="ti ti-ticket me-1"></i>{{ finding.fixLabel }}{% else %}<i class="ti ti-tool me-1"></i>{{ __('Corriger', 'configurationglpiauto') }}{% endif %}
              </button>
            </form>
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% if drift is defined %}{% include '@configurationglpiauto/audit/_blueprint_drift.html.twig' %}{% endif %}
{% if sessions is defined %}{% include '@configurationglpiauto/audit/_session_security.html.twig' %}{% endif %}

{# Issue #306 : délais des contrôles du parc #}
{% set park = park|default({'ghost_days': 30, 'warranty_days': 30}) %}
<div class="card mt-3">
  <div class="card-header">
    <h3 class="card-title"><i class="ti ti-devices-search me-2"></i>{{ __('Contrôles du parc', 'configurationglpiauto') }}</h3>
  </div>
  <div class="card-body">
    <p class="text-muted">{{ __('Ces contrôles ne modifient jamais le matériel : « Créer les tickets » ouvre des tickets liés au matériel concerné, que l\'équipe traite. Mettre 0 désactive un contrôle.', 'configurationglpiauto') }}</p>
    <form method="post" action="{{ config('root_doc') }}/plugins/configurationglpiauto/front/audit.php" class="row g-3 align-items-end">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="col-md-5">
        <label class="form-label" for="cga-ghost-days"><i class="ti ti-ghost me-1"></i>{{ __('Matériel qui ne remonte plus à l\'inventaire depuis (jours)', 'configurationglpiauto') }}</label>
        <input type="number" min="0" max="3650" class="form-control" name="audit_ghost_days" id="cga-ghost-days" value="{{ park.ghost_days }}" {{ can_fix ? '' : 'disabled' }}>
      </div>
      <div class="col-md-5">
        <label class="form-label" for="cga-warranty-days"><i class="ti ti-shield-check me-1"></i>{{ __('Garanties qui expirent dans (jours)', 'configurationglpiauto') }}</label>
        <input type="number" min="0" max="3650" class="form-control" name="audit_warranty_days" id="cga-warranty-days" value="{{ park.warranty_days }}" {{ can_fix ? '' : 'disabled' }}>
      </div>
      {% if can_fix %}
        <div class="col-md-2">
          <button type="submit" name="save_park" value="1" class="btn btn-primary w-100"><i class="ti ti-device-floppy me-1"></i>{{ __('Enregistrer', 'configurationglpiauto') }}</button>
        </div>
      {% endif %}
    </form>
  </div>
</div>

{# Issue #467 : fin de support des systèmes et du matériel (endoflife.date), facultative #}
{% set eol = eol|default({'enabled': false, 'offline': false, 'days': 180, 'mapping': '', 'cache': []}) %}
<div class="card mt-3" id="cga-eol">
  <div class="card-header">
    <h3 class="card-title"><i class="ti ti-calendar-off me-2"></i>{{ __('Fin de support des systèmes et du matériel', 'configurationglpiauto') }}</h3>
    <div class="card-actions">
      {% if eol.enabled %}
        <span class="badge bg-green-subtle text-green-emphasis"><i class="ti ti-check me-1"></i>{{ __('Activé', 'configurationglpiauto') }}</span>
        {% if eol.offline %}<span class="badge bg-secondary-subtle text-secondary-emphasis ms-1"><i class="ti ti-wifi-off me-1"></i>{{ __('Hors ligne', 'configurationglpiauto') }}</span>{% endif %}
      {% else %}
        <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="ti ti-player-pause me-1"></i>{{ __('Désactivé', 'configurationglpiauto') }}</span>
      {% endif %}
    </div>
  </div>
  <div class="card-body">
    <div class="alert alert-info">
      <strong><i class="ti ti-help-circle me-1"></i>{{ __('À quoi sert ce contrôle ?', 'configurationglpiauto') }}</strong>
      <p class="mb-0">{{ __('Il signale les systèmes d\'exploitation et les modèles de matériel en service dont le support du fabricant est terminé ou se termine bientôt, d\'après les dates publiques du site endoflife.date. Rien n\'est téléchargé tant qu\'il n\'est pas activé, seul endoflife.date est contacté, et seulement quand vous cliquez sur « Télécharger les dates ». Le contrôle lit ensuite ces dates gardées en base : il ne modifie jamais le matériel.', 'configurationglpiauto') }}</p>
    </div>
    <form method="post" action="{{ config('root_doc') }}/plugins/configurationglpiauto/front/audit.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="row g-3">
        <div class="col-md-6">
          <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" name="audit_eol_enabled" value="1" id="cga-eol-enabled" {{ eol.enabled ? 'checked' : '' }} {{ can_fix ? '' : 'disabled' }}>
            <label class="form-check-label" for="cga-eol-enabled">{{ __('Activer le contrôle de fin de support', 'configurationglpiauto') }}</label>
          </div>
          <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" name="audit_eol_offline" value="1" id="cga-eol-offline" {{ eol.offline ? 'checked' : '' }} {{ can_fix ? '' : 'disabled' }}>
            <label class="form-check-label" for="cga-eol-offline">{{ __('Mode hors ligne : ne jamais contacter endoflife.date, importer les fichiers à la main', 'configurationglpiauto') }}</label>
          </div>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="cga-eol-days"><i class="ti ti-hourglass me-1"></i>{{ __('Signaler une fin de support dans les (jours)', 'configurationglpiauto') }}</label>
          <input type="number" min="0" max="3650" class="form-control" name="audit_eol_days" id="cga-eol-days" value="{{ eol.days }}" {{ can_fix ? '' : 'disabled' }}>
        </div>
        <div class="col-12">
          <label class="form-label" for="cga-eol-mapping"><i class="ti ti-arrows-exchange me-1"></i>{{ __('Correspondances : une ligne par nom de système ou de modèle, tel qu\'il apparaît dans GLPI', 'configurationglpiauto') }}</label>
          <textarea class="form-control font-monospace" rows="6" name="audit_eol_mapping" id="cga-eol-mapping" placeholder="Microsoft Windows 11 Professionnel = windows&#10;Debian GNU/Linux = debian&#10;iPhone 12 = iphone 12" {{ can_fix ? '' : 'disabled' }}>{{ eol.mapping }}</textarea>
          <div class="form-text">{{ __('Forme : « Nom dans GLPI = produit », ou « Nom dans GLPI = produit cycle » pour imposer le cycle. Le produit est l\'identifiant de la page endoflife.date (par exemple windows pour endoflife.date/windows). Les noms sans correspondance ne sont pas contrôlés.', 'configurationglpiauto') }}</div>
        </div>
      </div>
      {% if can_fix %}
        <div class="mt-3 d-flex flex-wrap gap-2">
          <button type="submit" name="save_eol" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Enregistrer', 'configurationglpiauto') }}</button>
          <button type="submit" name="suggest_eol" value="1" class="btn btn-outline-secondary" formnovalidate><i class="ti ti-bulb me-1"></i>{{ __('Proposer les correspondances', 'configurationglpiauto') }}</button>
          {% if eol.enabled and not eol.offline %}
            <button type="submit" name="refresh_eol" value="1" class="btn btn-outline-primary" formnovalidate><i class="ti ti-cloud-download me-1"></i>{{ __('Télécharger les dates', 'configurationglpiauto') }}</button>
          {% endif %}
        </div>
      {% endif %}
    </form>

    <h4 class="mt-4"><i class="ti ti-database me-1"></i>{{ __('Dates gardées en base', 'configurationglpiauto') }}</h4>
    {% if eol.cache is empty %}
      <p class="text-muted">{{ __('Aucune date pour l\'instant.', 'configurationglpiauto') }}</p>
    {% else %}
      <div class="table-responsive">
        <table class="table table-sm table-striped">
          <thead><tr><th>{{ __('Produit', 'configurationglpiauto') }}</th><th>{{ __('Cycles', 'configurationglpiauto') }}</th><th>{{ __('Mis à jour le', 'configurationglpiauto') }}</th></tr></thead>
          <tbody>
            {% for entry in eol.cache %}
              <tr>
                <td><a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">{{ entry.product }} <i class="ti ti-external-link"></i></a></td>
                <td><span class="badge bg-blue-subtle text-blue-emphasis">{{ entry.cycles }}</span></td>
                <td>{{ entry.date }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}

    {% if can_fix and eol.enabled %}
      <form method="post" enctype="multipart/form-data" action="{{ config('root_doc') }}/plugins/configurationglpiauto/front/audit.php" class="row g-2 align-items-end mt-2">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <div class="col-12 small text-muted"><i class="ti ti-wifi-off me-1"></i>{{ __('Sans accès à Internet : sur un autre poste, enregistrez https://endoflife.date/api/v1/products/windows/ dans un fichier (windows étant le produit voulu), puis importez-le ici.', 'configurationglpiauto') }}</div>
        <div class="col-md-3">
          <label class="form-label" for="cga-eol-product">{{ __('Produit', 'configurationglpiauto') }}</label>
          <input type="text" class="form-control" name="eol_product" id="cga-eol-product" maxlength="64" placeholder="windows" required>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="cga-eol-file">{{ __('Fichier JSON endoflife.date', 'configurationglpiauto') }}</label>
          <input type="file" class="form-control" name="eol_file" id="cga-eol-file" accept=".json,application/json" required>
        </div>
        <div class="col-md-3">
          <button type="submit" name="import_eol" value="1" class="btn btn-outline-secondary w-100"><i class="ti ti-file-import me-1"></i>{{ __('Importer', 'configurationglpiauto') }}</button>
        </div>
      </form>
    {% endif %}
  </div>
</div>

{# Issue #285 : rapport d'audit périodique par e-mail. Fréquence = tâche planifiée GLPI
   « auditreport » ; modèle et destinataires = notification GLPI native (lien ci-dessous). #}
<div class="card mt-3">
  <div class="card-header">
    <h3 class="card-title"><i class="ti ti-mail-forward me-2"></i>{{ __('Rapport périodique par e-mail', 'configurationglpiauto') }}</h3>
  </div>
  <div class="card-body">
    <p class="text-muted">{{ __('Reçoit automatiquement la synthèse de cet audit : nombre de contrôles OK, en alerte et en échec, points à traiter avec leur recommandation et évolution depuis le rapport précédent. Aucun mot de passe ni secret n\'est envoyé, seulement les constats.', 'configurationglpiauto') }}</p>
    {% if not report.notifications_on %}
      <div class="alert alert-warning"><i class="ti ti-alert-triangle me-1"></i>{{ __('Les notifications par e-mail de GLPI sont désactivées : activez-les dans Configuration > Notifications.', 'configurationglpiauto') }}</div>
    {% endif %}
    <form method="post" action="{{ config('root_doc') }}/plugins/configurationglpiauto/front/audit.php">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label" for="cga-report-frequency">{{ __('Fréquence', 'configurationglpiauto') }}</label>
          <select class="form-select" name="audit_report_frequency" id="cga-report-frequency" {{ can_fix ? '' : 'disabled' }}>
            <option value="off" {{ report.frequency == 'off' ? 'selected' : '' }}>{{ __('Désactivé', 'configurationglpiauto') }}</option>
            <option value="week" {{ report.frequency == 'week' ? 'selected' : '' }}>{{ __('Hebdomadaire', 'configurationglpiauto') }}</option>
            <option value="month" {{ report.frequency == 'month' ? 'selected' : '' }}>{{ __('Mensuel', 'configurationglpiauto') }}</option>
          </select>
          <div class="form-check form-switch mt-3">
            <input type="checkbox" class="form-check-input" name="audit_report_only_on_change" value="1" id="cga-report-only-on-change" {{ report.only_on_change ? 'checked' : '' }} {{ can_fix ? '' : 'disabled' }}>
            <label class="form-check-label" for="cga-report-only-on-change">{{ __('N\'envoyer que s\'il y a un changement ou une anomalie', 'configurationglpiauto') }}</label>
          </div>
        </div>
        <div class="col-md-8">
          <label class="form-label" for="cga-report-emails">{{ __('Adresses supplémentaires (facultatif)', 'configurationglpiauto') }}</label>
          <textarea class="form-control" name="audit_report_emails" id="cga-report-emails" rows="3" placeholder="rssi@exemple.fr" {{ can_fix ? '' : 'disabled' }}>{{ report.emails }}</textarea>
          <small class="form-hint">{{ __('Une adresse par ligne, pour des destinataires sans compte GLPI. Par défaut, le rapport part à l\'administrateur GLPI ; profils et groupes se choisissent dans les destinataires de la notification.', 'configurationglpiauto') }}</small>
        </div>
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
        {% if can_fix %}
          <button type="submit" name="save_report" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Enregistrer', 'configurationglpiauto') }}</button>
          <button type="submit" name="send_report_now" value="1" class="btn btn-outline-secondary"><i class="ti ti-send me-1"></i>{{ __('Enregistrer et envoyer maintenant', 'configurationglpiauto') }}</button>
        {% endif %}
        {% if report.notification_url %}
          <a href="{{ report.notification_url }}" class="btn btn-link"><i class="ti ti-bell-cog me-1"></i>{{ __('Modifier le modèle et les destinataires', 'configurationglpiauto') }}</a>
        {% endif %}
        <span class="text-muted small ms-auto">
          {% if report.last_sent %}
            {{ __('Dernier rapport envoyé le %s', 'configurationglpiauto')|format(report.last_sent) }}
          {% else %}
            {{ __('Aucun rapport envoyé pour l\'instant.', 'configurationglpiauto') }}
          {% endif %}
        </span>
      </div>
    </form>
  </div>
</div>
