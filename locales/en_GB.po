msgstr "%d phone operators created."

msgid "Créer les opérateurs téléphoniques français courants"
msgstr "Create common French phone operators"

msgid "%d types de matériel créés."
msgstr "%d asset types created."

msgid "Créer les types courants de matériel (ordinateurs, écrans, réseau, racks, câbles, disques durs...)"
msgstr "Create common hardware types (computers, monitors, network, racks, cables, hard drives...)"

msgid "%d jour(s) férié(s) étranger(s) créés."
msgstr "%d foreign public holiday(s) created."

