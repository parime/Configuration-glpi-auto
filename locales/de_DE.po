msgstr "Eskalation N3 — %s"

msgid "Escalade automatique N1 → N2"
msgstr "Automatische Eskalation N1 → N2"

msgid "Escalade automatique N1 → N2 (au seuil ci-dessus)"
msgstr "Automatische Eskalation N1 → N2 (beim obigen Schwellenwert)"

msgid "Escalade automatique N2 → N3"
msgstr "Automatische Eskalation N2 → N3"

msgid "Escalade automatique N2 → N3 (à l'échéance du SLA)"
msgstr "Automatische Eskalation N2 → N3 (bei Ablauf des SLA)"

msgid "Escalade automatique avant échéance"
msgstr "Automatische Eskalation vor Fristablauf"

msgid "Escalade — %s"
msgstr "Eskalation — %s"

