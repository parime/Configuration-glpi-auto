msgstr "Entität hinzufügen"

msgid "Ajouter une sous-entité"
msgstr "Unterentität hinzufügen"

msgid "Ajouter une étape de validation « Comité (2/3) » pour les décisions collégiales"
msgstr "Freigabeschritt „Ausschuss (2/3)\" für gemeinsame Entscheidungen hinzufügen"

msgid "Aperçu"
msgstr "Vorschau"

