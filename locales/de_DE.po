msgstr "+ OLA (interne Verpflichtungen)"

msgid "...ou choisir une des palettes GLPI existantes comme choix par défaut"
msgstr "...oder eine der vorhandenen GLPI-Paletten als Standard wählen"

msgid "Activer l'enquête de satisfaction native (1 à 5 étoiles, sur chaque ticket clos)"
msgstr "Native Zufriedenheitsumfrage aktivieren (1 bis 5 Sterne, bei jedem geschlossenen Ticket)"

msgid "Activer l'escalade entre niveaux de support (N1 → N2 → N3)"
msgstr "Eskalation zwischen Support-Ebenen aktivieren (N1 → N2 → N3)"

msgid "Activer l'escalade pour cette entité"
msgstr "Eskalation für diese Entität aktivieren"

msgid "Activer les informations financières et administratives par défaut"
msgstr "Finanzielle und administrative Informationen standardmäßig aktivieren"

msgid "Activer les notifications (par e-mail et dans le navigateur)"
msgstr "Benachrichtigungen aktivieren (per E-Mail und im Browser)"

msgid "Activer les notifications de mise à jour, pièce jointe et relance automatique de ticket"
msgstr "Benachrichtigungen für Ticket-Update, Anhang und automatische Erinnerung aktivieren"

msgid "Activer les tâches automatiques d'alerte cartouches, consommables et expiration de licences (désactivées par défaut, alors que les notifications correspondantes le sont déjà)"
msgstr "Automatische Warnaufgaben für Patronen, Verbrauchsmaterial und Lizenzablauf aktivieren (standardmäßig deaktiviert, obwohl die zugehörigen Benachrichtigungen es bereits nicht sind)"

msgid "Afficher la pagination au-dessus des résultats"
msgstr "Seitennummerierung über den Ergebnissen anzeigen"

msgid "Afficher le moteur de recherche au-dessus des résultats"
msgstr "Suchmaschine über den Ergebnissen anzeigen"

msgid "Agencement des boutons d'action divisé (Répondre / Observation / Solution séparés)"
msgstr "Geteiltes Aktionsschaltflächen-Layout (Antworten / Beobachtung / Lösung getrennt)"

msgid "Ajouter des engagements internes (OLA)"
msgstr "Interne Verpflichtungen (OLA) hinzufügen"

msgid "Ajouter des icônes"
msgstr "Symbole hinzufügen"

msgid "Ajouter des icônes (par catégorie de fabricant)"
msgstr "Symbole hinzufügen (nach Herstellerkategorie)"

msgid "Ajouter des icônes (repérage rapide dans les listes d'affectation)"
msgstr "Symbole hinzufügen (schnelles Erkennen in Zuweisungslisten)"

msgid "Ajouter des icônes (visibles dans la liste, le nom lui-même reste sans icône)"
msgstr "Symbole hinzufügen (in der Liste sichtbar, der Name selbst bleibt ohne Symbol)"

msgid "Ajouter des icônes sur les gabarits de solution"
msgstr "Symbole zu Lösungsvorlagen hinzufügen"

msgid "Ajouter des icônes sur les modèles"
msgstr "Symbole zu Vorlagen hinzufügen"

msgid "Ajouter des icônes sur les types de solution"
msgstr "Symbole zu Lösungstypen hinzufügen"

msgid "Ajouter les jours fériés français (8 jours fixes)"
msgstr "Französische Feiertage hinzufügen (8 feste Tage)"

msgid "Ajouter un client"
msgstr "Kunde hinzufügen"

msgid "Ajouter un logo par entité"
msgstr "Logo pro Entität hinzufügen"

