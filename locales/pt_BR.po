msgid "Collecteur introuvable."
msgstr "Coletor de e-mails não encontrado."

msgid ""
"Aucun mot de passe enregistré pour ce collecteur : saisissez-le dans "
"l'assistant ou dans l'écran du collecteur."
msgstr ""
"Nenhuma senha salva para este coletor de e-mails: informe-a no assistente ou "
"na ficha do coletor."

#, php-format
msgid "Connexion réussie : %d message(s) dans le dossier relevé."
msgstr "Conexão bem-sucedida: %d mensagem(ns) na pasta coletada."

#, php-format
