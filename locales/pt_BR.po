msgstr "Arquivo JSON do endoflife.date"

msgid "Importer"
msgstr "Importar"

msgid "Réglages de fin de support enregistrés."
msgstr "Configurações de fim de suporte salvas."

msgid ""
"Correspondances proposées ajoutées : vérifiez-les avant de télécharger les "
"dates."
msgstr ""
"Correspondências propostas adicionadas: verifique-as antes de baixar as "
"datas."

msgid "Activez d'abord le contrôle de fin de support."
msgstr "Ative primeiro o controle de fim de suporte."

msgid ""
"Mode hors ligne : aucun téléchargement. Importez un fichier endoflife.date à "
"la place."
msgstr ""
"Modo offline: nenhum download. Importe um arquivo do endoflife.date no lugar."

msgid "Aucune correspondance : rien à télécharger."
msgstr "Nenhuma correspondência: nada a baixar."

#, php-format
msgid "Dates téléchargées pour %d produit(s)."
msgstr "Datas baixadas para %d produto(s)."

#, php-format
msgid ""
"Téléchargement impossible pour : %s (produit inconnu d'endoflife.date ou "
"site injoignable). Les dates déjà en cache sont gardées."
msgstr ""
"Download impossível para: %s (produto desconhecido do endoflife.date ou site "
"inacessível). As datas já em cache são mantidas."

