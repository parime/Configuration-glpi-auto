[main]
host = https://www.transifex.com

[parime/configuration-glpi-auto]
source_file = locales/configurationglpiauto.pot
source_lang = en
file_filter = php:src/**/*.php,setup.php,hook.php;json:composer.json;md:README.md,CHANGELOG.md,docs/**/*.md
